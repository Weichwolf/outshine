# STRICT, AND IN STAGES. Every check below is one whose finding is a DEFECT or an unarguable
# improvement. What is switched off is switched off with a reason, because a disabled check with no
# reason beside it is a check somebody will re-enable next year and disable again.
#
# The counts in the reasons are unique findings over two representative units --
# `src/render/Shape.cpp` and `src/engine/Live.cpp` -- measured before choosing.
HeaderFilterRegex: '.*\.h$'
ExcludeHeaderFilterRegex: '.*/(homebrew|usr|Library|Applications|Xcode\.app)/.*'
FormatStyle: file
Checks: >
  bugprone-*,
  concurrency-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  modernize-*,

  -bugprone-easily-swappable-parameters,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,

  -readability-uppercase-literal-suffix,
  -readability-math-missing-parentheses,
  -readability-trailing-comma,
  -performance-enum-size,

  -modernize-avoid-c-style-cast,
  -modernize-avoid-c-arrays,
  -readability-magic-numbers
WarningsAsErrors: ''

# WHY THE LAST TWO GROUPS ARE OFF
#
# `readability-uppercase-literal-suffix` (194) wants `1.0F` where the tree and most of the world
#   write `1.0f`. It is LLVM's house preference and buys no reader anything.
# `readability-math-missing-parentheses` (107) parenthesises `a * b + c`. Precedence is not a
#   defect and the parentheses hide the shape of an expression rather than showing it.
# `readability-trailing-comma` (82) is layout, and layout is `.clang-format`'s job.
# `performance-enum-size` (32) would size an enum by its largest value. Several of these enums are
#   DEVICE records whose width is a decision with a measurement behind it.
#
# `modernize-avoid-c-style-cast` (91 in two units, so thousands in the tree) is RIGHT and is
#   stage two: `static_cast` says which conversion is meant where `(float)` says only that one
#   happens. It is a mechanical sweep and it must not hide inside another change.
# `modernize-avoid-c-arrays` (281) is stage two for the same reason and needs a judgement first:
#   `float SelfCenter[3]` in a record the GPU reads is layout, and `std::array` is
#   layout-compatible -- but that has to be stated per record rather than swept.
# `readability-magic-numbers` is CLAUDE.md's own rule ("every number carries its origin") and is
#   stage three, because it cannot be answered by a tool: the fix is a named constant with a
#   derivation, and a tool can only say where one is missing.
