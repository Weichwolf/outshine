# STRICT, AND IN STAGES. Every check below is one whose finding is a DEFECT or an unarguable
# improvement. What is switched off is switched off with a reason, because a disabled check with no
# reason beside it is a check somebody will re-enable next year and disable again.
#
# The counts in the reasons are unique findings over two representative units --
# `src/render/Shape.cpp` and `src/engine/Live.cpp` -- measured before choosing.
HeaderFilterRegex: '.*\.h$'
ExcludeHeaderFilterRegex: '.*/(homebrew|usr|Library|Applications|Xcode\.app)/.*'
FormatStyle: file
Checks: >
  bugprone-*,
  concurrency-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  modernize-*,

  -modernize-use-trailing-return-type,
  -readability-uppercase-literal-suffix,
  -readability-math-missing-parentheses,
  -readability-trailing-comma,
  -performance-enum-size
WarningsAsErrors: ''

CheckOptions:
  # `misc-include-cleaner` IS RIGHT ABOUT THE STANDARD LIBRARY AND WRONG ABOUT EVERYTHING ELSE HERE,
  # measured: it found `<ratio>` and `<system_error>` genuinely missing, and in the same file it
  # claimed `Sha256.h` was unused while `Sha256Hex` is called on the next screen. It also asks for
  # `SDL3/SDL_init.h` where SDL documents `SDL3/SDL.h` as the entry point. A finding that has to be
  # ignored teaches a reader to ignore findings, so the check keeps the half it is right about.
  misc-include-cleaner.IgnoreHeaders: 'SDL3/.*;.*/src/.*;include/.*'

  # `readability-identifier-length` was SWITCHED OFF where it should have been SET. Its default
  # asks for three characters, which is wrong in a maths kernel -- `e` and `n` are the clearest
  # names an east and a north will ever have. At one character it still refuses the genuinely
  # nameless and stops arguing about vector algebra.
  # `bugprone-signed-bitwise` fires on SDL's OWN macros -- SDL_GPU_BUFFERUSAGE_VERTEX is (1u << 0)
  # and the shift amount is a signed literal. That is not the hazard the check exists for, which is
  # a signed VARIABLE in a bitwise expression, where the sign bit is a trap. The check keeps that
  # half; a positive integer literal is well defined and is ignored.
  bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: 'true'

  readability-identifier-length.MinimumVariableNameLength: 1
  readability-identifier-length.MinimumParameterNameLength: 1
  readability-identifier-length.MinimumLoopCounterNameLength: 1

# WHY THESE FIVE ARE OFF, AND WHY NOTHING ELSE IS
#
# A check is off for exactly one reason: its finding is a MATTER OF TASTE rather than a defect.
# Everything whose finding is a defect is ON and its count is driven to zero -- switching such a
# check off is choosing not to use the machine this tree built for exactly that.
#
# `modernize-use-trailing-return-type` (897) wants `auto f() -> int`. The tree writes `int f()` and
#   so does most of the world.
#
# `readability-uppercase-literal-suffix` (194) wants `1.0F` where the tree and most of the world
#   write `1.0f`. It is LLVM's house preference and buys no reader anything.
# `readability-math-missing-parentheses` (107) parenthesises `a * b + c`. Precedence is not a
#   defect and the parentheses hide the shape of an expression rather than showing it.
# `readability-trailing-comma` (82) is layout, and layout is `.clang-format`'s job.
# `performance-enum-size` (32) would size an enum by its largest value. Several of these enums are
#   DEVICE records whose width is a decision with a measurement behind it.
#
# WHAT WAS TURNED BACK ON, AND WHAT IT COSTS
#
# `readability-function-cognitive-complexity` was off with NO reason beside it, and it is the only
#   guard in this gate that measures SHAPE rather than correctness. It reports
#   `Grounds` at 730 against a threshold of 25.
# `misc-non-private-member-variables-in-classes` (311 in two units) enforces CLAUDE.md's own
#   sentence: a public data member is an invariant nobody can hold.
# `modernize-avoid-c-style-cast` (91) and `modernize-avoid-c-arrays` (281) were called RIGHT here
#   and switched off anyway, as "stage two". A stage with no date is a promise; the count is the
#   schedule.
# `readability-magic-numbers` is CLAUDE.md's rule that every number carries its origin.
# `bugprone-easily-swappable-parameters` (40) is a real hazard class and 40 is not a flood.
# `misc-no-recursion` found ZERO. It switched nothing off and the line is gone.
