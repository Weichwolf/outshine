# JSBSim link/load/tick probe (Migrationspaket D, Stufe D1). Build context = sim/.
# Stage 1 baut libJSBSim statisch aus Quelle (gecacht, solange die Version steht),
# Stage 2 linkt jsb_probe dagegen und kopiert die Aircraft-Plugins.

FROM docker.io/library/debian:trixie-slim AS jsbsim
RUN apt-get update && apt-get install -y --no-install-recommends \
        g++ cmake make git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
# TODO(D): auf ein Release-Tag pinnen; master = dieselbe Quelle wie unsere Modelle.
RUN git clone --depth 1 https://github.com/JSBSim-Team/jsbsim.git
WORKDIR /build/jsbsim/build
RUN cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DBUILD_PYTHON_MODULE=OFF .. \
    && make -j"$(nproc)" \
    && make install

FROM docker.io/library/debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends g++ libc6-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=jsbsim /usr/local/include/JSBSim /usr/local/include/JSBSim
COPY --from=jsbsim /usr/local/lib/ /usr/local/lib/
WORKDIR /app
COPY aircraft/fdm/jsb_probe.cpp aircraft/fdm/jsbsim_adapter.h \
     aircraft/fdm/jsbsim_adapter.cpp aircraft/fdm/jsb_adapter_test.cpp ./
COPY aircraft/models/ models/
RUN g++ -O2 -std=c++17 -I/usr/local/include/JSBSim jsb_probe.cpp \
        -o /usr/local/bin/jsb_probe /usr/local/lib/libJSBSim.a \
 && g++ -O2 -std=c++17 -I/usr/local/include/JSBSim -I. \
        jsb_adapter_test.cpp jsbsim_adapter.cpp \
        -o /usr/local/bin/jsb_adapter_test /usr/local/lib/libJSBSim.a
CMD ["/usr/local/bin/jsb_adapter_test", "minisgs_e"]
