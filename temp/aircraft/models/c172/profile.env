# c172 — Cessna 172 at Froude scale n=0.20 (span 2.18 m, 5.4 kg). Cruise ~20 m/s (probe: level at
# thr 0.40). Electric-prop model. iNav flies natively; these drive chanmap + JSBSim spawn.
CHANMAP=M01-01,S01-02,S02-03,S03-04
FBW=0
SPAWN_SPEED=18
FB_CRUISE=20
FB_STALL=11
FB_BANK=30
FB_VR=0
FB_HANDOFF=60
LOITER_ALT=120
LOITER_RADIUS=140
