# sgs233 — Schweizer SGS 2-33 motor-glider at Froude n=0.20 (span 3.1 m, 2.2 kg) + emitted 350 W
# self-launch motor. Probe: level & controlled at thr 0.30 -> 22 m/s, roll <1 deg. Replaces sgs126
# (higher wing loading -> less floaty in NAV). Vanilla aero.
CHANMAP=M01-01,S01-02,S02-03,S03-04
FBW=0
SPAWN_SPEED=18
FB_CRUISE=22
FB_STALL=11
FB_BANK=22
FB_VR=0
FB_HANDOFF=60
LOITER_ALT=110
LOITER_RADIUS=130
SPAWN_ALT=2
