    "kind": "numeric",
    "says": "This model tests the KHR_meshopt_compression extension.",
    "statedAt": "https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/2bac6f8c57bf471df0d2a1e8a8ec023c7801dddf/Models/MeshoptCubeTest/README.md"
