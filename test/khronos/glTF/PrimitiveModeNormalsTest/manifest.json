  "scene": {
    "frame": "gltf",
    "camera": {
      "source": "manifest",
      "positionM": [
        67.60771477749083,
        30.039839315941034,
        47.33943152833106
      ],
      "lookAtM": [
        0.0,
        0.0,
        0.0
      ],
      "rollRad": 0.0,
      "yfovRad": 0.47108996144172666,
      "sensorHeightMm": 24.0,
      "clipStartM": 75.53224049589166,
      "clipEndM": 100.12898824838935,
      "derivation": "The framing rule of src/gltf/Framing.h, quoted so the runner can refuse a mismatch rather than trust it. World bounds [-10.0, -7.0, -1.5] to [10.0, 7.0, 1.5], so centre = [0.0, 0.0, 0.0] and radius = 12.298373876248844 m. yfov = 2*atan(12/50) from a 50 mm lens on a 24 mm sensor height at sensor_fit VERTICAL. distance = radius / sin(yfov/2) / 0.6 = 87.8306143721405, and the eye is centre + (cos20*cos35, sin20, cos20*sin35) * distance. clipStart is distance - radius and clipEnd is distance + radius.",
      "note": "The glTF carries no camera, so the framing rule supplies one. Roll is 0 because the rule sets it: a roll chosen here and nowhere else would make this subject's placement a second determination competing with the rule."
    },
    "light": {
      "kind": "none",
      "note": "The material emits, so nothing has to arrive for the picture to exist."
    },
    "world": {
      "kind": "uniform",
      "colourLinear": [
        1.0,
        1.0,
        1.0
      ],
      "strength": 0.0,
      "note": "Declared and zero rather than left factory, so the picture is a function of this manifest and not of a Blender default."
    },
    "material": {
      "source": "manifest",
      "kind": "emission-by-material-index",
      "note": "Emission, one colour per glTF material, from a RULE with no free parameter rather than from a table: colour[c] = 0.15 + 0.70 * frac(index * step[c]). A table names materials and is right while a subject draws a handful; past that it is a transcription of the file. The rule takes no parameter, so a manifest cannot tune a colour to make a case pass (board:1362)."
    }
  },
  "renders": {
    "default": {
      "engine": "CYCLES",
      "device": "METAL",
      "resolutionX": 1280,
      "resolutionY": 720,
      "samples": 1,
      "adaptiveSampling": false,
      "denoise": false,
      "seed": 0,
      "pixelFilter": {
        "type": "BOX",
        "widthPx": 0.01
      },
