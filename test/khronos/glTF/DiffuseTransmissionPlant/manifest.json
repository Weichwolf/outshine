  "scene": {
    "frame": "gltf",
    "camera": {
      "source": "manifest",
      "positionM": [
        3.464616536963827,
        1.980535405735582,
        2.366597935832132
      ],
      "lookAtM": [
        -0.04608152247965336,
        0.42064233821276037,
        -0.09161930976839258
      ],
      "rollRad": 0.0,
      "yfovRad": 0.47108996144172666,
      "sensorHeightMm": 24.0,
      "clipStartM": 3.922198687044375,
      "clipEndM": 5.199445742169868,
      "derivation": "The framing rule of src/gltf/Framing.h, quoted so the runner can refuse a mismatch rather than trust it. World bounds [-0.3966600392013788, 5.295426485208095e-05, -0.4203126070535665] to [0.3044969942420721, 0.8412317221606687, 0.23707398751678133], so centre = [-0.04608152247965336, 0.42064233821276037, -0.09161930976839258] and radius = 0.6386235275627463 m. yfov = 2*atan(12/50) from a 50 mm lens on a 24 mm sensor height at sensor_fit VERTICAL. distance = radius / sin(yfov/2) / 0.6 = 4.560822214607121, and the eye is centre + (cos20*cos35, sin20, cos20*sin35) * distance. clipStart is distance - radius and clipEnd is distance + radius.",
      "note": "The glTF carries no camera, so the framing rule supplies one. Roll is 0 because the rule sets it: a roll chosen here and nowhere else would make this subject's placement a second determination competing with the rule."
    },
    "light": {
      "kind": "none",
      "note": "The material emits, so nothing has to arrive for the picture to exist."
    },
    "world": {
      "kind": "uniform",
      "colourLinear": [
        1.0,
        1.0,
        1.0
      ],
      "strength": 0.0,
      "note": "Declared and zero rather than left factory, so the picture is a function of this manifest."
    },
    "material": {
      "source": "manifest",
      "kind": "emission-per-material",
      "colourLinearPerMaterial": {
        "base": [
          0.85,
          0.15,
          0.15
        ],
        "leaves": [
          0.15,
          0.3542572472504414,
          0.85
        ],
        "wings": [
          0.5585144945008829,
          0.85,
          0.15
        ]
      },
      "note": "Emission, one colour per glTF material, keyed by the name the FILE gives it. A material a primitive does not name is keyed by `<default>`, which is the format's own word for the material an undefined `material` selects."
    },
    "animation": {
      "animations": [
        0
      ],
      "fps": {
        "value": 1,
        "unit": "frames per second",
        "origin": "SET",
        "note": "ONE FRAME PER SECOND, AND THE RATE IS AN INTEGER BECAUSE THE HARNESS REQUIRES ONE: a frame is `index / fps` seconds and Blender's own rate is whole. A rate below one -- which is what sampling a 60 s span in five steps would need -- has no spelling, so the grid is a second apart and the note below says what it therefore covers."
      },
      "frames": {
        "value": 5,
        "unit": "frames",
        "origin": "derived",
        "derivation": "min(5, ceil(16.666666 s) + 1) = 5, so the grid runs 0..4 s.",
        "note": "WHAT THIS GRID COVERS, STATED RATHER THAN IMPLIED. The file's declared span is 16.666666 s and this case samples its first 4 s. Where the span is shorter than that, glTF clamps past the last keyframe and the tail frames state the end pose rather than an extrapolation. Where it is LONGER -- and it is for the long ones -- this case exercises the OPENING of the motion and says so: it decides that the animation is read, applied and posed, not that the whole of it is right. A case that needed the whole span would declare a grid for it and pay for the frames."
      }
    }
  },
