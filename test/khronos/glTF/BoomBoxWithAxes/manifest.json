  "id": "render/coverage/boom-box-with-axes",
  "title": "A boom box, with the coordinate axes beside it -- a modelled body, and this case decides its geometry and its material binding",
  "covers": [
    "I.26",
    "I.26.10",
    "khronos:BoomBoxWithAxes",
    "board:1226"
  ],
  "criterion": {
    "kind": "numeric",
    "says": "Shows X, Y, and Z axis default orientations.",
    "statedAt": "https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/2bac6f8c57bf471df0d2a1e8a8ec023c7801dddf/Models/BoomBoxWithAxes/README.md"
  },
  "subjectClass": "opaque-min-1px",
  "acceptanceClass": {
    "is": "general-position",
    "because": "The framing rule's own direction -- azimuth 35 degrees, elevation 20 degrees -- and nothing here is analytic: the silhouette of a modelled body turns continuously, so every boundary pixel carries its own sub-pixel offset and the instrument is the whole boundary rather than any one edge."
  },
