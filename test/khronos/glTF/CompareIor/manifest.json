  "criterion": {
    "kind": "numeric",
    "says": "This model compares IOR methods.",
    "statedAt": "https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/2bac6f8c57bf471df0d2a1e8a8ec023c7801dddf/Models/CompareIor/README.md"
