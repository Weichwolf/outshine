  "criterion": {
    "kind": "numeric",
    "says": "This model tests UV transform animations with KHR_animation_pointer.",
    "statedAt": "https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/2bac6f8c57bf471df0d2a1e8a8ec023c7801dddf/Models/AnimationPointerUVs/README.md"
