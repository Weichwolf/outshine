  "scene": {
    "frame": "gltf",
    "camera": {
      "source": "manifest",
      "positionM": [
        22.708534926957842,
        13.839019377561723,
        15.93218297191925
      ],
      "lookAtM": [
        -0.327268040938264,
        3.6036221015741177,
        -0.1976599149152065
      ],
      "rollRad": 0.0,
      "yfovRad": 0.47108996144172666,
      "sensorHeightMm": 24.0,
      "clipStartM": 25.73590625734916,
      "clipEndM": 34.11669292855052,
      "derivation": "The framing rule of src/gltf/Framing.h, quoted so the runner can refuse a mismatch rather than trust it. World bounds [-1.6259906165280515, -0.0008064662422668789, -1.8949550213151323] to [0.9714545346515235, 7.208050669390502, 1.4996351914847192], so centre = [-0.327268040938264, 3.6036221015741177, -0.1976599149152065] and radius = 4.190393335600678 m. yfov = 2*atan(12/50) from a 50 mm lens on a 24 mm sensor height at sensor_fit VERTICAL. distance = radius / sin(yfov/2) / 0.6 = 29.92629959294984, and the eye is centre + (cos20*cos35, sin20, cos20*sin35) * distance. clipStart is distance - radius and clipEnd is distance + radius.",
      "note": "The glTF carries no camera, so the framing rule supplies one. Roll is 0 because the rule sets it: a roll chosen here and nowhere else would make this subject's placement a second determination competing with the rule."
    },
    "light": {
      "kind": "none",
      "note": "The material below emits, so nothing has to arrive for the picture to exist. A light here would add a lobe neither side is being asked about."
    },
    "world": {
      "kind": "uniform",
      "colourLinear": [
        1.0,
        1.0,
        1.0
      ],
      "strength": 0.0,
      "note": "Declared and zero rather than left factory, so the picture is a function of this manifest and not of a Blender default. At zero bounces an emission shader returns its emission alone, so this changes no covered pixel -- it removes the background from the DECLARATION rather than from the render."
    },
    "material": {
      "source": "manifest",
      "kind": "emission-per-material",
      "colourLinearPerMaterial": {
        "camera": [
          0.85,
          0.15,
          0.15
        ],
        "tripod": [
          0.15,
          0.3542572472504414,
          0.85
        ]
      },
      "note": "Emission, one colour per glTF material, keyed by the name the FILE gives it, on a golden-angle hue sweep so no two are close. A material row that reached the wrong body is a whole body of the wrong hue rather than a sub-pixel offset."
    }
  },
