  "criterion": {
    "kind": "numeric",
    "says": "Static model of old camera on a tripod. [Issues: non-Khronos mark]",
    "statedAt": "https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/2bac6f8c57bf471df0d2a1e8a8ec023c7801dddf/Models/AntiqueCamera/README.md"
  },
  "subjectClass": "opaque-min-1px",
  "acceptanceClass": {
    "is": "general-position",
    "because": "The framing rule's own direction -- azimuth 35 degrees, elevation 20 degrees -- and nothing here is analytic: the silhouette of a modelled body turns continuously, so every boundary pixel carries its own sub-pixel offset and the instrument is the whole boundary rather than any one edge."
  },
