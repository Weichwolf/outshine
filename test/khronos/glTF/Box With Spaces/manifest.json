{
  "schema": "outshine/render-oracle-manifest",
  "schemaVersion": 1,
  "id": "render/uri/box-with-spaces",
  "title": "A file whose buffer, images and own name carry spaces -- and whose image URIs are percent-encoded while its buffer URI is not",
  "covers": [
    "I.26",
    "I.26.10",
    "khronos:Box With Spaces",
    "board:1228"
  ],
  "criterion": {
    "kind": "numeric",
    "says": "Box with URI-encoded spaces in the texture names used by a simple PBR material.",
    "statedAt": "https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/2bac6f8c57bf471df0d2a1e8a8ec023c7801dddf/Models/Box With Spaces/README.md"
  },
  "subjectClass": "opaque-min-1px",
  "acceptanceClass": {
    "is": "general-position",
    "because": "The framing rule's own direction over a single static body. What this decides is whether the file RESOLVES: every referenced byte has to be found before a pixel exists, so a reader that hands `Box%20With%20Spaces.png` to the filesystem draws nothing and a reader that hands the raw `Box With Spaces.bin` to a URI parser draws nothing either."
  },
  "blender": {
    "version": "5.2.0",
    "note": "A release version, not a commit. Recorded so a red rung can be attributed to our renderer or to the oracle, and carried in the oracle's cache key so a version bump misses instead of serving a stale render. We do not aim to be bit-identical with Cycles."
  },
