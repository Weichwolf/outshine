  "scene": {
    "frame": "gltf",
    "camera": {
      "source": "manifest",
      "positionM": [
        0.6270458448555801,
        0.3074032086719842,
        0.3626894869610186
      ],
      "lookAtM": [
        1.1742115020751953e-05,
        0.02879589656367898,
        -0.0763645184924826
      ],
      "rollRad": 0.0,
      "yfovRad": 0.47108996144172666,
      "sensorHeightMm": 24.0,
      "clipStartM": 0.7005308610592756,
      "clipEndM": 0.9286557090604709,
      "derivation": "The framing rule of src/gltf/Framing.h, quoted so the runner can refuse a mismatch rather than trust it. World bounds [-0.07523875683546066, -1.5291385352611542e-05, -0.157095642760396] to [0.07526224106550217, 0.05760708451271057, 0.0043666057754307985], so centre = [1.1742115020751953e-05, 0.02879589656367898, -0.0763645184924826] and radius = 0.1140624240005976 m. yfov = 2*atan(12/50) from a 50 mm lens on a 24 mm sensor height at sensor_fit VERTICAL. distance = radius / sin(yfov/2) / 0.6 = 0.8145932850598733, and the eye is centre + (cos20*cos35, sin20, cos20*sin35) * distance. clipStart is distance - radius and clipEnd is distance + radius.",
      "note": "The glTF carries no camera, so the framing rule supplies one. Roll is 0 because the rule sets it: a roll chosen here and nowhere else would make this subject's placement a second determination competing with the rule."
    },
    "light": {
      "kind": "none",
      "note": "The material emits, so nothing has to arrive for the picture to exist."
    },
    "world": {
      "kind": "uniform",
      "colourLinear": [
        1.0,
        1.0,
        1.0
      ],
      "strength": 0.0,
      "note": "Declared and zero rather than left factory, so the picture is a function of this manifest and not of a Blender default. At zero bounces an emission returns its emission alone, so this changes no covered pixel."
    },
    "material": {
      "source": "manifest",
      "kind": "emission-per-material",
      "colourLinearPerMaterial": {
        "earhooks": [
          0.85,
          0.15,
          0.15
        ],
        "temples": [
          0.15,
          0.3542572472504414,
          0.85
        ],
        "nose_pads": [
          0.5585144945008829,
          0.85,
          0.15
        ],
        "lens_interior": [
          0.85,
          0.15,
          0.7627717417513241
        ],
        "lens_exterior": [
          0.15,
          0.85,
          0.7329710109982343
        ]
      },
      "note": "Emission, one colour per glTF material, keyed by the name the FILE gives it, on a golden-angle hue sweep so no two are close. A material row that reached the wrong body is a whole body of the wrong hue rather than a sub-pixel offset."
    }
