+bool FillSamplingGap(std::vector<double> &sampling, double toM, double stepM) {
+  const double fromM = sampling.back();
+  if (toM == fromM) { return true; }
+  const auto intervals = static_cast<size_t>((toM - fromM) / stepM);
+  for (size_t at = 1; at <= intervals; ++at) {
+    const double nextM = fromM + static_cast<double>(at) * stepM;
+    if (nextM >= toM) { break; }
+    if (nextM <= sampling.back() || sampling.size() == kMaxRibbonStations) { return false; }
+    sampling.push_back(nextM);
+  }
+  if (sampling.size() == kMaxRibbonStations) { return false; }
+  sampling.push_back(toM);
+  return true;
+}
