diff --git a/test/outshine/src/base/curve/Ribbon/RibbonFillsOnlyRequiredStationGaps.cpp b/test/outshine/src/base/curve/Ribbon/RibbonFillsOnlyRequiredStationGaps.cpp
new file mode 100644
--- /dev/null
+++ b/test/outshine/src/base/curve/Ribbon/RibbonFillsOnlyRequiredStationGaps.cpp
@@ -0,0 +1,49 @@
+#include "Ribbon.h"
+#include "Check.h"
+#include <array>
+#include <cstddef>
+#include <string>
+
+int main() {
+  using namespace outshine;
+  using namespace outshine::Test;
+  ReferenceLine line;
+  std::string error;
+  CHECK(line.Lay({}, {{.LengthM = 10}}, error), "straight independent station reference");
+  const Section section{.HalfWidthM = 2, .ShoulderM = 1, .ThicknessM = 0.5};
+  constexpr std::array dense{0.0, 1.5, 4.5, 7.5, 10.0};
+  const auto ribbon = Sweep(line, section, 0, 10, 3, RibbonForm::Surface, dense);
+  CHECK(ribbon.Woven, "required profile events form a valid ribbon");
+  CHECK(ribbon.Stations == dense.size(), "already bounded event gaps need no second raster");
+  if (ribbon.Woven && ribbon.Stations == dense.size()) {
+    for (size_t at = 0; at < dense.size(); ++at) {
+      CHECK_NEAR(ribbon.PositionM[at * kRibbonAcross * 3], dense[at], 0, "m", "event retained");
+    }
+  }
+  constexpr std::array sparse{0.0, 1.5, 1.5, 4.5, 10.0};
+  const auto filled = Sweep(line, section, 0, 10, 3, RibbonForm::Surface, sparse);
+  constexpr std::array expected{0.0, 1.5, 4.5, 7.5, 10.0};
+  CHECK(filled.Woven && filled.Stations == expected.size(), "only the uncovered gap is filled");
+  if (filled.Woven && filled.Stations == expected.size()) {
+    for (size_t at = 0; at < expected.size(); ++at) {
+      const double stationM = filled.PositionM[at * kRibbonAcross * 3];
+      CHECK_NEAR(stationM, expected[at], 0, "m", "gap interpolation retains required stations");
+      if (at > 0) {
+        const double previousM = filled.PositionM[(at - 1) * kRibbonAcross * 3];
+        CHECK(stationM > previousM && stationM - previousM <= 3, "strict bounded station gaps");
+      }
+    }
+  }
+  CHECK(line.Rise({{.AlongM = 0, .Value = 0},
+                   {.AlongM = 1.5, .Value = 2},
+                   {.AlongM = 4.5, .Value = 0},
+                   {.AlongM = 10, .Value = 0}},
+                  error),
+        "narrow height event remains a physical profile constraint");
+  const auto crest = Sweep(line, section, 0, 10, 3, RibbonForm::Surface, dense);
+  CHECK(crest.Woven && crest.Stations == dense.size(), "height knots retain bounded sampling");
+  if (crest.Woven) {
+    CHECK_NEAR(crest.PositionM[kRibbonAcross * 3 + 1], 2, 1e-6, "m", "crest is not skipped");
+  }
+  return Report();
+}
