#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer Palette { float palette[]; };
struct Probe { vec4 PointDx; vec2 Dy; int Which; uint Mode; };
layout(std430, set = 0, binding = 1) readonly buffer Inputs { Probe probes[]; };
struct Result { vec4 Wearing; vec4 Detail; };
layout(std430, set = 1, binding = 0) writeonly buffer Outputs { Result results[]; };
layout(std140, set = 2, binding = 0) uniform Pushed { uint count; uint unmapped; uvec2 padding; };
const float kPi = 3.14159265358979323846;
#include "metalRoughBrdf.glsl"

vec3 reflected(vec3 normal, vec3 light, vec3 view, vec3 halfVector, float roughness, float vh) {
  float nl = max(dot(normal, light), 0.0);
  float nv = max(dot(normal, view), 1e-6);
  float nh = max(dot(normal, halfVector), 0.0);
  float alpha = roughness * roughness;
  Brdf value = metalRoughBrdf(vec3(0.0), vec3(0.04), 1.0, alpha * alpha, nl, nv, nh, vh);
  return value.specular * nl;
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= count) { return; }
  Probe probe = probes[index];
  uint entry = 320u + 8u * uint(probe.Which);
  vec3 mean = vec3(palette[entry], palette[entry + 1u], palette[entry + 2u]);
  uint offset = floatBitsToUint(palette[entry + 4u]);
  uint lobes = floatBitsToUint(palette[entry + 5u]);
  vec3 light = probe.PointDx.xyz;
  float roughness = probe.PointDx.w;
  vec3 view = vec3(probe.Dy.x, 0.0, probe.Dy.y);
  vec3 halfVector = normalize(light + view);
  float vh = max(dot(view, halfVector), 0.0);
  vec3 value = vec3(0.0);
#if RELIEF_USE_MIXTURE
  for (uint lobe = 0; lobe < lobes; ++lobe) {
    uint at = offset + 4u * lobe;
    vec3 normal = vec3(palette[at], palette[at + 1u], palette[at + 2u]);
    value += palette[at + 3u] * reflected(normal, light, view, halfVector, roughness, vh);
  }
#else
  value = reflected(mean, light, view, halfVector, roughness, vh);
  lobes = 1u;
#endif
  results[index] = Result(vec4(value, float(lobes)), vec4(mean, 1.0));
}
