#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer Palette { float values[]; };
struct Probe { vec4 SourceCoverage; vec2 Distances; int At; uint Mode; };
layout(std430, set = 0, binding = 1) readonly buffer Inputs { Probe probes[]; };
struct Result { vec4 First; vec4 Second; };
layout(std430, set = 1, binding = 0) writeonly buffer Outputs { Result results[]; };
layout(std140, set = 2, binding = 0) uniform Pushed { uint count; uint unmapped; uvec2 padding; };
#include "surfaceTransfer.glsl"
vec3 inputColour(int at) { return vec3(values[at], values[at + 1], values[at + 2]); }
void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= count) { return; }
  Probe probe = probes[index];
  vec3 medium = surfaceMediumTransmittance(inputColour(probe.At + 3), probe.Distances.x,
                                           probe.Distances.y);
  SurfaceTransfer surface = SurfaceTransfer(probe.SourceCoverage.rgb, inputColour(probe.At) * medium);
  if (probe.Mode != 0u) { surface = coveredSurfaceTransfer(surface, probe.SourceCoverage.a); }
  if (probe.Mode == 2u) {
    results[index] = Result(vec4(surfaceTransferBehind(surface, inputColour(probe.At + 6)), 0.0),
                            vec4(medium, 0.0));
  } else {
    results[index] = Result(vec4(surface.Source, 0.0), vec4(surface.Transmittance, 0.0));
  }
}
