#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2DArray inputImage;
layout(rgba32f, set = 1, binding = 0) writeonly uniform image2DArray outputImage;
layout(std140, set = 2, binding = 0) uniform Parameters { vec4 tint; vec4 shift; };

void main() {
  ivec2 at = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(outputImage).xy;
  if (any(greaterThanEqual(at, size))) { return; }
  vec2 uv = (vec2(at) + shift.xy) / vec2(textureSize(inputImage, 0).xy);
  vec4 value = textureLod(inputImage, vec3(uv, 0.0), 0.0) * tint;
  value.r += float(textureSize(inputImage, 0).z);
  imageStore(outputImage, ivec3(at, 0), value);
}
