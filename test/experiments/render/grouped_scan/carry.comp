#version 450
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer Parents { uvec2 parents[]; };
layout(std430, set = 1, binding = 0) buffer Prefix { uvec2 prefix[]; };
layout(std140, set = 2, binding = 0) uniform View { uint count; uint gridWidth; } view;
void main() {
  uint block = gl_WorkGroupID.y * view.gridWidth + gl_WorkGroupID.x;
  uint at = block * 256u + gl_LocalInvocationID.x;
  if (at >= view.count || block == 0u) { return; }
  uvec2 parent = parents[block - 1u];
  if (parent.y == prefix[at].y) { prefix[at].x += parent.x; }
}
