+void fieldRay(mat4 clipFromLocal, vec4 clip, out vec3 nearPoint, out vec4 farPoint) {
+  mat4 localFromClip = inverse(clipFromLocal);
+  vec2 ndc = clip.xy / clip.w;
+  vec4 start = localFromClip * vec4(ndc, 1.0, 1.0);
+  nearPoint = start.xyz / start.w;
+  farPoint = localFromClip * vec4(ndc, 0.0, 1.0);
+}
diff --git a/src/render/shaders/fieldTrace.glsl b/src/render/shaders/fieldTrace.glsl
new file mode 100644
index 000000000..6751c13e2
--- /dev/null
+++ b/src/render/shaders/fieldTrace.glsl
@@ -0,0 +1,71 @@
+#include "fieldMask.glsl"
+#include "fieldTraceView.glsl"
+layout(location=13) noperspective in vec3 fieldRayNear;
+layout(location=14) noperspective in vec4 fieldRayFar;
+float Infinite() { return uintBitsToFloat(0x7f800000u); }
+bool Interval(vec3 origin,vec3 inverse,vec3 low,vec3 high,
+              out float entry,out float leave,out uint entering,out uint exiting) {
+  vec3 a=(low-origin)*inverse,b=(high-origin)*inverse;
+  vec3 near=min(a,b),far=max(a,b);
+  bvec3 parallel=isinf(inverse);
+  if(any(parallel)) {
+    if(((parallel.x && (origin.x<low.x || origin.x>high.x)) || (parallel.y && (origin.y<low.y || origin.y>high.y)) || (parallel.z && (origin.z<low.z || origin.z>high.z)))) return false;
+    near=mix(near,vec3(-Infinite()),parallel);far=mix(far,vec3(Infinite()),parallel);
+  }
+  entry=max(near.x,max(near.y,near.z));
+  leave=min(far.x,min(far.y,far.z));
+  uint first=near.x==entry?0u:(near.y==entry?1u:2u);
+  uint last=far.x==leave?0u:(far.y==leave?1u:2u);
+  entering=2u*first+(inverse[first]>0.0?1u:2u);
+  exiting=2u*last+(inverse[last]>0.0?2u:1u);
+  return entry<=leave && leave>0.0;
+}
+
+vec2 fieldReceiverSlope;
+bool traceField(float maximumHeight, bool backSurface, out vec3 point, out vec3 normal) {
+  vec3 origin=(fieldRayNear-fieldMask.originPitch.xyz).xzy;
+  vec3 direction=normalize(fieldRayFar.xyz-fieldRayNear*fieldRayFar.w).xzy;
+  vec3 inverseDirection=1.0/direction;
+  float pitch=fieldMask.originPitch.w;
+  float inset=(1.0-fieldMask.coverage.x)*pitch*0.5;
+  vec3 low=vec3(inset,inset,0.0);
+  vec3 high=vec3(vec2(fieldMask.shape.xy)*pitch-inset,maximumHeight);
+  float begin,end; uint first,last;
+  if(!Interval(origin,inverseDirection,low,high,begin,end,first,last)) return false;
+  vec2 grid=(origin.xy+max(begin,0.0)*direction.xy)/pitch;
+  ivec2 cell=ivec2(floor(grid));
+  if(direction.x<0.0 && grid.x==floor(grid.x)) --cell.x;
+  if(direction.y<0.0 && grid.y==floor(grid.y)) --cell.y;
+  cell=clamp(cell,ivec2(0),ivec2(fieldMask.shape.xy)-1);
+  ivec2 step=ivec2(direction.x>=0.0?1:-1,direction.y>=0.0?1:-1);
+  vec2 edge=(vec2(cell)+vec2(step.x>0?1.0:0.0,step.y>0?1.0:0.0))*pitch;
+  vec2 next=(edge-origin.xy)*inverseDirection.xy;
+  vec2 delta=abs(pitch*inverseDirection.xy);
+  if(isinf(inverseDirection.x)) next.x=Infinite();
+  if(isinf(inverseDirection.y)) next.y=Infinite();
+  uint most=fieldMask.shape.x+fieldMask.shape.y+2u;
+  for(uint iteration=0u;iteration<most;++iteration) {
+    float height=texelFetch(fieldHeights,cell,0).r;
+    if(height>0.0) {
+      vec3 cellLow=vec3(vec2(cell)*pitch+inset,0.0);
+      vec3 cellHigh=vec3(vec2(cell+1)*pitch-inset,height);
+      float entry,leave; uint entering,exiting;
+      if(Interval(origin,inverseDirection,cellLow,cellHigh,entry,leave,entering,exiting)
+         && (backSurface || entry>=0.0)) {
+        float distance=backSurface?leave:entry;
+        uint face=backSurface?exiting:entering;
+        point=(origin+direction*distance).xzy+fieldMask.originPitch.xyz;
+        vec3 axis=vec3(0.0);
+        axis[(face-1u)/2u]=(face%2u)==1u?-1.0:1.0;
+        normal=axis.xzy;
+        return true;
+      }
+    }
+    float crossing=min(next.x,next.y);
+    if(crossing>end || isinf(crossing)) break;
+    if(next.x<=crossing) { cell.x+=step.x;next.x+=delta.x; }
+    if(next.y<=crossing) { cell.y+=step.y;next.y+=delta.y; }
+    if(any(lessThan(cell,ivec2(0))) || any(greaterThanEqual(cell,ivec2(fieldMask.shape.xy)))) break;
+  }
+  return false;
+}
