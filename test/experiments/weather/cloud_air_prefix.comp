#version 450
#extension GL_GOOGLE_include_directive : require
#include "cloud_air_prefix.glsl"
#include "AirPrefixProbeLayout.h"

#ifndef CLOUD_PREFIX_COVER
#define CLOUD_PREFIX_COVER 0.65
#endif
#ifndef CLOUD_PREFIX_EXTINCTION_PER_M
#define CLOUD_PREFIX_EXTINCTION_PER_M 0.012
#endif
#ifndef CLOUD_PREFIX_FRESH_QUERY
#define CLOUD_PREFIX_FRESH_QUERY 0
#endif
#ifndef CLOUD_PREFIX_CLEAR_CONTROL
#define CLOUD_PREFIX_CLEAR_CONTROL 0
#endif

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D veil;
layout(set = 0, binding = 1) uniform sampler2D multiScatter;
layout(std430, set = 0, binding = 2) readonly buffer Rays { ProbeRay rays[]; } from;
layout(std430, set = 0, binding = 3) readonly buffer Queries { float distanceKm[]; } query;
layout(std430, set = 1, binding = 0) writeonly buffer Results { ProbeSample samples[]; } into;
layout(std140, set = 2, binding = 0) uniform Parameters { Medium Air; } pushed;

CloudAirPrefix beginCloudRay(ProbeRay inputRay) {
  float azimuth = uintBitsToFloat(inputRay.Pad);
  float horizontal = sqrt(max(0.0, 1.0 - inputRay.Ray.CosView * inputRay.Ray.CosView));
  vec3 direction = vec3(horizontal * cos(azimuth), inputRay.Ray.CosView, horizontal * sin(azimuth));
  vec3 originM = vec3(0.0, (inputRay.Ray.RadiusKm - pushed.Air.BottomRadiusKm) * 1000.0, 0.0);
  CloudLayer layer = CloudLayer(vec4(pushed.Air.BottomRadiusKm * 1000.0, 2572.0, 600.0, CLOUD_PREFIX_EXTINCTION_PER_M),
      vec4(CLOUD_PREFIX_COVER, 0.0, 0.0, 0.0), vec4(256.34352, 0.0, -148.0, 0.0));
  CloudLight light = CloudLight(vec3(-0.6, 0.8, 0.0),
      vec3(1.0, 0.97, 0.92), vec3(0.10, 0.12, 0.16));
  AirPathSpan span = airPathSpan(pushed.Air, inputRay.Ray);
  AirRay clearRay = airPathRay(pushed.Air, inputRay.Ray, span);
  AirPrefix clear = airPrefixBegin(pushed.Air, clearRay, veil, multiScatter);
  return cloudAirPrefixBegin(layer, originM, direction, inputRay.Ray.DistanceKm * 1000.0,
      light, clear, span.BeginKm * 1000.0);
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= uint(from.rays.length())) { return; }
  ProbeRay inputRay = from.rays[index];
  CloudAirPrefix prefix = beginCloudRay(inputRay);
  for (uint at = inputRay.QueryBegin; at < inputRay.QueryEnd; ++at) {
#if CLOUD_PREFIX_FRESH_QUERY
    prefix = beginCloudRay(inputRay);
#endif
    float queryM = query.distanceKm[at] * 1000.0;
#if CLOUD_PREFIX_CLEAR_CONTROL
    float clearKm = clamp((queryM - prefix.ClearBeginM) * 0.001, 0.0, prefix.Clear.Ray.DistanceKm);
    AirTransfer result = airPrefixAdvance(prefix.Clear, pushed.Air, clearKm, veil, multiScatter);
#else
    AirTransfer result = cloudAirPrefixAdvance(prefix, queryM, pushed.Air, veil, multiScatter);
#endif
    bool valid = CLOUD_PREFIX_COVER <= 0.0 ||
        (queryM >= prefix.BeginM && queryM <= prefix.EndM);
    uint counts = (prefix.CellsVisited << 24u) | (prefix.Cloud.DensityEvaluations << 16u) |
        (prefix.Cloud.SourceEvaluations << 8u) | (valid ? 0u : 1u);
    into.samples[at] = ProbeSample(result.RadiancePerLux.r, result.RadiancePerLux.g,
        result.RadiancePerLux.b, result.Transmittance.r, result.Transmittance.g,
        result.Transmittance.b, prefix.Clear.SourceEvaluations, counts);
  }
}
