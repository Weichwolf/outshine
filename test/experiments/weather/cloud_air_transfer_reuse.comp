#version 450
#extension GL_GOOGLE_include_directive : require
#include "airSource.glsl"
#include "AirPrefixProbeLayout.h"
#include "transfer_grid.glsl"
#include "cloud_air_transfer_response.glsl"
#ifndef TRANSFER_CUBIC
#define TRANSFER_CUBIC 0
#endif
#if TRANSFER_CUBIC
#include "cloud_air_transfer_cubic.glsl"
#endif

layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform sampler2D veil;
layout(set = 0, binding = 1) uniform sampler2D multiScatter;
layout(std430, set = 0, binding = 2) readonly buffer Rays { ProbeRay rays[]; } from;
layout(std430, set = 0, binding = 3) readonly buffer Queries { float distanceKm[]; } query;
layout(set = 0, binding = 4) uniform sampler2D visibilityField;
layout(std430, set = 1, binding = 0) writeonly buffer Results { ProbeSample samples[]; } into;
layout(std140, set = 2, binding = 0) uniform Parameters { Medium Air; } pushed;

vec3 transferVisibility(uint index) {
  ivec2 pixel = ivec2(int(index) % transferImageExtent.x, int(index) / transferImageExtent.x);
#if TRANSFER_CUBIC
  return transferCubicVisibility(visibilityField, pixel, transferImageExtent, transferStep);
#else
  ivec2 extent = textureSize(visibilityField, 0);
  ivec2 cell = min(pixel / transferStep, extent - 2);
  ivec2 begin = cell * transferStep;
  ivec2 end = min(begin + transferStep, transferImageExtent - 1);
  vec2 weight = vec2(pixel - begin) / vec2(end - begin);
  vec2 uv = (vec2(cell) + weight + 0.5) / vec2(extent);
  return textureLod(visibilityField, uv, 0.0).rgb;
#endif
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= uint(from.rays.length())) { return; }
  ProbeRay inputRay = from.rays[index];
  AirPathSpan span = airPhysicalSpan(pushed.Air, inputRay.Ray);
  AirRay ray = airPathRay(pushed.Air, inputRay.Ray, span);
  AirSourceTerms terms = airSourceTermsAt(pushed.Air, ray, 0.0,
      airSunVisible(pushed.Air, ray, 0.0), veil, multiScatter);
  vec3 visibility = transferVisibility(index);
  for (uint at = inputRay.QueryBegin; at < inputRay.QueryEnd; ++at) {
    float lengthKm = max(0.0, min(query.distanceKm[at], span.EndKm) - span.BeginKm);
    vec3 through = exp(-terms.Extinction * lengthKm);
    vec3 integral = transferIntegral(terms.Extinction, lengthKm);
    vec3 radiance = integral * (terms.DirectEmission * visibility + terms.DiffuseEmission);
    into.samples[at] = ProbeSample(radiance.r, radiance.g, radiance.b,
        through.r, through.g, through.b, 1u, 0u);
  }
}
