#version 450
#extension GL_GOOGLE_include_directive : require
#include "cloudLayer.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Points {
  vec4 Values[];
}

points;

layout(std430, set = 1, binding = 0) writeonly buffer Densities {
  float Values[];
}

densities;

layout(std140, set = 2, binding = 0) uniform SplitWeather {
  vec4 Shell;
  vec4 Field;
  vec4 CoordinateOrigin;
  uvec4 BroadBase;
  vec4 BroadFraction;
  uvec4 DetailBase;
  vec4 DetailFraction;
}

weather;

void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= points.Values.length()) { return; }
  CloudLayer layer = CloudLayer(weather.Shell,
                                weather.Field,
                                weather.CoordinateOrigin,
                                weather.BroadBase,
                                weather.BroadFraction,
                                weather.DetailBase,
                                weather.DetailFraction);
  densities.Values[index] = cloudExtinction(layer, points.Values[index].xyz);
}
