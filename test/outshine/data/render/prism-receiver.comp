#version 450
#extension GL_GOOGLE_include_directive : require
#include "render/shaders/prismReceiver.glsl"
layout(local_size_x = 64) in;
struct Case { mat4 model; mat4 light; uvec4 meta; };
struct Result { vec4 plane; vec4 check; };
layout(std430, set = 0, binding = 0) readonly buffer Cases { Case cases[]; };
layout(std430, set = 1, binding = 0) writeonly buffer Results { Result results[]; };
void main() {
  uint id = gl_GlobalInvocationID.x;
  if (id >= cases.length() || id >= results.length()) { return; }
  Case entry = cases[id];
  vec3 normal = vec3(0.0);
  normal[entry.meta.x] = entry.meta.y == 0u ? 1.0 : -1.0;
  vec4 plane = prismReceiverPlane(mat3(entry.light), mat3(entry.model), normal);
  float visibility = prismPlaneShadowVisibility(vec4(0.48, 0.52, 0.48, 0.52),
      vec2(0.25, 0.75), 0.5, plane, vec2(-0.25, -0.75) / 16.0, vec2(1.0) / 16.0);
  results[id].plane = plane;
  results[id].check = vec4(float(entry.meta.z), visibility, 0.0, 1.0);
}
