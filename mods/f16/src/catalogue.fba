# THE CAST OF THIS SCENARIO — every airframe FlightBox flies but is not judged on, as a declaration.
# The engine holds the SCHEMA (sim/src/core/FBAircraft.h: what a flown airframe HAS) and nothing else;
# WHICH aircraft exist is this file, and a title that wants others writes its own.
#
# FORMAT. `aircraft <key>` opens a row, indented `<field> <value>` lines fill it, `#` is a comment.
# The key is the mission file's `module <name>`. A field the schema does not know is an ERROR with its
# line number, never a dropped line. An OMITTED field means the schema's own default, so what stands
# here is what this row DEPARTS from — `radar_az_half_deg 0` on a row with no radar at all is a
# statement, and the fighters that carry the default +-60 deg say nothing.
#
# TWO MOTION LAWS AND NO ROW GETS BOTH: a row flies on JSBSim (`fdm <model>`) iff its own manoeuvre
# decides an outcome AND its envelope is published; everything else is a kinematic mover with a
# `cruise_ms`/`max_ms`/`ceiling_m`/`climb_ms` block and no flight model. Those two are the same fact
# seen twice — fighter data IS envelope data — so the test never splits a row. Ten decks, eight movers.
#
# Every number's source and confidence tier: doc/modules/air/catalogue.md. The deck rows' eight
# aerodynamic anchors live with the deck generator (sim/tools/gen_air_decks.py) and are measured back
# by `make -C sim test-air`; what is repeated here is only what the SIMULATION reads.
#
# span_m and length_m are the published dimensions and are not decoration: the damage layout, the
# presented area a gun burst sees and the angular size the EYE resolves are all derived from them, and
# they are the ONE sensor input a published source carries for every airframe without exception.


# ============================ THE TEN DECK ROWS ============================
# Each flies a deck GENERATED from its eight published anchors. The perf hooks are the recipe's step 7
# — MEASURED on the generated deck by `make -C sim test-air`, not set — and a row whose roll plant is
# still absent has not been through it and is refused `set task bfm`.

# F-15C: the peer western opponent, four campaigns. T4, and the row that makes the SARH/active pairing
# interesting on ONE aircraft — with Sparrows it fights the MiG-29's bound fight, with AMRAAMs the
# F-16's. Radar 160 km [T4] against the source's unstated reference target; the direction of that error
# is stated in the catalogue rather than corrected here.
aircraft f15c
  name                   "F-15C Eagle"
  tier                   T4
  fdm                    f15c
  engines                2
  span_m                 13.05
  length_m               19.43
  radar_search_m         160000
  radar_track_m          80000
  radar_notch_ms         40
  rwr                    1
  net_member             1
  stations               8
  gun                    m61a1
  gun_rounds             940
  corner_kt              330
  corner_g               7
  max_g                  9
  alpha_limit_deg        22
  min_speed_kt           200
  climb_speed_kt         350
  approach_kt            150
  pitch_stick_max        0.273
  roll_plant_a           0.680712
  roll_plant_k_degs      176.22

# Su-27S: NO CAMPAIGN FILE NAMES THIS TYPE (catalogue A11) — it is in the catalogue because the round
# asked for it, and that is stated rather than dressed up. The one row whose published radar ranges
# state their reference RCS (3 m^2), so the sigma^(1/4) conversion to the tree's 1.2 m^2 reference can
# be DONE rather than assumed: 100 -> 79.5 km search, 65 -> 51.7 km track.
aircraft su27
  name                   "Su-27S"
  tier                   T4
  fdm                    su27
  engines                2
  span_m                 14.7
  length_m               21.9
  radar_search_m         79500
  radar_track_m          51700
  radar_notch_ms         40
  rwr                    1
  irst_m                 50000
  irst_high_m            70000
  net_member             1
  stations               10
  gun                    gsh301
  gun_rounds             150
  corner_kt              340
  corner_g               7
  max_g                  9
  alpha_limit_deg        24
  min_speed_kt           210
  climb_speed_kt         360
  approach_kt            160
  pitch_stick_max        0.278

# MiG-21bis: three campaigns, and the row that is NOT a weak MiG-29. Its +-30 x +-10 deg field is a
# QUARTER of the sky an F-16's CRM covers, it cannot look down AT ALL (`radar_lookdown_m 0` — "it
# couldn't intercept targets flying under the MiG"), and its longest-ranged weapon is an 8 km infrared
# round — an aircraft that can only be brought to a fight by somebody else, which is what the source
# says about its doctrine and what `set brief_gci` already expresses.
# radar_frame_s 2.0 [DERIVED] by the engine's own volume/frame relation from the sourced +-30 deg: it
# sweeps its narrow field twice as fast as an F-16 sweeps its wide one, and sees a quarter as much sky.
aircraft mig21
  name                   "MiG-21bis"
  tier                   T3
  fdm                    mig21
  span_m                 7.154
  length_m               14.7
  radar_search_m         20000
  radar_track_m          10000
  radar_az_half_deg      30
  radar_el_half_deg      10
  radar_frame_s          2
  radar_lookdown_m       0
  rwr                    1
  net_member             1
  stations               4
  gun                    gsh23l
  gun_rounds             200
  corner_kt              300
  corner_g               6
  max_g                  8.5
  alpha_limit_deg        20
  min_speed_kt           190
  climb_speed_kt         330
  approach_kt            145
  pitch_stick_max        0.203
  roll_plant_a           0.724278
  roll_plant_k_degs      318.528

