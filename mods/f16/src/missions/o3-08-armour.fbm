  team hostile
  flight column 3
  spawn 30.80068 32.55700 300 90.0 450
  set gear up
  set fuel_pct 70
  set n019_emission off
  set rwr on
  set store 3 fab500
  set store 6 fab500
  set brief_master_arm arm
  set task attack
  set attack_mode opt
  wp 30.80068 32.62000 300 450
  wp 30.86000 32.35000 300 450
  objective kill unit y8v4
  objective survive

unit y8d
  module mig29
  team hostile
  flight column 4
  spawn 30.80203 32.55700 300 90.0 450
  set gear up
  set fuel_pct 70
  set n019_emission off
  set rwr on
  set store 3 fab500
  set store 6 fab500
  set brief_master_arm arm
  set task attack
  set attack_mode opt
  wp 30.80203 32.62000 300 450
  wp 30.86500 32.35000 300 450
  objective kill unit y8v5
  objective survive

# THE COLUMN: six vehicles, 150.0 m apart, PARKED (C14). v3 and v6 are nobody's aim point.
unit y8v1
  module target_soft
  team friendly
  spawn 30.79663 32.62000 ground 0.0 0

unit y8v2
  module target_soft
  team friendly
  spawn 30.79798 32.62000 ground 0.0 0

unit y8v3
  module target_soft
  team friendly
  spawn 30.79933 32.62000 ground 0.0 0

unit y8v4
  module target_soft
  team friendly
  spawn 30.80068 32.62000 ground 0.0 0

unit y8v5
  module target_soft
  team friendly
  spawn 30.80203 32.62000 ground 0.0 0

unit y8v6
  module target_soft
  team friendly
  spawn 30.80338 32.62000 ground 0.0 0

# THE COLUMN'S OWN GUN: optical sight only, and the afternoon sun is what makes it work at all.
unit y8flk
  module zu23
  team friendly
  spawn 30.80000 32.62000 ground 270.0 0
  set emcon free
