name payerne-four-1
runway 46.84335 6.91523 441.0 228.0 2889     # Payerne RWY23 -- mission-wide off-runway-touchdown check
timeout 600                                  # sim-seconds until TIMEOUT

# A four-ship on an air start ~10 nm SW of Payerne, echelon to the southeast, all on 048 at 300 kt.
# The scaling case for the gym's per-unit threading (fb-gym --threads, app/FBTickPool.h): four
# independent airframes of near-equal cost, so wall clock at --threads 4 vs 1 measures the pool and
# nothing else. Each ship owns its waypoints and its own altitude block (500 m apart, no conflicts);
# SUCCESS needs all four to reach all of theirs.

unit lead
  module f16
  team friendly
  spawn 46.73800 6.72200 3000 48.0 300
  set gear up
  set fuel_pct 60
  wp 46.84335 6.91523 3200 320
  wp 46.95000 7.05000 3400 320

