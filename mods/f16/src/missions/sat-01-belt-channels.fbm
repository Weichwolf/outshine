  team friendly
  flight hi 1
  spawn 33.20000 43.85000 6000 90.0 480
  set gear up
  set fuel_pct 80
  set fcr_mode crm
  set fcr_range_nm 40
  set rwr on
  set datalink on
  set store 1 aim120
  set store 2 aim120
  set store 6 aim9
  set store 7 aim9
  set cmds_mode auto
  set cmds_program 1
  set cmds_chaff 60
  set cmds_flare 60
  set brief_master_arm arm
  set task intercept
  wp 33.20000 45.20000 6000 480
  objective kill unit bmig1
  objective avoid zone sa6belt exposure 200
  objective survive

