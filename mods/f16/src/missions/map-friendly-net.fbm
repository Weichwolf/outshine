name map-friendly-net
timeout 300
time 2026-08-03T10:00:00Z

# THE FIRST FRIENDLY NET IN THIS TREE, AND THE TACTICAL MAP'S ONLY SOURCE.
#
# [MESS, 2026-08-02] 78 missions declare a `net` and the controller of all 78 sits on the `hostile`
# team. The capability was generic from the day it was written -- `net <name>` with `control`, `member`,
# `period`, `hold`, `wcs` -- but the side the player commands had never been given one, so the tactical
# map had no source. Inventing a picture in the frontend would be exactly the omniscience this tree
# forbids (doc/player-layer.md §9.1/§9.2), so the map round begins HERE and not in the client.
#
# THE CAST, and the whole box is 46 km wide so that one map frame holds it
#   magic   friendly `e3`, the CONTROL NODE and the unit the map draws. It fuses three things and no
#           fourth: its own anonymous echoes, every member's PPLI, and every member's own surveillance
#           report. What it puts on the air is an FBNetReport -- a POINT with a look age, NO id field
#           and NO team field -- plus the weapons-control word it transmits.
#   vip1/2  friendly `f16`, the MEMBERS, on a racetrack over the node. On this jet the net IS the
#           Link-16 terminal it already carries (modules/FBAirNet.h): the node's doctrine word arrives
#           on the same block the flight's PPLI does, and this jet's own nearest ANONYMOUS echo goes
#           back the same way. Cut off from the node it falls back to the DECLARED autonomy -- here
#           `free`, so a lost link does not disarm a combat air patrol.
#   raider  hostile `mig23`, inbound from the east at 8 000 m. It radiates nothing and shoots nothing.
#
# WHAT TO READ
#   events.log       `net JOIN unit=vip1 node=magic` at t = 0.1, then the node's own first
#                    `radar RADAR_CONTACT unit=magic`. THAT INSTANT is the earliest the map may carry a
#                    symbol for the raider, and P9's acceptance is one frame either side of it.
#   telemetry_*.csv  dl_* on the members, radar_* on the node.
#
# READING RULE: nobody here shoots anybody, and the fighters fly a closed racetrack they never finish.
# Exit 3 (TIMEOUT) is the passing value. The run is a failure of the MECHANISM only if `net JOIN` never
# appears on a member, or the node never holds a contact.

net cap
  control magic                      # the node: the picture the tactical map draws IS this one
  link radio 400000 mast 0           # a real radio link -- it has a horizon and it can be jammed
  period 1.0                         # [SET] the fighters' own PPLI rate; a wing net is not a SAM net
  hold 3                             # [SET] cycles of silence before a member is on its own
  wcs free                           # what the node transmits today
  member magic
  member vip1 autonomy free          # [SET] cut off from control, a CAP does not disarm itself
  member vip2 autonomy free

unit magic
  team friendly
  module e3
  spawn 46.80000 7.00000 9000 0.0 220
  set orbit 8000 600                 # a tight station, so the map's centre barely moves
  set drag_threat_s 0                # ordered to hold the orbit: the honest way to say "never runs"
  wp 46.83000 7.00000 9000 220

unit vip1
  module f16
  team friendly
  flight cap 1
  spawn 46.84000 6.88000 7000 90.0 280
  set gear up
  set fuel_pct 70
  set fcr_mode crm
  set fcr_range_nm 20
  set rwr on
  set iff_interrogator on
  wp 46.84000 7.12000 7000 280
  wp 46.76000 7.12000 7000 280
  wp 46.76000 6.88000 7000 280
  wp 46.84000 6.88000 7000 280

unit vip2
  module f16
  team friendly
  flight cap 2
  spawn 46.76000 6.88000 6400 90.0 280
  set gear up
  set fuel_pct 70
  set fcr_mode crm
  set fcr_range_nm 20
  set rwr on
  set iff_interrogator on
  wp 46.76000 7.12000 6400 280
  wp 46.84000 7.12000 6400 280
  wp 46.84000 6.88000 6400 280
  wp 46.76000 6.88000 6400 280

unit raider
  team hostile
  module mig23
  spawn 46.80000 7.28000 8000 270.0 400
  wp 46.80000 6.60000 8000 400
