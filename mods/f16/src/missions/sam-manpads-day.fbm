name sam-manpads-day-1
timeout 160

# A MANPADS IS A TWO-KILOMETRE DAY WEAPON, and nothing in this file says so. doc/modules/ground/module.md
# §Knowledge 2.
#
# The 9K32 team has NO radar. Its only detector is sensors/FBVisualSystem — the same eye vis-day.fbm
# measures — and the eye's reach against an F-16 was measured there at 3 784 m beam-on, 2 493 m head-on
# and 2 469 m tail-on. The Strela-2M's published envelope is 800-4 200 m. So
#
#     engagement range = min(weapon Rmax, what the gunner can see) = min(4 200, 3 784) = 3 784 m
#
# and THE SENSOR BINDS AT EVERY ASPECT. Nothing was tuned to produce that: the row declares no detection
# range at all, because it has none to declare.
#
# WHAT TO READ:
#   events.log   `vis CONTACT` on the SITE's side (the gunner sees), then `site STATE ... to=TRACK`,
#                `site LAUNCH`, `missile PHASE`, and either a `stores DETONATION` or a `stores MISS`
#   telemetry_manpads.csv  vis_contacts, vis_best_mrad, site_state, site_rounds
#
# sam-manpads-night.fbm is this file with ONE line changed and it produces NOTHING.
#
# READING RULE: exit 2 = CRASH is the expected verdict (the viper is hit at close range and low level).
# What is being measured is the LAUNCH and the range it happened at, not the verdict.

time 2026-06-21T11:00:00Z

unit viper
  module f16
  team friendly
  spawn 46.58000 6.90000 2000 0.0 350          # low and fast, passing the team beam-on
  set gear up
  set fuel_pct 60
  set fcr_mode off
  set rwr on
  wp 46.68000 6.90000 2000 350

unit manpads
  module sa7
  team hostile
  spawn 46.63000 6.89000 ground 0.0 0          # ~800 m west of the track, 5.5 km up the run-in
  set emcon free
  set rounds 2
