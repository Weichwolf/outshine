name mk84-radius-1
timeout 160

# WHAT A BIGGER BOMB BUYS, IN THE MODEL'S OWN CURRENCY. doc/air-to-ground.md §Knowledge 2.
#
# One CCIP pass, one Mk 84, three identical `target_soft` installations at DIFFERENT distances from the
# measured crossing. Nothing about lethality is declared here: the whole verdict comes out of
# core/FBDamageModel's untouched fragment law with the store's own WarheadKg,
#
#     flux(r) = 0.5 * (0.5 * 428.6 kg) / (4*pi*r^2) * (1800^2 + v_impact^2)  =  2.81e7 / r^2  [J/m^2]
#
# against the SAME thresholds `target_soft` has carried since the ground catalogue existed
# (degrade 1.2e3, fail 2.8e3) — hence a fail radius of 100 m and a degrade radius of 153 m.
#
# The three targets are placed against the MEASURED crossing of THIS store, exactly as every attack-*
# file in this tree places its aim point: 80 m, 128 m and 140 m from where the bomb actually came down.
#
# WHAT TO READ:
#   events.log      three `damage DAMAGE unit=... rangeM=... fluxJm2=...` lines, one per target, and
#                   `damage SYSTEM ... state=failed` for the near one alone
#   UNIT_RESULT     near DESTROYED, wide INTACT, far INTACT
#
# READING RULE: exit 0 is not the measurement. The MEASUREMENT is the three UNIT_RESULT lines, and the
# pass is DESTROYED / INTACT / INTACT — a radius, not a switch. Read beside mk82-radius.fbm, which
# flies the identical geometry with a 500 lb bomb and leaves the near target standing.

unit viper
  module f16
  team friendly
  spawn 46.90000 6.80000  900 90.0 450
  set gear up
  set fuel_pct 60
  set datalink off
  set fcr_mode off
  set store 3 mk84
  set brief_master_arm arm
  set task attack
  set attack_mode ccip
  wp 46.90000 7.05000 900 450
  wp 46.95000 7.20000 3000 400
  objective survive

unit near
  module target_soft
  team hostile
  spawn 46.900359 7.051629 ground 90.0 0     # 79.9 m from the measured Mk-84 crossing
unit wide
  module target_soft
  team hostile
  spawn 46.901448 7.050340 ground 90.0 0     # 127.8 m, across the run-in track
unit far
  module target_soft
  team hostile
  spawn 46.900300 7.052421 ground 90.0 0     # 140.1 m, along it
