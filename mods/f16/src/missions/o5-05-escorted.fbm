  team friendly
  flight es1 1
  module f16
  spawn 44.93000 19.68000 6000 90.0 450
  set gear up
  set fuel_pct 70
  set datalink on
  set fcr_mode crm
  set fcr_range_nm 40
  set rwr on
  set store 1 aim120
  set store 2 aim120
  set store 3 aim120
  set store 4 aim120
  set store 6 aim9
  set store 7 aim9
  set cmds_mode man
  set cmds_program 1
  set cmds_chaff 60
  set cmds_flare 60
  set brief_master_arm arm
  set task intercept
  wp 44.93000 20.45000 6000 450
  objective kill team hostile
  objective survive

