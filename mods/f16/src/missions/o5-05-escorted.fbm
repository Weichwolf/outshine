  module f16
  spawn 44.91500 19.68000 6150 90.0 450
  set gear up
  set fuel_pct 70
  set datalink on
  set fcr_mode crm
  set fcr_range_nm 40
  set rwr on
  set store 1 aim120
  set store 2 aim120
