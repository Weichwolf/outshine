name mig29-r73-1
timeout 90

# THE FIRST INFRARED SHOT — and the first mission in which a flare does something.
#
# TWO BRANCHES IN ONE FILE, because the whole point of the mechanism is the DIFFERENCE between them and
# a single number proves nothing. Both are the same weapon, the same seeker class and the same code
# path; only the ASPECT differs, and with it what the seeker measures:
#
#   sensors/FBIrstSystem::SelectFlare — the head compares two received irradiances, I/r^2, in one unit
#   (a clean airframe seen dead astern = 1.0):
#     dead astern, dry        aircraft 1.00   flare 1.00  ->  the cartridge cannot beat the nozzle
#     dead astern, afterburner         2.25            ->  not close
#     head-on, dry                     0.16            ->  the cartridge wins six times over
#   Nothing in that chain is a die, and nothing in it reads the target's private state: the aspect is
#   geometry the head measures, the flare intensity is published in the target's signature exactly as
#   its chaff clouds are.
#
# BRANCH A — "arkhip" shoots "prey" FROM ASTERN. The target dispenses nothing (it has no reason to: it
# does not know). Expected: the R-73 tracks the airframe the whole way and detonates on it.
#
# BRANCH B — "boris" shoots "flint" HEAD-ON. The target dispenses flares on a briefed schedule
# straddling the endgame. Expected: irst FLARE_SEDUCED on the round's own head, the seeker's published
# angles walk onto a cartridge, the pure-PN law flies at the cartridge with full authority and no idea
# anything happened, and the round goes past the aircraft.
#
# Both shooters use the N019 close-combat pattern with its range gate opened, the same device
# intercept-aim120 uses on the F-16: a narrow auto-locking beam, so the run is about the WEAPON and not
# about acquiring. Both fire on a briefed pickle rather than through the intercept phase machine, for
# the same reason — one variable at a time.
#
# READING RULE: exit 3 = TIMEOUT is the pass, and the two branches are read off events.log rather than
# off a verdict — a miss is not a mission result. MEASURED (2026-07-28):
#   branch A  stores DETONATION unit=arkhip_r73_1 target=prey missM=0.138 fuzeM=3.5 tofS=8.19
#             -> prey combat-ineffective, reported as its own FAIL and expected by arkhip's objective
#   branch B  irst FLARE_SEDUCED unit=boris_r73_2 tgtIntensity=0.16 (the head-on, dry figure exactly)
#             at t=9.7 s, 1.0 s after launch, and again at 13.5 s and 16.9 s as the schedule refreshes;
#             the round never detonates and expires at its 60 s lifetime with
#             stores EXPIRED ... closestM=22.80  -- 6.5 fuze radii wide of the aircraft it was shot at.
# Also visible in each round's own telemetry: msl_seeker 1 -> 2, msl_range -1 throughout (an angle-only
# head cannot measure one, and the column says so instead of printing a truth it never had), and
# msl_losrate driven toward zero by the pure-PN law — at the CARTRIDGE, in branch B.

unit arkhip
  module mig29
  team hostile
  spawn 46.90000 6.85000 6000 90.0 420       # 4 km astern of prey, same heading, overtaking
  set gear up
  set fuel_pct 60
  set n019_mode cc                           # narrow auto-locking pattern...
  set n019_range_nm 40                       # ...with the gate opened, as intercept-aim120 does
  set n019_emission illum
  set store 3 r73
  set brief_master_arm arm
  set brief_release_s 8                      # inside the R-73's own envelope, tail aspect
  wp 46.90000 7.60000 6000 420
  # The one objective line in the file, and it is bookkeeping rather than a task: without it prey's
  # destruction is an UNEXPECTED loss, decides the run at ~17 s and branch B never gets to finish
  # (core/FBObjective.h, doc/missions/verdict.md). With it the loss is the declared purpose of the
  # shot, is reported as prey's own FAIL, and the run goes on to the timeout that lets the second
  # round fly its whole life. boris declares nothing at all, so branch B is read off events.log —
  # which is the honest shape for it: a MISS is not a mission verdict.
  objective kill unit prey

unit prey
  module f16
  team friendly
  spawn 46.90000 6.90000 6000 90.0 300       # straight and level, dispensing nothing
  set gear up
  set fuel_pct 60
  set fcr_mode off
  wp 46.90000 7.90000 6000 300

unit boris
  module mig29
  team hostile
  spawn 47.10000 6.85000 6000 90.0 420       # a separate pair 22 km north, head-on this time
  set gear up
  set fuel_pct 60
  set n019_mode cc
  set n019_range_nm 40
  set n019_emission illum
  set store 3 r73
  set brief_master_arm arm
  set brief_release_s 8
  wp 47.10000 7.60000 6000 420

unit flint
  module f16
  team friendly
  spawn 47.10000 6.98000 6000 270.0 300      # nose-to-nose with boris, closing
  set gear up
  set fuel_pct 60
  set fcr_mode off
  set cmds_mode man                          # the throw travels the command bus like any other action
  set cmds_program 3                         # PRGM 3 = FLARE (chaff has nothing to work on here)
  set cmds_chaff 60
  set cmds_flare 60
  set brief_chaff_s 9                        # a burning cartridge in the air across the whole endgame:
  set brief_chaff_s 11                       # a flare lives 4 s (core/FBCountermeasure.h), so the
  set brief_chaff_s 13                       # schedule is denser than that on purpose
  set brief_chaff_s 15
  set brief_chaff_s 17
  wp 47.10000 6.30000 6000 300
