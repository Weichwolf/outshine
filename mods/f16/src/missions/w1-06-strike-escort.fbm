  set store 4 r27r
  set store 5 r73
  set store 6 r73
  set store 1 r73
  set store 2 r73
  set cmds_mode man
  set cmds_program 1
  set cmds_chaff 30
  set cmds_flare 30
  set brief_master_arm arm
