unit nvcvy6
  module target_soft                          # aim point 1: mock vehicle convoy [T1 target kind]
  team hostile
  spawn 37.30000 -116.14000 ground 90.0 0

unit nvpk6
  module target_soft                          # aim point 2: parked aircraft [T1 target kind]
  team hostile
  spawn 37.28198 -116.18000 ground 90.0 0

unit nvbnk6
  module target_hard                          # bunkered defensive position - present, not aimed at
  team hostile
  spawn 37.30000 -116.22000 ground 90.0 0
