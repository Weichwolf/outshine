name clock-night-payerne-1
timeout 300                                  # sim-seconds until TIMEOUT (mission-wide)

# THE MISSION CLOCK — AND THE PROOF THAT IT ARRIVES.
#
# READING RULE: exit 0 is the flight, not the finding. What this file measures is in events.log and in
# telemetry.csv, and it is measured whatever the waypoints do:
#
#   events.log   `mission CLOCK utc=1999-03-24T22:00:00Z sunElDeg=-37.0489 ...`  — the instant the
#                file declared, and the sun angle it IMPLIES at the primary actor's spawn point. The
#                file may only spell Zulu (doc/missions/syntax.md), so this line is where "22:00Z over
#                Payerne is night" becomes checkable without the author doing spherical trigonometry.
#   telemetry    `blk_env` = 1 for every row. Without a `time` line it is 0 for the whole run in every
#                one of the other missions in this directory: no clock, no ephemeris, no published
#                environment block. That single column IS the difference the clock makes.
#
# WHY 1999-03-24T22:00:00Z. It is the opening night of Allied Force (doc/campaigns/w4-allied-force.md),
# the campaign that needs a clock most — 30+ of the specified missions are night missions and until this
# round not one of them could say so. Flown over Payerne rather than over Serbia because the baked
# Switzerland DEM is what fb-gym resolves ground truth from without a network.
#
# THE CLOCK CHANGES NO PHYSICS, AND THAT IS MEASURED, NOT ASSERTED. JSBSim's own time base is untouched
# and nothing is written into any FDM property. The spawn and the route below are payerne-airstart.fbm's
# verbatim, and the two runs' telemetry.csv agree over all 2167 rows in EVERY column but `blk_env`.

time 1999-03-24T22:00:00Z                    # mission-wide, at most once, before the first `unit` block

unit viper
  module f16                                 # FBModuleRegistry key -> FBF16Module (doc/missions/INDEX.md)
  spawn 46.73202 6.73455 2500 48.0 300       # the air start of payerne-airstart.fbm, unchanged
  set gear up
  set fuel_pct 60
  wp 46.84335 6.91523 2500 300               # over Payerne, same altitude
  wp 46.95000 7.05000 2800 300               # further NE — no 'land': SUCCESS = both waypoints reached
