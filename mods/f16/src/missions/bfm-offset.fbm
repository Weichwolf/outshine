name bfm-offset-1
timeout 300                                  # sim-seconds until TIMEOUT

# BFM FROM THE BEAM: bfm-basic.fbm's fight, started from the position a pursuer does NOT want. Same
# defender, same defined manoeuvre (a sustained max-rate level left turn around one unreachable
# waypoint — see bfm-basic.fbm's header for why that target and why the run ends at its timeout), same
# datalink-off, radar-only sensor limit. Only viper's initial condition changes, and it changes in the
# way that matters: instead of sitting in bandit's rear hemisphere it starts 1.5 nm off his BEAM,
# nose-on but with its velocity vector 90 deg across his — aspect ~90 deg at t=0 instead of ~0. THIS is
# the mission the angle-gain proof is read from: aspect has somewhere to fall from.
#
# That is a real angle DISADVANTAGE, not just a longer range: nothing about the initial geometry is
# working for the pursuer, and the defender's turn is away from it, so viper has to solve the angle
# problem before it can even start closing. (The lock-loss case has its own mission: bfm-blind.fbm.)

unit viper
  module f16
  team friendly
  spawn 46.64989 6.90000 4000 0.0 380        # 1.5 nm on bandit's beam, nose on him, 90 deg off his track
  set gear up
  set fuel_pct 60
  set datalink off
  set fcr_mode acm_hud
  set task bfm

unit bandit
  module f16
  team friendly
  spawn 46.67485 6.90000 4000 90.0 300
  set gear up
  set fuel_pct 60
  set datalink off
  set fcr_mode off
  wp 46.70000 6.90000 4000 300               # the CENTRE of its turn — see the header
