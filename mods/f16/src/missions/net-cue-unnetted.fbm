name net-cue-unnetted-1
timeout 320

# THE CONTROL RUN OF `net-cue.fbm`: the identical geometry with the `net` block DELETED and nothing else
# changed. doc/air-defence-network.md, acceptance criterion 3, and requirement 1 of its section 0.
#
# The 2K12 is under `emcon hold`, so it is DARK until something it RECEIVED tells it to come up. The
# viper flies with `fcr_mode off`, so the position's own passive receiver never hears an airborne
# emitter; and a P-18 next door is a SURFACE emitter, which is not a reason to scramble a battery.
# Without the cable the battery therefore never radiates, never tracks and never shoots.
#
# THIS IS THE ANSWER TO "IS KILLING AN EARLY-WARNING RADAR WORTH A SORTIE": before this round the two
# runs were arithmetically identical, because an EW set cued nobody.
#
# WHAT TO READ: telemetry_sam.csv `site_state` never leaves 1 (DARK), `site_beam0` stays 0,
# `site_launches` stays 0, and there is not one `site RADIATE`, `site TRACK` or `site LAUNCH` line in
# events.log. `net_*` columns do not exist in this file at all — the position is on no net.
#
# READING RULE: exit 0 = SUCCESS with the viper's waypoint reached and `zone_sa6belt_s` > 0 is the pass.
# A run that produces any `site LAUNCH` line is the failure.
zone sa6belt 46.75000 6.90000 22000 100 7000    # the mobile layer, as the judge sees it

unit viper
  module f16
  team friendly
  spawn 46.25000 6.90000 3000 0.0 450
  set gear up
  set fuel_pct 60
  set fcr_mode off                              # NOTHING on this jet radiates: the ESM cue never fires
  set rwr on
  wp 46.85000 6.90000 3000 450

unit ew
  module p18
  team hostile
  spawn 46.30000 7.20000 ground 0.0 0           # 23 km east of the track: never in its own cone of silence
  set emcon free

unit sam
  module sa6
  team hostile
  spawn 46.75000 6.90000 ground 0.0 0
  set emcon hold                                # dark until something it RECEIVED says otherwise
  set rounds 3
