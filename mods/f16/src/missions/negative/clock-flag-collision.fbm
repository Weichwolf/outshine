name clock-flag-collision-1
timeout 300

# A VALID FILE THAT MUST REFUSE ONE INVOCATION. Run it with `gpu_native --utc SECS` and the boot ends:
# a mission that declares its own instant and a client flag that declares another are not a precedence,
# they are a contradiction, and silent precedence would let a stale --utc in a shell history move a
# measured detection range without a line in the output. The flag survives only because gpu_native also
# runs with no mission at all (the cloud proof cameras), so it cannot simply be deleted the way `wx`
# never had one. Required outcome: exit 1, RESULT result=FAIL reason="mission declares 'time
# 1999-03-24T22:00:00Z' and a client clock override (--utc / FB_SIM_UTC) is set — drop one of the two".
# Without --utc this same file is an ordinary night mission. See ./README.md.

time 1999-03-24T22:00:00Z

unit viper
  module f16
  spawn 46.73202 6.73455 2500 48.0 300
  wp 46.84335 6.91523 2500 300
