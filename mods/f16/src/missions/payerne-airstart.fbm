name payerne-airstart-1
timeout 500                                  # sim-seconds until TIMEOUT (mission-wide)

unit viper                                   # one actor block: callsign, then everything it owns
  module f16                                 # FBModuleRegistry key -> FBF16Module (doc/missions/INDEX.md)
  spawn 46.73202 6.73455 2500 48.0 300       # ~10 nm SW of Payerne, 2500 m ASL, heading back toward the
                                             # field (048), 300 kt — no runway/gear-down/taxi at all
  set gear up                                # already retracted, matches a real air start
  set fuel_pct 60                            # 60% of the model's own declared tank capacity
  wp 46.84335 6.91523 2500 300               # over Payerne, same altitude
  wp 46.95000 7.05000 2800 300               # further NE, gently climbing — no 'land': SUCCESS = both reached
