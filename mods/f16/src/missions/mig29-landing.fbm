name mig29-landing-1
# READING RULE: exit 0 = SUCCESS is the verdict. payerne-landing.fbm's air start, same fix, same
# heading, same altitude, flown by FBMig29Module -- so the Approach/Flare/Rollout numbers of the two
# pilots are compared on one glideslope-capture-from-below and not on two different ones.
runway 46.84335 6.91523 441.0 228.0 2889     # Payerne threshold RWY23
timeout 400                                  # sim-seconds until TIMEOUT

unit fulcrum
  module mig29
  spawn 46.94354 7.07791 941.0 228.0 250     # ~9 nm out on RWY23's extended final, on the runway
                                             # heading, ~500 m AGL -- below the nominal 3 deg path at
                                             # this range, i.e. a capture from below, not a freebie.
                                             # 250 kt is the documented pattern speed band's low end
                                             # (>= 300 kt pattern / 200-220 kt downwind, DCS-EA p.80)
  set gear up                                # a real air start has no gear down yet
  set fuel_pct 40                            # ~11.5 t: inside the 12 t the touchdown anchors are quoted at
  land                                       # Approach -> Flare -> Rollout to a stop on the runway above
