name test-wp-inside-turn-1
timeout 240

# A WAYPOINT THE AIRCRAFT CANNOT ARRIVE AT, and the proof that a route still gets past it.
#
# THE GEOMETRY IS THE WHOLE MISSION. The jet runs east at 300 kt and captures WP0; WP1 sits exactly
# 1,000 m NORTH of it, i.e. 90 degrees off the inbound track. At 300 kt and the guidance's 60-degree bank
# limit the tightest turn this jet flies has a radius of ~1,400 m (V^2/(g*tan 60)), so the turn circle it
# rolls into at WP0 has its centre 1,400 m north — and WP1, 400 m from that centre, lies INSIDE it. The
# closest the aircraft can ever get to WP1 is 1,400 - 400 = 1,000 m: twice the 500 m capture circle, for
# ever, on any lap. A point-pursuit guidance simply orbits it (that is exactly what missions/
# bfm-basic.fbm's defender is built to do), and the run times out with WP1 unreached.
#
# WHAT MAKES IT PASSABLE is not a bigger circle but the leg WP0->WP1 itself: past the perpendicular
# through WP1 the fix is BEHIND, whatever the miss distance was. Both authorities apply that rule
# independently and must agree — systems/FBNavSystem sequences the guidance with it, core/
# FBMissionMonitor judges the verdict with it from its own private copy of the plan — so a SUCCESS here
# is two separate statements of "past it", not one shared line of code. events.log carries the
# distinction: the `by=` field of WP_REACHED reads `capture` for WP0 and WP2 and `passed` for WP1.
#
# WP2 is what proves the aircraft is still flying a route afterwards rather than merely having ticked a
# box: it lies 4.5 km north of WP0, i.e. on the far side of the turn, and is captured normally.
# No `objective` line — SUCCESS is all three waypoints reached, and nothing else can produce it.

unit viper
  module f16
  team friendly
  spawn 46.90000 6.80000 2500 90.0 300       # airborne, due east, 2,500 m ASL
  set gear up
  set fuel_pct 60
  set datalink off
  set fcr_mode off
  wp 46.90000 6.90000 2500 300               # WP0: 7.6 km ahead, straight in
  wp 46.90898 6.90000 2500 300               # WP1: 1,000 m north of WP0 — inside the turn circle
  wp 46.94000 6.90000 2500 300               # WP2: 4.5 km north of WP0, on the far side of the turn
