name payerne-takeoff-only-1
runway 46.84335 6.91523 441.0 228.0 2889     # lat lon elevM trueHdgDeg lengthM (DEM-checked: fb-tiles /elev ~441 m at the threshold)
timeout 600                                  # sim-seconds until TIMEOUT

unit viper
  module f16                                 # FBModuleRegistry key -> FBF16Module (doc/missions/INDEX.md)
  spawn threshold ground 228.0 0             # sat on gear at the runway threshold, runway heading, v=0
  wp 46.74293 6.75267 2500 350               # ~9 nm SW on the runway heading, climbing out
  wp 46.66467 6.62666 3000 350               # ~16 nm SW, higher — no land keyword: SUCCESS = both waypoints reached (Phase 1)
