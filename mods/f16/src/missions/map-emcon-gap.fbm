name map-emcon-gap
timeout 300
time 2026-08-03T10:00:00Z

# THE MAP SEES WHAT THE FACTION MEASURED, AND THIS FILE IS THE PROOF THAT IT SEES NOTHING ELSE.
#
# Identical to `map-friendly-net.fbm` in cast and geometry and different in exactly THREE `set` lines:
# the node's radar and both fighters' radars start OFF. The faction therefore begins the run BLIND --
# it has a net, it has a link, it has a picture, and there is nothing in it. The hostile `raider` flies
# straight through the box, and until somebody's own sensor measures it, IT IS NOT ON THE MAP. Not as a
# faint symbol, not as a guess, not at reduced confidence.
#
# The other half of the pair is the ORDER PATH, and it is why this file has no `brief_*` line that
# would turn a radar on by itself: the only thing that can break the silence is a COMMANDER, and a
# commander's word is a proposal that this pilot's own boxes may refuse. The measuring venue is
#
#   build/gpu_native --mission missions/map-emcon-gap.fbm --interval 10 --map magic \
#       --order 60:magic:emcon:0  --order 60:vip1:emcon:0  --order 120:vip1:attack:<lat>:<lon>:8000
#
# and each of the three is a different answer:
#   magic  REFUSED `no_capability` -- a catalogue row's radar has no silent mode, so it has no
#          radiate/silent switch either. The refusal is the mechanic (doc/player-layer.md §9.6 (a)).
#   vip1   ACCEPTED -- `order ACCEPTED` then `cmd CMD_ISSUE ... RadarMode`, `cmd CMD_ACK ... accepted`,
#          and only THEN a `radar RADAR_CONTACT`. The map's first hostile symbol may not precede it.
#   attack REFUSED `nothing_held` at a place no own sensor holds; ACCEPTED once one does.
#
# READING RULE: as its sibling. Exit 3 (TIMEOUT) is the passing value; the fighters fly a closed
# racetrack they never finish. The run is a failure of the MECHANISM only if a symbol for `raider`
# appears on a map frame BEFORE the first `radar RADAR_CONTACT` of the run.

net cap
  control magic
  link radio 400000 mast 0
  period 1.0
  hold 3
  wcs free
  member magic
  member vip1 autonomy free
  member vip2 autonomy free

unit magic
  team friendly
  module e3
  spawn 46.80000 7.00000 9000 0.0 220
  set orbit 8000 600
  set drag_threat_s 0
  set fcr off                        # THE NODE IS DEAF: it fuses only what its members report
  wp 46.83000 7.00000 9000 220

unit vip1
  module f16
  team friendly
  flight cap 1
  spawn 46.84000 6.88000 7000 90.0 280
  set gear up
  set fuel_pct 70
  set fcr_mode off                   # emission discipline, and it costs exactly what it buys
  set fcr_range_nm 20
  set rwr on
  set iff_interrogator on
  wp 46.84000 7.12000 7000 280
  wp 46.76000 7.12000 7000 280
  wp 46.76000 6.88000 7000 280
  wp 46.84000 6.88000 7000 280

unit vip2
  module f16
  team friendly
  flight cap 2
  spawn 46.76000 6.88000 6400 90.0 280
  set gear up
  set fuel_pct 70
  set fcr_mode off
  set fcr_range_nm 20
  set rwr on
  set iff_interrogator on
  wp 46.76000 7.12000 6400 280
  wp 46.84000 7.12000 6400 280
  wp 46.84000 6.88000 6400 280
  wp 46.76000 6.88000 6400 280

unit raider
  team hostile
  module mig23
  spawn 46.80000 7.28000 8000 270.0 400
  wp 46.80000 6.60000 8000 400
