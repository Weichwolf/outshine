name f16-aim9-1
timeout 90

# THE SAME TWO BRANCHES, THE OTHER AIRFRAME — and that is the point of the file. `mig29-r73.fbm` proves
# that an infrared round works; this one proves that it is the SAME MECHANISM and not a MiG-29 feature:
# one seeker class (modules/missile/FBMissileIrSeeker, an sensors/FBIrstSystem derivation), one
# deception rule (SelectFlare's irradiance inequality), two catalogue entries with different numbers.
#
# The two rounds differ where the sources differ, and both differences are visible in the trace:
#   AIM-9M   seeker gimbal +-30 deg [T4], instantaneous field +-2.5 deg [SET], WDU-17/B 9.4 kg [T3],
#            derived fuze radius 6.0 m
#   R-73     gimbal +-75 deg [DCS-FM p.71], field +-5 deg [SET], 7.4 kg warhead [DCS-FM p.72] and a
#            DOCUMENTED 3.5 m blast radius — the one proximity radius in the tree that is sourced
#
# BRANCH A — "viper" shoots "quarry" FROM ASTERN, no countermeasures. Expected: a hit.
# BRANCH B — "eagle" shoots "bandit" HEAD-ON while it dispenses flares. Expected: seduced, and a miss.
#   Both targets are F-16s, and NOT because a MiG-29 would behave differently to the seeker: this
#   airframe has no dispensers at all in FlightBox (the BVP-30-26 is a named gap in
#   doc/modules/mig29/module.md — no source states its programme parameters), so it cannot answer an
#   infrared shot. That is a real asymmetry of the current state and it is recorded rather than papered
#   over with an invented programme.
#
# WHY THE F-16 CAN CARRY AN AIM-9 AT ALL AS OF THIS ROUND: doc/modules/f16/weapons.md listed it under
# "not implemented" for want of an infrared seeker, and `set store <n> aim9` needed nothing but the
# catalogue entry once one existed. No F-16 code changed.
#
# READING RULE: exit 3 = TIMEOUT is the pass; the branches are read off events.log.
# MEASURED (2026-07-28):
#   branch A  stores DETONATION unit=viper_aim9_1 target=quarry missM=0.0196 fuzeM=6.0 tofS=7.72
#   branch B  irst FLARE_SEDUCED unit=eagle_aim9_2 tgtIntensity=0.16 at t=9.7 s (the head-on, dry figure
#             exactly, the same one the R-73 measures) and again at 13.3 s; the round never detonates
#             and expires at its 60 s lifetime with stores EXPIRED ... closestM=25.96 -- 4.3 fuze radii
#             wide of the aircraft it was shot at.

unit viper
  team friendly
  module f16
  spawn 46.90000 6.85000 6000 90.0 420       # 4 km astern of quarry, overtaking
  set gear up
  set fuel_pct 60
  set fcr_mode acm_hud                       # the auto-locking ACM box...
  set fcr_range_nm 40                        # ...with the gate opened, as intercept-aim120 does
  set store 3 aim9
  set brief_master_arm arm
  set brief_release_s 8
  wp 46.90000 7.60000 6000 420
  # Bookkeeping, exactly as in mig29-r73: without it quarry's loss is an unexpected one and decides the
  # run before branch B has flown (doc/missions/verdict.md).
  objective kill unit quarry

unit quarry
  team hostile
  module f16
  spawn 46.90000 6.90000 6000 90.0 300       # straight and level, dispensing nothing
  set gear up
  set fuel_pct 60
  set fcr_mode off
  wp 46.90000 7.90000 6000 300

unit eagle
  team friendly
  module f16
  spawn 47.10000 6.85000 6000 90.0 420       # a second pair 22 km north, head-on
  set gear up
  set fuel_pct 60
  set fcr_mode acm_hud
  set fcr_range_nm 40
  set store 3 aim9
  set brief_master_arm arm
  set brief_release_s 8
  wp 47.10000 7.60000 6000 420

unit bandit
  team hostile
  module f16
  spawn 47.10000 6.98000 6000 270.0 300      # nose-to-nose with eagle, and dispensing
  set gear up
  set fuel_pct 60
  set fcr_mode off
  set cmds_mode man
  set cmds_program 3                         # FLARE only
  set cmds_chaff 60
  set cmds_flare 60
  set brief_chaff_s 9                        # denser than a cartridge's 4 s life, so one always burns
  set brief_chaff_s 11
  set brief_chaff_s 13
  set brief_chaff_s 15
  set brief_chaff_s 17
  wp 47.10000 6.30000 6000 300
