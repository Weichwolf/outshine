<?xml version="1.0"?>
<!-- FlightBox — 3M9 solid rocket motor, generated by the shared surface-to-air recipe.

     THE SPLIT IS [SET]: the real 3M9 is a solid booster into an integral ramjet; modelled as boost + sustain at an even impulse split, because a ramjet's thrust law is not in this tree and its OBSERVABLE property here is a long sustain.
       propellant   m_p = m0*(1 - 1/exp(dV/ve)) = 599.0*(1 - 1/exp(826/2305)) = 180.4 kg
                        = 397.7 lb   [DERIVED, the tree's shared Isp 235 s -> ve = 2305 m/s]
       dV IS THE WHOLE TERMINAL SPEED, not a delta over a launch speed: this round leaves a RAIL at
       zero airspeed, which is the one place the surface recipe differs from the air-launched one.
       total impulse = 180.4 * 2305 = 415827 N*s
       boost   51978 N (11685 lbf) x 4.0 s
       sustain 11551 N (2597 lbf) x 18.0 s, 50 % of the impulse
     Thrust-to-weight at ignition = 8.8 [DERIVED] — the number that decides whether a round
     launched from standstill leaves the rail at all.
     JSBSim's contract: the table is indexed by PROPELLANT BURNED (lb) and yields VACUUM thrust (lbf);
     the engine consumes wdot = thrust/Isp itself, so burn TIME is an outcome and never stated here.
-->
<rocket_engine name="3M9 motor (FlightBox)">

  <isp> 235 </isp>

  <!-- Ignition transient, [SET] 60 ms, as every other FlightBox motor. -->
  <builduptime> 0.06 </builduptime>

  <thrust_table name="propulsion/thrust_prop_remain" type="internal">
    <tableData><!--
      propellant burned (lb)   vacuum thrust (lbf) -->
       0.00    11685.2
    198.66    11685.2
    198.86     2596.7
    397.52     2596.7
    397.72        0.0
    </tableData>
  </thrust_table>

</rocket_engine>
