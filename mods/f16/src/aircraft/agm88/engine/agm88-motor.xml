<?xml version="1.0"?>
<!-- FlightBox — AGM-88 solid rocket motor, generated by the shared slender-body recipe.

     ONE BURN, and the split is [SET]: no source states this round's boost/sustain profile, so a single
     6 s grain is one invention instead of three.
       propellant   m_p = m0*(1 - 1/exp(dV/ve)) = 353.8*(1 - 1/exp(277.4/2305)) = 40.1 kg = 88.3 lb
                        [DERIVED, the tree's shared Isp 235 s -> ve = 2305 m/s]
       dV is a DELTA over the launch speed (Mach 0.9 at 11 km = 265.6 m/s) up to the [T2] terminal
       Mach 1.84 = 543.0 m/s, which is how every AIR-LAUNCHED round in this tree is sized.
       total impulse = 40.1 * 2305 = 92 431 N*s
       thrust = 92 431 / 6.0 = 15 405 N = 3 463 lbf
     Thrust-to-weight at ignition = 4.4 [DERIVED].
     JSBSim's contract: the table is indexed by PROPELLANT BURNED (lb) and yields VACUUM thrust (lbf);
     the engine consumes wdot = thrust/Isp itself, so burn TIME is an outcome and never stated here.
-->
<rocket_engine name="AGM-88 motor (FlightBox)">

  <isp> 235 </isp>

  <!-- Ignition transient, [SET] 60 ms, as every other FlightBox motor. -->
  <builduptime> 0.06 </builduptime>

  <thrust_table name="propulsion/thrust_prop_remain" type="internal">
    <tableData><!--
      propellant burned (lb)   vacuum thrust (lbf) -->
       0.00    3463.0
      88.10    3463.0
      88.30       0.0
    </tableData>
  </thrust_table>

</rocket_engine>
