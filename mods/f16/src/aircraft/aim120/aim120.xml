<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sourceforge.net/JSBSim.xsl"?>
<!--
  FlightBox — AIM-120 AMRAAM, a FlightBox-OWN JSBSim model.

  WHY IT IS HERE AND NOT IN vendor/. The pinned JSBSim submodule carries no AMRAAM and is read-only
  (CLAUDE.md Prinzip 1), so the only honest place for a model we had to write ourselves is our own
  asset tree — sim/assets/aircraft/, reached through FBModule::FdmModelVendored() == false. Nothing
  under vendor/ is touched by this file's existence.

  WHAT IS MODELLED, and what the guidance code is therefore NOT allowed to do (Prinzip 1 again): the
  whole flight mechanics. Mass and its decrease through the burn, thrust over the burn time, axial and
  normal aerodynamic force over Mach and angle of attack, static stability, pitch/yaw/roll damping and
  the fin control moments all live in this XML and are integrated by JSBSim. modules/missile/ writes
  fin commands and a throttle, and reads back an accelerometer and rate gyros — nothing else. It never
  sets a position, a velocity or an attitude.

  ===========================================================================================
  PROVENANCE. Every number below carries one of these tags, and every derivation states its formula:
    [T-ED]     ED EA Guide figure quoted in doc/f16/weapons.md (the module-level primary source)
    [T3]       public and multiply corroborated (weapons.md §4.4's source list: Sandboxx, Army
               Recognition, f-16.net, Wikipedia)
    [DERIVED]  computed here from a [T-ED]/[T3] figure by the stated formula
    [SET]      a FlightBox engineering choice. No public figure exists; the reasoning is stated and the
               consequence is measurable in the missile's own telemetry.
  The aerodynamic coefficients are ALL [SET] or [DERIVED]: no public aero deck for this missile exists,
  and inventing a citation for one would be worse than saying so. What makes them honest is that they
  are a CONSISTENT slender-body set (the trim relation, the achievable g and the drag deceleration are
  each stated below and each measurable against this model's own telemetry), not that they are sourced.
  ===========================================================================================
-->
<fdm_config name="AIM-120" version="2.0" release="ALPHA"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">

  <fileheader>
    <author> FlightBox </author>
    <filecreationdate> 2026-07-26 </filecreationdate>
    <version> 1.0 </version>
    <description> AIM-120 AMRAAM — active-radar-homing BVR missile, FlightBox's own model </description>
    <note>
      Built from public geometry and mass figures plus a slender-body aerodynamic set derived from
      them; it is not derived from, and contains nothing out of, any restricted source. See the banner
      above for the per-number provenance scheme.
    </note>
  </fileheader>

  <!-- GEOMETRY. Reference area = the BODY CROSS SECTION (missile convention), reference length = the
       body DIAMETER, which is what every coefficient below is non-dimensionalised against.
         diameter 7 in = 0.1778 m [T3] -> S = pi*d^2/4 = 0.02482 m^2 = 0.2672 ft^2 [DERIVED]
         chord := d = 0.5833 ft [DERIVED] — the reference length for the pitch/yaw moments
         wingspan = fin span 526 mm = 1.726 ft [T3, AIM-120A/B] — used only by the roll damping term
         length 12 ft = 144 in [T3]; the aerodynamic reference point sits at the launch CG (see below),
         so the moment coefficients here are moments ABOUT THE CG and JSBSim re-references them itself
         once the burn moves the CG. -->
  <metrics>
    <wingarea  unit="FT2"> 0.2672 </wingarea>
    <wingspan  unit="FT">  1.726  </wingspan>
    <chord     unit="FT">  0.5833 </chord>
    <htailarea unit="FT2"> 0 </htailarea>
    <htailarm  unit="FT">  0 </htailarm>
    <vtailarea unit="FT2"> 0 </vtailarea>
    <vtailarm  unit="FT">  0 </vtailarm>
    <location name="AERORP" unit="IN">
      <x> 69 </x>
      <y> 0 </y>
      <z> 0 </z>
    </location>
    <location name="VRP" unit="IN">
      <x> 69 </x>
      <y> 0 </y>
      <z> 0 </z>
    </location>
  </metrics>

  <!-- MASS. Launch weight 335 lb [T3]; propellant 115 lb [DERIVED — see engine/WPU-6.xml's rocket-
       equation derivation from ED's Mach 4], so the inert structure (airframe + guidance section +
       WDU-41/B 50 lb warhead [T3]) is 220 lb, which is what <emptywt> carries. JSBSim adds the
       propellant tank's own contents on top, so the all-up weight at launch is the 335 lb figure and
       falls to 220 lb at burnout WITHOUT this file stating either — the engine burns it.

       Inertia [DERIVED, uniform-rod idealisation of a 12 ft x 7 in body at the all-up mass]:
         Iyy = Izz = m*L^2/12 = 152 kg * (3.66 m)^2/12 = 170 kg*m^2 = 125 slug*ft^2. Reduced to
         105 slug*ft^2 [SET] because a uniform rod overstates a missile whose heavy sections (warhead,
         motor) sit inboard of the ends.
         Ixx = m*r^2/2 = 152 * 0.0889^2/2 = 0.60 kg*m^2 = 0.44 slug*ft^2 [DERIVED].
       CG at station 69 in [SET] — just forward of mid-body, the classic layout with the seeker and
       warhead forward of the motor. The propellant tank sits AT the CG (see <propulsion>) so the burn
       changes mass without walking the CG; a shifting CG is a real effect nobody can source a number
       for, and a wrong one would silently change the static margin over the flight. -->
  <mass_balance>
    <ixx unit="SLUG*FT2">   0.44 </ixx>
    <iyy unit="SLUG*FT2"> 105.0  </iyy>
    <izz unit="SLUG*FT2"> 105.0  </izz>
    <emptywt unit="LBS">  220.0  </emptywt>
    <location name="CG" unit="IN">
      <x> 69 </x>
      <y> 0 </y>
      <z> 0 </z>
    </location>
  </mass_balance>

  <!-- GROUND REACTIONS. Two structure points, exactly as the vendored mk82 declares them and for the
       same reason: a weapon in flight is given no ground to collide with by its owner
       (units/FBSimUnit's kWeaponNoGroundElevM — a 200,000 lbf/ft/s contact damper met at 800 m/s is a
       stiff ODE that diverges inside one step), and the impact verdict is core/FBFlightMonitor's, not a
       spring's. These exist so the model is complete, not so they fire. -->
  <ground_reactions>
    <contact type="STRUCTURE" name="NOSE_CONTACT">
      <location unit="IN"> <x> 0 </x> <y> 0 </y> <z> 0 </z> </location>
      <static_friction>  0 </static_friction>
      <dynamic_friction> 0 </dynamic_friction>
      <rolling_friction> 0 </rolling_friction>
      <spring_coeff  unit="LBS/FT">      10000 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC">  20000 </damping_coeff>
      <max_steer unit="DEG"> 0.0 </max_steer>
      <brake_group> NONE </brake_group>
      <retractable> 0 </retractable>
    </contact>
    <contact type="STRUCTURE" name="TAIL_CONTACT">
      <location unit="IN"> <x> 144 </x> <y> 0 </y> <z> 0 </z> </location>
      <static_friction>  0 </static_friction>
      <dynamic_friction> 0 </dynamic_friction>
      <rolling_friction> 0 </rolling_friction>
      <spring_coeff  unit="LBS/FT">      10000 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC">  20000 </damping_coeff>
      <max_steer unit="DEG"> 0.0 </max_steer>
      <brake_group> NONE </brake_group>
      <retractable> 0 </retractable>
    </contact>
  </ground_reactions>

  <!-- PROPULSION. One solid rocket motor (engine/WPU-6.xml + its nozzle) fed by one propellant tank at
       the CG. JSBSim's FGRocket lights the motor when the throttle command reaches 1.0 and then burns
       to depletion regardless of throttle — a solid motor has no off switch, which is the property the
       guidance has to live with. The tank's 115 lb is the same [DERIVED] figure the motor's impulse
       was computed from; the grain is declared so JSBSim treats it as a solid charge rather than a
       sloshing liquid. -->
  <propulsion>
    <engine file="WPU-6">
      <feed> 0 </feed>
      <thruster file="WPU-6_nozzle">
        <location unit="IN"> <x> 144 </x> <y> 0 </y> <z> 0 </z> </location>
        <orient unit="DEG"> <roll> 0 </roll> <pitch> 0 </pitch> <yaw> 0 </yaw> </orient>
      </thruster>
    </engine>

    <tank type="FUEL">
      <location unit="IN"> <x> 69 </x> <y> 0 </y> <z> 0 </z> </location>
      <radius unit="IN"> 3.5 </radius>
      <grain_config type="CYLINDRICAL">
        <length unit="IN"> 40 </length>
        <bore_diameter unit="IN"> 1.5 </bore_diameter>
      </grain_config>
      <capacity unit="LBS"> 115.0 </capacity>
      <contents unit="LBS"> 115.0 </contents>
    </tank>
  </propulsion>

  <!-- FIN ACTUATORS. The three normalised commands FBFdm::SetControls writes (fcs/aileron-cmd-norm,
       fcs/elevator-cmd-norm, fcs/rudder-cmd-norm — the ONLY channel anything above the FDM has, see
       fdm/FBFdm.h) through a first-order actuator into a fin deflection in radians.
         rate  : lag c1 = 60 1/s [SET] -> ~17 ms time constant, the order of an electromechanical
                 missile fin actuator; fast against the ~6.6 rad/s airframe mode but not instant, so a
                 guidance loop that demands a step still gets a lagged fin.
         travel: +-25 deg [SET] — the deflection the trim relation below is stated at.
       A cruciform tail-controlled missile mixes four fins into pitch/yaw/roll; the mixing itself is
       linear and adds nothing to the physics, so the three axes are modelled directly. -->
  <flight_control name="FCS: AIM-120 fins">
    <channel name="Pitch">
      <lag_filter name="fcs/elevator-actuator">
        <input> fcs/elevator-cmd-norm </input>
        <c1> 60.0 </c1>
        <clipto> <min> -1.0 </min> <max> 1.0 </max> </clipto>
      </lag_filter>
      <aerosurface_scale name="fcs/elevator-scale">
        <input> fcs/elevator-actuator </input>
        <range> <min> -0.4363 </min> <max> 0.4363 </max> </range>
        <output> fcs/elevator-pos-rad </output>
      </aerosurface_scale>
    </channel>
    <channel name="Yaw">
      <lag_filter name="fcs/rudder-actuator">
        <input> fcs/rudder-cmd-norm </input>
        <c1> 60.0 </c1>
        <clipto> <min> -1.0 </min> <max> 1.0 </max> </clipto>
      </lag_filter>
      <aerosurface_scale name="fcs/rudder-scale">
        <input> fcs/rudder-actuator </input>
        <range> <min> -0.4363 </min> <max> 0.4363 </max> </range>
        <output> fcs/rudder-pos-rad </output>
      </aerosurface_scale>
    </channel>
    <channel name="Roll">
      <lag_filter name="fcs/aileron-actuator">
        <input> fcs/aileron-cmd-norm </input>
        <c1> 60.0 </c1>
        <clipto> <min> -1.0 </min> <max> 1.0 </max> </clipto>
      </lag_filter>
      <aerosurface_scale name="fcs/aileron-scale">
        <input> fcs/aileron-actuator </input>
        <range> <min> -0.4363 </min> <max> 0.4363 </max> </range>
        <output> fcs/left-aileron-pos-rad </output>
      </aerosurface_scale>
    </channel>
  </flight_control>

  <!-- ===================================================================================
       AERODYNAMICS — body AXIAL/NORMAL/SIDE, the missile convention (JSBSim negates AXIAL and NORMAL
       itself, so a positive AXIAL function is drag along -X and a positive NORMAL function is lift
       along -Z; SIDE is signed +Y). Drag along the flight path is therefore NOT a coefficient in this
       file: it emerges as CA*cos(a) + CN*sin(a), which is the honest way round for a body that flies at
       large angles of attack.

       THE THREE STATEMENTS THIS SET IS BUILT TO MAKE, each measurable in the missile's own telemetry:
       (1) TRIM. Full fin (25 deg) trims at alpha = -Cm_de*de/Cm_alpha = 11.3*0.4363/12.0 = 0.41 rad
           = 23.5 deg — the classic tail-control design point, where the achievable g is set by alpha
           and not by running out of fin.
       (2) MANOEUVRE. At that trim alpha, Mach 2, 6 km (q = 119 kPa):
             CN = 9.5*0.41 + 10*0.41^2 - 1.2*0.4363 = 3.90 + 1.68 - 0.52 = 5.06
             N  = CN*q*S = 5.06*119000*0.02482 = 14.9 kN, at ~110 kg = 13.8 g.
           Scaling with density: ~19 g at 3 km, ~25 g at sea level. The public "30+ g" claims are made
           for low-altitude terminal geometry; this set reaches that order there and honestly less high
           up, which is the property that decides whether a target can out-turn the missile.
       (3) DECELERATION AFTER BURNOUT. At Mach 4, 6 km: CA = 0.47, D = 0.47*475 kPa*0.02482 = 5.5 kN at
           100 kg = 5.6 g of deceleration — the reason a BVR shot has a kinematic range at all, and the
           quantity the launch-zone computation in modules/f16/FBF16FireControl integrates.
       =================================================================================== -->
  <aerodynamics>

    <axis name="AXIAL">
      <!-- CA(M): zero-lift axial force, body cross-section referenced [SET — a slender-body/finned-
           missile profile: flat subsonic, the transonic wave-drag rise from M 0.95, the peak just past
           M 1, then the classic supersonic decay. No public AMRAAM drag deck exists. The absolute level
           is anchored by statement (3) above.] -->
      <function name="aero/coefficient/CA">
        <description> Axial force (zero lift) </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <table>
            <independentVar> velocities/mach </independentVar>
            <tableData>
              0.0000  0.400
              0.6000  0.410
              0.8000  0.430
              0.9000  0.470
              0.9500  0.550
              1.0500  0.820
              1.2000  0.840
              1.5000  0.780
              2.0000  0.680
              2.5000  0.600
              3.0000  0.550
              4.0000  0.470
              5.0000  0.440
            </tableData>
          </table>
        </product>
      </function>
      <!-- Induced axial force: an incidence-dependent addition on top of CA0, since a body at alpha
           presents more frontal area and its fins carry induced drag. 0.9*alpha^2 [SET] is the
           small-angle fit that keeps the total drag at 23 deg alpha near CA0 + CN*sin(alpha), i.e.
           consistent with the force resolution the body-axis formulation already does. -->
      <function name="aero/coefficient/CA_alpha">
        <description> Axial force due to angle of attack </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <value> 0.9 </value>
          <property> aero/alpha-rad </property>
          <property> aero/alpha-rad </property>
        </product>
      </function>
    </axis>

    <axis name="NORMAL">
      <!-- CN_alpha(M) per radian [SET — slender body + cruciform mid-body wings; the transonic peak and
           the supersonic decay follow linear-theory behaviour, the level is anchored by statement (2)]. -->
      <function name="aero/coefficient/CN_alpha">
        <description> Normal force due to angle of attack </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> aero/alpha-rad </property>
          <table>
            <independentVar> velocities/mach </independentVar>
            <tableData>
              0.0000   9.00
              0.8000   9.20
              1.0500  11.00
              1.2000  11.50
              1.5000  10.50
              2.0000   9.50
              2.5000   8.80
              3.0000   8.20
              4.0000   7.40
              5.0000   7.00
            </tableData>
          </table>
        </product>
      </function>
      <!-- Crossflow (body vortex) term, 10.0*alpha*|alpha| per rad^2 [SET]: the nonlinear normal force
           a cylindrical body develops at high incidence. Without it the missile would lose exactly the
           lift it needs in the terminal turn, where it flies at 20+ deg. -->
      <function name="aero/coefficient/CN_alpha2">
        <description> Normal force, crossflow (nonlinear in alpha) </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <value> 10.0 </value>
          <property> aero/alpha-rad </property>
          <abs> <property> aero/alpha-rad </property> </abs>
        </product>
      </function>
      <!-- Fin normal force, -1.2 per rad [SET, paired with Cm_de below by the moment arm]: a tail fin
           deflected trailing-edge-down (positive) pushes the TAIL up, i.e. produces a nose-DOWN moment
           AND an upward force. That is the non-minimum-phase behaviour of tail control — the airframe
           first moves the wrong way — and it is modelled because the guidance loop has to be stable
           with it. -->
      <function name="aero/coefficient/CN_de">
        <description> Normal force due to pitch fin deflection </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <value> 1.2 </value>
          <property> fcs/elevator-pos-rad </property>
        </product>
      </function>
    </axis>

    <axis name="SIDE">
      <!-- Cruciform symmetry: the yaw plane is the pitch plane, mirrored. beta > 0 (relative wind from
           the right) produces a force to the LEFT, hence the negative signs. -->
      <function name="aero/coefficient/CY_beta">
        <description> Side force due to sideslip </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> aero/beta-rad </property>
          <value> -1.0 </value>
          <table>
            <independentVar> velocities/mach </independentVar>
            <tableData>
              0.0000   9.00
              0.8000   9.20
              1.0500  11.00
              1.2000  11.50
              1.5000  10.50
              2.0000   9.50
              2.5000   8.80
              3.0000   8.20
              4.0000   7.40
              5.0000   7.00
            </tableData>
          </table>
        </product>
      </function>
      <function name="aero/coefficient/CY_beta2">
        <description> Side force, crossflow (nonlinear in beta) </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <value> -10.0 </value>
          <property> aero/beta-rad </property>
          <abs> <property> aero/beta-rad </property> </abs>
        </product>
      </function>
      <function name="aero/coefficient/CY_dr">
        <description> Side force due to yaw fin deflection </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <value> -1.2 </value>
          <property> fcs/rudder-pos-rad </property>
        </product>
      </function>
    </axis>

    <axis name="PITCH">
      <!-- Cm_alpha = -12.0 per rad [SET]: the static margin, expressed directly as a moment about the
           launch CG. Paired with Cm_de by statement (1) — the pair, not either number alone, is what
           fixes the trim angle of attack and therefore the achievable g. A statically STABLE missile
           (negative Cm_alpha) is what makes the airframe controllable with a first-order autopilot;
           reducing this number would make it more agile and less stable, which is a design trade this
           model does not pretend to have data for. -->
      <function name="aero/coefficient/Cm_alpha">
        <description> Pitch moment due to angle of attack </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/cbarw-ft </property>
          <property> aero/alpha-rad </property>
          <value> -12.0 </value>
        </product>
      </function>
      <!-- Cm_q = -500 per rad [SET]: aerodynamic pitch damping. Deliberately LOW in damping-ratio terms
           (zeta ~ 0.01 at Mach 2/6 km against a 6.6 rad/s airframe mode) because that is what a short,
           finned body actually has — a real missile is stabilised by its autopilot's rate gyro, not by
           its aerodynamics, and modules/missile/FBMissileGuidance therefore carries a rate-damping term
           it genuinely needs. -->
      <function name="aero/coefficient/Cm_q">
        <description> Pitch moment due to pitch rate </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/cbarw-ft </property>
          <property> aero/ci2vel </property>
          <property> velocities/q-aero-rad_sec </property>
          <value> -500.0 </value>
        </product>
      </function>
      <!-- Cm_de = -11.3 per rad [DERIVED from the fin force above and its arm: the tail fins sit at
           station 135 in, the launch CG at 69 in, so the arm is 66 in = 9.43 calibers, and
           Cm_de = -CN_de_magnitude * arm = -1.2 * 9.43 = -11.3]. Negative: positive (TE-down)
           deflection pitches the nose DOWN, which is what makes FBFdm's existing "+pitch command =
           nose up" mapping (it writes -pitch into fcs/elevator-cmd-norm) come out right. -->
      <function name="aero/coefficient/Cm_de">
        <description> Pitch moment due to pitch fin deflection </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/cbarw-ft </property>
          <property> fcs/elevator-pos-rad </property>
          <value> -11.3 </value>
        </product>
      </function>
    </axis>

    <axis name="YAW">
      <!-- The pitch axis mirrored (cruciform). Cn_beta > 0 is weathercock stability: sideslip from the
           right yaws the nose right, into the wind. -->
      <function name="aero/coefficient/Cn_beta">
        <description> Yaw moment due to sideslip </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/cbarw-ft </property>
          <property> aero/beta-rad </property>
          <value> 12.0 </value>
        </product>
      </function>
      <function name="aero/coefficient/Cn_r">
        <description> Yaw moment due to yaw rate </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/cbarw-ft </property>
          <property> aero/ci2vel </property>
          <property> velocities/r-aero-rad_sec </property>
          <value> -500.0 </value>
        </product>
      </function>
      <function name="aero/coefficient/Cn_dr">
        <description> Yaw moment due to yaw fin deflection </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/cbarw-ft </property>
          <property> fcs/rudder-pos-rad </property>
          <value> 11.3 </value>
        </product>
      </function>
    </axis>

    <axis name="ROLL">
      <!-- Roll is not a manoeuvre axis for a cruciform missile: it flies SKID-TO-TURN, pitching and
           yawing without banking, and the roll channel exists only to hold the fin cross steady so the
           two lateral channels stay decoupled. Cl_p = -12 per rad [SET] (strong damping, small span),
           Cl_da = 0.05 per rad [SET] — together a steady roll rate of ~4 rad/s at full fin and Mach 2,
           enough to arrest a roll disturbance in a fraction of a second and far too little to be used
           for turning. -->
      <function name="aero/coefficient/Cl_p">
        <description> Roll moment due to roll rate </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/bw-ft </property>
          <property> aero/bi2vel </property>
          <property> velocities/p-aero-rad_sec </property>
          <value> -12.0 </value>
        </product>
      </function>
      <function name="aero/coefficient/Cl_da">
        <description> Roll moment due to roll fin deflection </description>
        <product>
          <property> aero/qbar-psf </property>
          <property> metrics/Sw-sqft </property>
          <property> metrics/bw-ft </property>
          <property> fcs/left-aileron-pos-rad </property>
          <value> 0.05 </value>
        </product>
      </function>
    </axis>

  </aerodynamics>

</fdm_config>
