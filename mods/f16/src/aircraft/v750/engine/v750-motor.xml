<?xml version="1.0"?>
<!-- FlightBox — V-750V solid rocket motor, generated by the shared surface-to-air recipe.

     THE SPLIT IS [SET]: a two-stage round: a booster that burns ~4-5 s and a sustainer that carries it out to 30 km.
       propellant   m_p = m0*(1 - 1/exp(dV/ve)) = 2163.0*(1 - 1/exp(1030/2305)) = 779.5 kg
                        = 1718.4 lb   [DERIVED, the tree's shared Isp 235 s -> ve = 2305 m/s]
       dV IS THE WHOLE TERMINAL SPEED, not a delta over a launch speed: this round leaves a RAIL at
       zero airspeed, which is the one place the surface recipe differs from the air-launched one.
       total impulse = 779.5 * 2305 = 1796668 N*s
       boost   239556 N (53854 lbf) x 4.5 s
       sustain 32667 N (7344 lbf) x 22.0 s, 40 % of the impulse
     Thrust-to-weight at ignition = 11.3 [DERIVED] — the number that decides whether a round
     launched from standstill leaves the rail at all.
     JSBSim's contract: the table is indexed by PROPELLANT BURNED (lb) and yields VACUUM thrust (lbf);
     the engine consumes wdot = thrust/Isp itself, so burn TIME is an outcome and never stated here.
-->
<rocket_engine name="V-750V motor (FlightBox)">

  <isp> 235 </isp>

  <!-- Ignition transient, [SET] 60 ms, as every other FlightBox motor. -->
  <builduptime> 0.06 </builduptime>

  <thrust_table name="propulsion/thrust_prop_remain" type="internal">
    <tableData><!--
      propellant burned (lb)   vacuum thrust (lbf) -->
       0.00    53854.3
   1030.86    53854.3
   1031.06     7343.8
   1718.23     7343.8
   1718.43        0.0
    </tableData>
  </thrust_table>

</rocket_engine>
