<?xml version="1.0"?>
<!-- FlightBox — the V-750V's nozzle. JSBSim subtracts ambient pressure * exit area from the vacuum
     thrust (FGNozzle::Calculate), which is what makes a solid motor weaker at sea level than at
     altitude. area 1.1307 FT2 [DERIVED] = 53.5 % of this round's 2.1135 ft^2 body cross-section, the
     same proportion the AIM-120 nozzle occupies. The exit diameter itself is [SET].
-->
<nozzle name="V-750V nozzle (FlightBox)">
  <area unit="FT2"> 1.1307 </area>
</nozzle>
