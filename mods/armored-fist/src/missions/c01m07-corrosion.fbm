  set rwr on
  set store 3 mk84                            # Bandit 4 is one T-80: doctrine (c)
  set brief_master_arm arm
  set task attack
  set attack_mode ccrp
  wp 25.00077 67.10273 960 450                # AIM POINT: Bandit 4, a lone T-80
  wp 24.77347 67.06240 1560 450
  objective survive

