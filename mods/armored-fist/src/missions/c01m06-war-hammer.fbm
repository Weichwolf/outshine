  set brief_master_arm arm
  set task attack
  set attack_mode ccrp
  wp 24.97673 67.85083 990 450                # AIM POINT: Bandit 2's lead T-80, a point target
  wp 24.91806 67.62199 1590 450
  objective survive

# ---- THE CALLABLE AIR SUPPORT [GUIDE p.70]: an `ah64` mover, 300 m over its ground, transiting the
# ---- objective. It carries nothing and reports to nobody.
unit m6apache
  module ah64
  team friendly
  spawn 25.06213 67.96755 350 224.0 140
  wp 24.99083 67.89183 350 140

# ---- THE OBJECTIVE AREA
unit m6depot
  module target_soft
  team hostile
  spawn 24.96490 67.86430 ground 224.0 0
unit m6tanks
  module target_soft
  team hostile
  spawn 24.96393 67.86327 ground 224.0 0      # 150 m down-axis: the fuel and propane tanks

