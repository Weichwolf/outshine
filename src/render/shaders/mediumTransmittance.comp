#version 450
#extension GL_GOOGLE_include_directive : require
#include "medium.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba16f, set = 1, binding = 0) uniform writeonly image2D lut;
layout(std140, set = 2, binding = 0) uniform Declared { Medium medium; };

void main() {
  uvec2 at = gl_GlobalInvocationID.xy;
  uvec2 extent = uvec2(imageSize(lut));
  if (at.x >= extent.x || at.y >= extent.y) { return; }
  vec2 uv = (vec2(at) + 0.5) / vec2(extent);
  MediumLook look = mediumTransmittanceParams(medium, MediumUv(uv.x, uv.y));
  vec3 through = mediumTransmittance(medium, look, kTransmittanceSteps, kMediumSampleSegment);
  imageStore(lut, ivec2(at), vec4(through, 1.0));
}
