#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer Buffer_candidates { uint candidates[]; };
layout(std430, set = 0, binding = 1) readonly buffer Buffer_slots { uint slots[]; };
layout(std430, set = 0, binding = 2) readonly buffer Buffer_offsets { uint offsets[]; };
layout(std430, set = 1, binding = 0) buffer Buffer_selected { uint selected[]; };
layout(std140, set = 2, binding = 0) uniform Count { uvec4 count; uvec4 work; } view;
void main() {
  const uint id = gl_GlobalInvocationID.x;
  if (id >= view.count.x) { return; }
  for (uint level = 0u; level < 4u; ++level) {
    const uint slot = slots[level * view.work.x + id];
    if (slot != 0xffffffffu) {
      selected[level * view.work.x + offsets[level * view.work.y + id / view.work.z] + slot] = candidates[id] | (level << 29u);
    }
  }
}
