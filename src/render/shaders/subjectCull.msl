struct CullView {
  float4 planes[6];
  float4 shift;
  uint jobs;
  // THE LADDER'S ONE NUMBER, and it is a length in metres rather than a count of rungs. A cluster
  // is kept when the error IT introduces projects to less than one texel and the error its PARENT
  // would introduce does not, so exactly one rung of every chain draws and neighbours that pick
  // differently still meet: that is Unreal's test and the parent half is what makes it watertight.
  float errorPerMetre;
  uint pad0, pad1;

  // THE OTHER HALF OF NANITE'S CULL. `clip` takes the same space the planes are tested in and
  // lands in clip space; the pyramid holds the FARTHEST depth of each block of the frame BEFORE
  // this one, which is the only frame that can know what is in front. `occludes` is zero until
  // one has been built, because the first frame of a scenario has nothing to hide behind.
  float4x4 clip;
  uint4 pyramidWide;
  uint4 pyramidHigh;
  uint4 pyramidAt;
  uint occludes;
  uint pad2, pad3, pad4;
};

constant uint kClusterFloat4s = 3u;

static inline float projectedError(constant CullView &view, float error, float3 centre,
                                   float radius) {
  const float away = max(length(centre) - radius, 1.0e-3);
  return error * view.errorPerMetre / away;
}

constant uint kCullLanes = 128u;
constant uint kScanLanes = 256u;
constant uint kCullRejected = 0xffffffffu;

kernel void subjectCullKernel(constant CullView &view [[buffer(0)]],
                              device const float4 *spheres [[buffer(1)]],
                              device const uint4 *jobs [[buffer(2)]],
                              device const float4x4 *rows [[buffer(3)]],
                              device const uint *args [[buffer(4)]],
                              device const float *pyramid [[buffer(5)]],
                              device uint *kept [[buffer(6)]],
                              uint id [[thread_position_in_grid]]) {
  if (id >= view.jobs) { return; }
  const uint4 job = jobs[id];
  const float4x4 model = rows[2u * args[5u * job.y + 4u]];
  const float4 sphere = spheres[job.x * kClusterFloat4s];
  const float4 parent = spheres[job.x * kClusterFloat4s + 1u];
  const float4 errs = spheres[job.x * kClusterFloat4s + 2u];
  const float3 centre = (model * float4(sphere.xyz, 1.0)).xyz + view.shift.xyz;
  const float widest = max(max(length(model[0].xyz), length(model[1].xyz)), length(model[2].xyz));
  const float radius = sphere.w * widest;

  for (uint at = 0u; at < 6u; ++at) {
    const float4 plane = view.planes[at];
    if (dot(plane.xyz, plane.xyz) < 0.5) { continue; }
    if (dot(plane.xyz, centre) + plane.w < -radius) {
      kept[id] = 0u;
      return;
    }
  }

  if (view.errorPerMetre > 0.0) {
    const float3 parentCentre = (model * float4(parent.xyz, 1.0)).xyz + view.shift.xyz;
    const float mine = projectedError(view, errs.x * widest, centre, radius);
    const float theirs = projectedError(view, errs.y * widest, parentCentre, parent.w * widest);
    if (!(mine <= 1.0 && theirs > 1.0)) {
      kept[id] = 0u;
      return;
    }
  }
  if (view.occludes != 0u) {
    float2 least = float2(1.0e30, 1.0e30);
    float2 most = float2(-1.0e30, -1.0e30);
    float nearest = -1.0e30;
    bool astride = false;
    for (uint corner = 0u; corner < 8u; ++corner) {
      const float3 at = centre + radius * float3((corner & 1u) != 0u ? 1.0 : -1.0,
                                                 (corner & 2u) != 0u ? 1.0 : -1.0,
                                                 (corner & 4u) != 0u ? 1.0 : -1.0);
      const float4 said = view.clip * float4(at, 1.0);
      if (said.w <= 1.0e-6) {
        astride = true;
        break;
      }
      const float3 ndc = said.xyz / said.w;
      least = min(least, ndc.xy);
      most = max(most, ndc.xy);
      nearest = max(nearest, ndc.z);
    }
    if (!astride) {
      const float2 lo = clamp(float2(least.x * 0.5 + 0.5, 0.5 - most.y * 0.5), 0.0, 1.0);
      const float2 hi = clamp(float2(most.x * 0.5 + 0.5, 0.5 - least.y * 0.5), 0.0, 1.0);
      float across = max((hi.x - lo.x) * float(view.pyramidWide[0]),
                         (hi.y - lo.y) * float(view.pyramidHigh[0]));
      uint level = 0u;
      while (level + 1u < 4u && across > 2.0) {
        across *= 0.5;
        level += 1u;
      }
      const uint wide = view.pyramidWide[level];
      const uint high = view.pyramidHigh[level];
      const uint first = view.pyramidAt[level];
      const uint2 from = uint2(min(uint(lo.x * float(wide)), wide - 1u),
                               min(uint(lo.y * float(high)), high - 1u));
      const uint2 to = uint2(min(uint(hi.x * float(wide)), wide - 1u),
                             min(uint(hi.y * float(high)), high - 1u));
      float farthest = 1.0;
      for (uint down = from.y; down <= to.y && down < from.y + 4u; ++down) {
        for (uint sideways = from.x; sideways <= to.x && sideways < from.x + 4u; ++sideways) {
          farthest = min(farthest, pyramid[first + down * wide + sideways]);
        }
      }
      if (nearest < farthest) {
        kept[id] = 0u;
        return;
      }
    }
  }
  kept[id] = job.w;
}

kernel void subjectScanKernel(constant CullView &view [[buffer(0)]],
                              device const uint *kept [[buffer(1)]],
                              device const uint *batches [[buffer(2)]],
                              device uint *slot [[buffer(3)]],
                              device uint *args [[buffer(4)]],
                              uint batch [[threadgroup_position_in_grid]],
                              uint lane [[thread_position_in_threadgroup]]) {
  threadgroup uint block[kScanLanes];
  threadgroup uint carried;
  const uint first = batches[2u * batch];
  const uint count = batches[2u * batch + 1u];
  if (lane == 0u) { carried = 0u; }
  threadgroup_barrier(mem_flags::mem_threadgroup);

  for (uint from = 0u; from < count; from += kScanLanes) {
    const uint at = from + lane;
    const uint mine = at < count ? kept[first + at] : 0u;
    block[lane] = mine;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint step = 1u; step < kScanLanes; step <<= 1u) {
      const uint taken = lane >= step ? block[lane - step] : 0u;
      threadgroup_barrier(mem_flags::mem_threadgroup);
      block[lane] += taken;
      threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    if (at < count) {
      slot[first + at] = mine == 0u ? kCullRejected : carried + block[lane] - mine;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (lane == kScanLanes - 1u) { carried += block[kScanLanes - 1u]; }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }
  if (lane == 0u) { args[5u * batch] = carried; }
}

kernel void subjectCompactKernel(constant CullView &view [[buffer(0)]],
                                 device const uint4 *jobs [[buffer(1)]],
                                 device const uint *source [[buffer(2)]],
                                 device const uint *slot [[buffer(3)]],
                                 device const uint *args [[buffer(4)]],
                                 device uint *drawIndex [[buffer(5)]],
                                 uint group [[threadgroup_position_in_grid]],
                                 uint lane [[thread_position_in_threadgroup]]) {
  if (group >= view.jobs) { return; }
  const uint at = slot[group];
  if (at == kCullRejected) { return; }
  const uint4 job = jobs[group];
  const uint base = args[5u * job.y + 2u];
  for (uint one = lane; one < job.w; one += kCullLanes) {
    drawIndex[base + at + one] = source[job.z + one];
  }
}
