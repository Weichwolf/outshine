#version 450
#extension GL_GOOGLE_include_directive : require
#include "medium.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D transmittance;
layout(rgba16f, set = 1, binding = 0) uniform writeonly image2D into;
layout(std140, set = 2, binding = 0) uniform Declared { Medium medium; };

void main() {
  uvec2 at = gl_GlobalInvocationID.xy;
  uvec2 extent = uvec2(imageSize(into));
  if (at.x >= extent.x || at.y >= extent.y) { return; }
  vec2 uv = (vec2(at) + 0.5) / vec2(extent);
  vec3 luminance;
  vec3 transfer;
  mediumMultiScatterTexel(medium, uv.x, uv.y, transmittance, kMultiScatterSteps,
                          kMultiScatterGrid, kMediumLuminanceSegment, kMediumGroundLiftKm,
                          luminance, transfer);
  vec3 everyOrder = luminance / (1.0 - transfer);
  imageStore(into, ivec2(at), vec4(everyOrder, 1.0));
}
