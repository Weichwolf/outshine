find_program(OUTSHINE_LINUX_CXX NAMES clang++-22 clang++
  HINTS "$ENV{HOME}/.local/bin" REQUIRED)
set(CMAKE_CXX_COMPILER "${OUTSHINE_LINUX_CXX}" CACHE FILEPATH "Linux C++23 compiler")
execute_process(COMMAND "${OUTSHINE_LINUX_CXX}" -print-resource-dir
  OUTPUT_VARIABLE OUTSHINE_LINUX_RESOURCE OUTPUT_STRIP_TRAILING_WHITESPACE
  COMMAND_ERROR_IS_FATAL ANY)
get_filename_component(OUTSHINE_LINUX_LLVM_LIB "${OUTSHINE_LINUX_RESOURCE}/../.." ABSOLUTE)
set(CMAKE_CXX_FLAGS_INIT "-stdlib=libc++")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static-libstdc++ -L\"${OUTSHINE_LINUX_LLVM_LIB}\"")
set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "-lc++abi")
list(APPEND CMAKE_PREFIX_PATH "${CMAKE_CURRENT_LIST_DIR}/../build/deps/install")
