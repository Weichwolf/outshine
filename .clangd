# clangd config for Outshine. There is no compile_commands.json (the build is a handful of Makefile
# recipes, not a generator-based build system) and the individual recipes even mix -std=c++17 object
# files with a -std=c++20 GPU/webgpu translation unit (render/, render/stages/, world/World.cpp,
# clients/) inside the SAME target -- see Makefile. C++20 is a safe superset of the C++17 subset used
# here (no `concept`/`requires`/`co_*`/`char8_t` identifiers in the c++17-only TUs, checked via grep),
# so one shared std/include profile below is accurate for every file and far less fragile than
# PathMatch-splitting by directory (a new .cpp landing in the wrong subtree would silently fall
# outside a narrower rule).
#
# Paths are ABSOLUTE, not repository-relative: with no compilation database, clangd's synthetic
# fallback compile command resolves each file's OWN directory as the base for relative -I/-isystem
# flags (proven by `clangd --check` -- e.g. src/render/stages/TilesStage.cpp got `-Isrc/core`
# resolved against .../src/render/stages, not the repository root), so relative flags silently miss
# for anything outside the top level. Absolute paths sidestep that without needing a generated
# compile_commands.json (more moving parts -- a generation script to keep in sync with the Makefile's
# per-TU std/-I mix -- for the same maintenance burden of updating roots when the Makefile's -I list
# changes).
#
# Include roots mirror the Makefile's INC_* sets + INC_TILES (tiles/src, style_ver.h --
# world/TerrainLoader.cpp's one cross-project reference) + the native recipe's vendor isystem set
# (Dawn generated + vendored webgpu_cpp.h, the curl compat shim) -- update alongside the Makefile if
# either changes.
#
# Out of scope: world/TerrainLoader.cpp and world/TilePool.cpp still carry `#include <emscripten.h>`
# branches. Pointing clangd at emsdk's own sysroot fights its libc++-vs-libc header ordering when
# driven by plain clang instead of em++ (tried; made things worse) -- reproducing that needs em++
# itself as the compile driver, which no target builds any more.
CompileFlags:
  Add:
    - -std=c++20
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wno-unused-parameter
    - -I/Users/cosmo/Git/flightbox/src/core
    - -I/Users/cosmo/Git/flightbox/src/core/io
    - -I/Users/cosmo/Git/flightbox/src/generators
    - -I/Users/cosmo/Git/flightbox/src/generators/draw
    - -I/Users/cosmo/Git/flightbox/src/render
    - -I/Users/cosmo/Git/flightbox/src/render/stages
    - -I/Users/cosmo/Git/flightbox/src/world
    - -I/Users/cosmo/Git/flightbox/src/world/terrain
    - -I/Users/cosmo/Git/flightbox/src/clients
    - -I/Users/cosmo/Git/flightbox/tiles/src
    - -isystem
    - /Users/cosmo/Git/flightbox/vendor/dawn/out/gen/include
    - -isystem
    - /Users/cosmo/Git/flightbox/vendor/dawn/include
    - -isystem
    - /Users/cosmo/Git/flightbox/vendor
    - -isystem
    - /Users/cosmo/Git/flightbox/vendor/.compat-headers
