# --- build outputs ---
build/
*.o

# --- what a declared run writes where it was started: `give` paths and stills. A measurement
# series is regenerated on demand and never versioned. ---
/*.csv
/*.png
/*.f32

# --- logs & temp ---
*.log
__pycache__/
*.pyc

# --- Claude runtime artifacts (config itself IS tracked) ---
.claude/scheduled_tasks.lock
.claude/settings.local.json
.DS_Store

# --- the compile database: DERIVED from test/run.sh's own tier graph on every `make db`, and it
# has to sit at the project root because that is where clangd and clang-tidy look for it. It is an
# artefact like every other and is never versioned. ---
/compile_commands.json
/build/doc/

# --- clangd's own index ---
.cache/
