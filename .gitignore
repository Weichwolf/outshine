# --- build outputs ---
build/
.venv/
*.o

# --- what a declared run writes where it was started: `give` paths and stills. A measurement
# series is regenerated on demand and never versioned. ---
/*.csv
/*.png
/*.f32

# --- logs & temp ---
*.log
__pycache__/
*.pyc

# --- Claude runtime artifacts (config itself IS tracked) ---
.claude/scheduled_tasks.lock
.claude/settings.local.json
.DS_Store

# CMake compilation database, linked here for clangd and clang-tidy.
/compile_commands.json
/build/doc/

# --- clangd's own index ---
.cache/
