{
  "area": "08-descending", "title": "Ex8 Descending / glide (ANGLE, power idle)",
  "aircraft": ["c172"],
  "setup": { "spawn_alt_agl": 400, "speed": "cruise", "hdg": 90 },
  "arm": true, "duration_s": 30,
  "script": [ { "t": 3, "mode": "ANGLE", "roll": 1500, "pitch": 1480, "thr": 1000 } ],
  "asserts": [
    { "metric": "armed", "gt": 0.5, "desc": "arms" },
    { "metric": "vs",    "lt": -0.5, "desc": "descending (vs < -0.5 m/s)" },
    { "metric": "vs",    "gt": -25, "desc": "descent not a dive" },
    { "metric": "gs",    "gt": 6,   "desc": "maintains gliding speed" },
    { "metric": "roll",  "abs_lt": 10, "desc": "wings level in descent" },
    { "metric": "gps_alt", "gt": 300, "desc": "still airborne" },
    { "metric": "gps_alt", "lt": 471, "desc": "lost altitude from spawn (descended)" },
    { "metric": "fix",   "min": 2,   "desc": "GPS fix" },
    { "metric": "hdg_change", "window": 10, "abs_lt": 25, "desc": "heading held gliding" },
    { "metric": "pitch", "min": -25, "max": 12, "desc": "sane glide pitch" }
  ]
}
