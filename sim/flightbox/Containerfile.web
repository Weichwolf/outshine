# fb-web: lean web host for the browser Command Center. Split out of the merged sim image
# (Containerfile) now that iNav/JSBSim run in their own container -- this one is just fbserver
# (HTTP+WS, static assets, MSP proxy) with no SITL.elf/xpjsb/World process at all. Its WS/MSP
# plumbing still talks AIRCRAFT_ADDR:MSP_PORT (unused today; cleanup is a separate task).
# Build context = sim/.
FROM docker.io/library/debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY common/ common/
COPY flightbox/server.c flightbox/
RUN gcc -O2 -Wall -Icommon flightbox/server.c -o /usr/local/bin/fb-web -lm
# flightbox/web is mounted at runtime (live iteration for `make webgpu`/`make controlcenter`),
# not baked -- WEB_ROOT in server.c is "web" relative to CWD, so we just need the dir to exist
# as a mount point before the bind-mount lands on it.
RUN mkdir -p /app/flightbox/web
WORKDIR /app/flightbox
EXPOSE 8080
CMD ["fb-web"]
