# FlightBox — the ONE sim container: JSBSim (World) + vanilla iNav SITL (Pilot) + the flightbox hub (the
# CC gateway), co-located. Exactly one instance runs; command centers (WASM browser :8080, headless TS CC
# :5766) connect to it and come/go freely. The hub<->iNav MSP link is LOOPBACK inside the container — no
# cross-container hop — while the sensor/radio boundaries (JSBSim<->iNav via --sim=xp, CC<->iNav via MSP)
# stay process-to-process, so the architecture is unchanged; only the packaging is one box.
# Build context = sim/. Ships the prebuilt SITL.elf (needs glibc >= 2.38 -> trixie).

# Stage 1: static libJSBSim from source (cached while the version holds).
FROM docker.io/library/debian:trixie-slim AS jsbsim
RUN apt-get update && apt-get install -y --no-install-recommends \
        g++ cmake make git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN git clone --depth 1 https://github.com/JSBSim-Team/jsbsim.git
WORKDIR /build/jsbsim/build
RUN cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DBUILD_PYTHON_MODULE=OFF .. \
    && make -j"$(nproc)" && make install

# Stage 2: the sim (World + Pilot + gateway)
FROM docker.io/library/debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ libc6-dev \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=jsbsim /usr/local/include/JSBSim /usr/local/include/JSBSim
COPY --from=jsbsim /usr/local/lib/ /usr/local/lib/
WORKDIR /app
COPY common/ common/
# --- aircraft: JSBSim bridge (xpjsb) + iNav SITL + clock shim + models ---
COPY aircraft/terrain.c aircraft/terrain.h aircraft/sim_state.h aircraft/
COPY aircraft/xpjsb/ aircraft/xpjsb/
COPY aircraft/fdm/ aircraft/fdm/
COPY aircraft/bridge/ aircraft/bridge/
COPY aircraft/msp_bridge/fbclock.c aircraft/msp_bridge/
COPY aircraft/models/ models/
COPY aircraft/SITL.elf aircraft/eeprom.bin aircraft/run.sh ./
# --- flightbox hub (the CC gateway) + the WASM command center it serves ---
COPY flightbox/server.c flightbox/
COPY flightbox/web/ flightbox/web/
COPY flightbox/start.sh ./
RUN gcc -O2 -Wall -Icommon -Iaircraft -Iaircraft/xpjsb -c \
        aircraft/xpjsb/*.c aircraft/terrain.c aircraft/fdm/atmosphere.c aircraft/bridge/msp.c \
 && g++ -O2 -std=c++17 -Icommon -Iaircraft -I/usr/local/include/JSBSim -c \
        aircraft/fdm/jsbsim_adapter.cpp \
 && g++ -O2 ./*.o /usr/local/lib/libJSBSim.a -o /usr/local/bin/xpjsb -lm -lpthread \
 && gcc -O2 -fPIC -shared aircraft/msp_bridge/fbclock.c -o /usr/local/lib/libfbclock.so -ldl \
 && gcc -O2 -Wall -Icommon flightbox/server.c -o /usr/local/bin/fbserver -lm \
 && rm -f ./*.o && chmod +x /app/SITL.elf /app/run.sh /app/start.sh
EXPOSE 8080
# start.sh brings up iNav SITL + xpjsb (background) then the hub (foreground, connects iNav on loopback).
CMD ["/app/start.sh"]
