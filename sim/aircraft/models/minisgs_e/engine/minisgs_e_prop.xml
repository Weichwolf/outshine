<?xml version="1.0"?>
<!--
  minisgs_e propeller: fixed-pitch 2-blade folding tractor, 15 in dia.

  The non-dimensional C_THRUST / C_POWER(J) tables are taken VERBATIM from the shipped
  JSBSim reference engine/prop_generic2f.xml (a validated moderate-pitch 2-blade
  fixed-pitch curve; peak efficiency ~0.80 near J=0.6-0.75, thrust crossing zero at
  J~=1.04). No coefficient is invented. Ct/Cp are non-dimensional in advance ratio, so
  the same curve is physically valid at any diameter (thrust scales as rho*n^2*D^4,
  power as rho*n^3*D^5); only the scale parameters below are changed for a small glider:
    - diameter 76 -> 15 in   (a plausible 2.4 m self-launch folder)
    - gearratio 0.85 -> 1.0  (direct-drive outrunner)
    - ixx  1.8 -> 0.0003 slug*ft^2  (light carbon folder; hand-estimated ~1e-4 from
      two ~9 g blades at r_gyr~0.5R, rounded up for hub/spinner - only affects the
      sub-second spin-up transient, not steady flight)
  minpitch/maxpitch kept at the curve's design blade angle (23 deg @ 0.75R) so the
  metadata stays consistent with the borrowed aero.

  A moderate-pitch prop is appropriate here: a self-launch glider climbs out AT SPEED
  (~9 m/s), so cruise/climb efficiency matters more than static thrust. If a softer,
  higher-static-thrust low-pitch folder (e.g. 14x8) is later wanted, regenerate the
  Ct/Cp curve with Aero-Matic - do NOT just rescale J, which corrupts efficiency.
-->
<propeller name="minisgs_e_prop">
  <ixx> 0.0003 </ixx>
  <diameter unit="IN"> 15.0 </diameter>
  <numblades> 2 </numblades>
  <minpitch> 23 </minpitch>
  <maxpitch> 23 </maxpitch>
  <gearratio> 1.0 </gearratio>

  <table name="C_THRUST" type="internal">
    <tableData>
      0.0	0.0936
      0.1	0.0927
      0.2	0.0918
      0.3	0.0909
      0.4	0.0828
      0.5	0.0738
      0.6	0.063
      0.7	0.0495
      0.8	0.036
      0.9	0.0198
      1.0	0.0045
      1.04	-0.0009
    </tableData>
  </table>

  <table name="C_POWER" type="internal">
    <tableData>
      0.0	0.0594
      0.1	0.0585
      0.2	0.0576
      0.3	0.0558
      0.4	0.054
