# sgs126 (Froude n=0.20) NAV tuning. Probe (closed-loop ANGLE): level & controlled at thr 0.30 -> 23 m/s,
# roll <1 deg (well-damped, unlike the retired floaty minisgs). Throttle band around that operating point.
set nav_fw_cruise_thr = 1300
set nav_fw_min_thr = 1200
set nav_fw_max_thr = 1800
set nav_fw_climb_angle = 6
set nav_fw_dive_angle = 12
set nav_fw_bank_angle = 25
set nav_fw_control_smoothness = 5
set fw_reference_airspeed = 2300
