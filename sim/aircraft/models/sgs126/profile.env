# sgs126 — Schweizer SGS 1-26 sailplane at Froude scale n=0.20 (span 2.44 m, 1.6 kg) + emitted 300 W
# self-launch motor -> model motor-glider. Consistent vanilla aero (AR 10), cruise ~23 m/s (probe:
# level&controlled, roll <1 deg). Replaces the retired quirky-geometry minisgs.
CHANMAP=M01-01,S01-02,S02-03,S03-04
FBW=0
SPAWN_SPEED=20
FB_CRUISE=23
FB_STALL=12
FB_BANK=25
FB_VR=0
FB_HANDOFF=60
LOITER_ALT=110
LOITER_RADIUS=130
