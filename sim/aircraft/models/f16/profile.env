# f16 — General Dynamics F-16 at Froude scale n=0.167 (span 1.52 m, 36.6 kg) + scaled turbine.
# Fast model jet, cruise ~55 m/s. iNav is the FLCS (FBW override) — the airframe is relaxed-stability.
CHANMAP=M01-01,S01-02,S02-03,S03-04
FBW=1
SPAWN_SPEED=45
FB_CRUISE=55
FB_STALL=28
FB_BANK=35
FB_VR=0
FB_HANDOFF=80
LOITER_ALT=160
LOITER_RADIUS=250
AUXMAP=gear:4
