# ===== c172 CONTROL CONFIG (model plugin) — Cessna 172, Froude n=0.20 =====
# Channels (chanmap in profile.env): M01=motor, S01=aileron(roll), S02=elevator(pitch), S03=rudder(yaw)
# Surfaces: conventional 3-axis. Gear: FIXED (real C172) — no retract, gear-down is correct.
# Flaps: fcs/flap-cmd-norm exists in the FDM; CC-commandable via the bridge MSP_SERVO aux path (pending).
mmix 0 1.000 0.000 0.000 0.000
smix reset
smix 0 1 0 100 0 -1                  ; S1 <- roll
smix 1 2 1 100 0 -1                  ; S2 <- pitch
smix 2 3 2 100 0 -1                  ; S3 <- yaw
# ----- NAV tuning: probe (closed-loop ANGLE) level at thr 0.40 -> 19.5 m/s, stall ~10 -----
set nav_fw_cruise_thr = 1400
set nav_fw_min_thr = 1250
set nav_fw_max_thr = 1900
set nav_fw_climb_angle = 8
set nav_fw_dive_angle = 12
set nav_fw_bank_angle = 30
set nav_fw_control_smoothness = 4
set nav_fw_loiter_radius = 14000     ; 140 m orbit
set nav_rth_altitude = 8000          ; 80 m RTH climb
set fw_reference_airspeed = 1950
aux 4 35 4 900 2100   ; TURN ASSIST -> coordinated turns
