# ===== sgs233 CONTROL CONFIG — Schweizer SGS 2-33 motor-glider, Froude n=0.20 =====
# Floaty glider. The c172-like NAV band makes it rotate + climb; a capped auto climb rate stops the
# zoom-stall (it would otherwise climb near-vertical off a close/high WP and depart). Vanilla aero.
mmix 0 1.000 0.000 0.000 0.000
smix reset
smix 0 1 0 100 0 -1
smix 1 2 1 100 0 -1
smix 2 3 2 35 0 -1
set nav_fw_cruise_thr = 1550
set nav_fw_min_thr = 1450
set nav_fw_max_thr = 1900
set nav_fw_climb_angle = 8
set nav_fw_dive_angle = 12
set nav_fw_bank_angle = 22
set nav_fw_control_smoothness = 5
set nav_fw_auto_climb_rate = 200
set nav_fw_loiter_radius = 13000
set nav_rth_altitude = 9000
set fw_reference_airspeed = 1700
# ----- NAV LAUNCH: iNav's dedicated wings-level climb-out. Triggers on the spawn forward motion, holds a
# controlled climb to 80 m ignoring WP-chasing, THEN hands to NAV WP — the clean takeoff a floaty glider
# needs (manual RC establish either skimmed or flipped it at the spawn transition).
set nav_fw_launch_velocity = 250
set nav_fw_launch_accel = 1200
set nav_fw_launch_max_angle = 45
set nav_fw_launch_detect_time = 40
set nav_fw_launch_climb_angle = 14
set nav_fw_launch_max_altitude = 8000
set nav_fw_launch_min_time = 1000
set nav_fw_launch_timeout = 20000
set nav_fw_launch_motor_delay = 0
set nav_fw_launch_spinup_time = 100
# ----- gentle inner-loop gains: iNav's default PID over-drives the floaty glider into FDM divergence
# (probe4 flies it with a soft P-controller). Low P/FF = gentle surface commands, no divergence.
set fw_p_pitch = 4
set fw_i_pitch = 5
set fw_d_pitch = 0
set fw_ff_pitch = 20
set fw_p_roll = 4
set fw_i_roll = 5
set fw_ff_roll = 20
set fw_p_yaw = 5
