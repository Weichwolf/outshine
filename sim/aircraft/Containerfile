# Aircraft container: real iNav SITL firmware + FDM bridge (xp_bridge).
# FDM = custom selig (default) ODER JSBSim (FDM_ENGINE=jsbsim, Migrationspaket D).
# Build context = sim/. Ships the prebuilt SITL.elf (needs glibc >= 2.38 -> trixie).

# Stage 1: libJSBSim statisch aus Quelle (gecacht, solange die Version steht).
FROM docker.io/library/debian:trixie-slim AS jsbsim
RUN apt-get update && apt-get install -y --no-install-recommends \
        g++ cmake make git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
# TODO(D): auf ein Release-Tag pinnen; master = dieselbe Quelle wie unsere Aircraft-Plugins.
RUN git clone --depth 1 https://github.com/JSBSim-Team/jsbsim.git
WORKDIR /build/jsbsim/build
RUN cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DBUILD_PYTHON_MODULE=OFF .. \
    && make -j"$(nproc)" && make install

# Stage 2: aircraft
FROM docker.io/library/debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ libc6-dev \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=jsbsim /usr/local/include/JSBSim /usr/local/include/JSBSim
COPY --from=jsbsim /usr/local/lib/ /usr/local/lib/
WORKDIR /app
COPY common/ common/
COPY aircraft/xp_bridge.c aircraft/terrain.c aircraft/terrain.h aircraft/sim_state.h aircraft/
# Sub-modules split out of the xp_bridge god-file. fdm/*.c is C; the .cpp (jsbsim_adapter, probes)
# is compiled separately with g++ below and is NOT caught by the *.c glob.
COPY aircraft/fdm/ aircraft/fdm/
COPY aircraft/bridge/ aircraft/bridge/
COPY aircraft/models/ models/
COPY aircraft/SITL.elf aircraft/eeprom.bin aircraft/run.sh ./
# C bridge (gcc) + C++ JSBSim adapter (g++), linked with g++ against static libJSBSim.
RUN gcc -O2 -Wall -Icommon -Iaircraft -c \
        aircraft/xp_bridge.c aircraft/terrain.c aircraft/fdm/*.c aircraft/bridge/*.c \
 && g++ -O2 -std=c++17 -Icommon -Iaircraft -I/usr/local/include/JSBSim -c \
        aircraft/fdm/jsbsim_adapter.cpp \
 && g++ -O2 ./*.o /usr/local/lib/libJSBSim.a -o /usr/local/bin/xp_bridge -lm -lpthread \
 && rm -f ./*.o && chmod +x /app/SITL.elf /app/run.sh
# FLIGHTBOX_ADDR + FDM_MODEL (selig) / FDM_ENGINE=jsbsim + AIRCRAFT set at run time
CMD ["/app/run.sh"]
