# Aircraft container: real iNav SITL firmware + FDM bridge (xp_bridge).
# FDM = custom selig (default) ODER JSBSim (FDM_ENGINE=jsbsim, Migrationspaket D).
# Build context = sim/. Ships the prebuilt SITL.elf (needs glibc >= 2.38 -> trixie).

# Stage 1: static libJSBSim from the PINNED submodule (sim/jsbsim @ v1.3.1) — not a fresh clone.
FROM docker.io/library/debian:trixie-slim AS jsbsim
RUN apt-get update && apt-get install -y --no-install-recommends g++ cmake make \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build/jsbsim
COPY jsbsim/ .
RUN mkdir -p build && cd build \
    && cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DBUILD_PYTHON_MODULE=OFF .. \
    && make -j"$(nproc)" && make install

# Stage 2: aircraft
FROM docker.io/library/debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ libc6-dev \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=jsbsim /usr/local/include/JSBSim /usr/local/include/JSBSim
COPY --from=jsbsim /usr/local/lib/ /usr/local/lib/
WORKDIR /app
COPY common/ common/
COPY aircraft/terrain.c aircraft/terrain.h aircraft/sim_state.h aircraft/
# xpjsb = clean XP-JSBSim bridge (world/xplink/sensors/actuators/flightlog/main + constants.h).
COPY aircraft/xpjsb/ aircraft/xpjsb/
COPY aircraft/fdm/ aircraft/fdm/
COPY aircraft/bridge/ aircraft/bridge/
COPY aircraft/msp_bridge/fbclock.c aircraft/msp_bridge/
COPY aircraft/models/ models/
COPY aircraft/SITL.elf aircraft/eeprom.bin aircraft/run.sh ./
# C bridge (gcc) + C++ JSBSim adapter (g++), linked with g++ against static libJSBSim.
# libfbclock.so: LD_PRELOAD clock shim -> FB_TIME_SCALE runs the sim faster than real time without
# touching iNav (the sim math is deterministic; real time is a waste — see msp_bridge/fbclock.c).
RUN gcc -O2 -Wall -Icommon -Iaircraft -Iaircraft/xpjsb -c \
        aircraft/xpjsb/*.c aircraft/terrain.c aircraft/fdm/atmosphere.c aircraft/bridge/msp.c \
 && g++ -O2 -std=c++17 -Icommon -Iaircraft -I/usr/local/include/JSBSim -c \
        aircraft/fdm/jsbsim_adapter.cpp \
 && g++ -O2 ./*.o /usr/local/lib/libJSBSim.a -o /usr/local/bin/xpjsb -lm -lpthread \
 && gcc -O2 -fPIC -shared aircraft/msp_bridge/fbclock.c -o /usr/local/lib/libfbclock.so -ldl \
 && rm -f ./*.o && chmod +x /app/SITL.elf /app/run.sh
# FLIGHTBOX_ADDR + FDM_MODEL (selig) / FDM_ENGINE=jsbsim + AIRCRAFT set at run time
CMD ["/app/run.sh"]
