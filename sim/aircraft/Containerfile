# Aircraft container: real iNav SITL firmware + X-Plane FDM bridge (xp_bridge).
# Build context = sim/. Ships the prebuilt SITL.elf (needs glibc >= 2.38 -> trixie).
FROM docker.io/library/debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY common/ common/
COPY aircraft/xp_bridge.c aircraft/terrain.c aircraft/terrain.h aircraft/
COPY aircraft/SITL.elf aircraft/eeprom.bin aircraft/run.sh ./
RUN gcc -O2 -Wall -Icommon -Iaircraft aircraft/xp_bridge.c aircraft/terrain.c -o /usr/local/bin/xp_bridge -lm -lpthread \
    && chmod +x /app/SITL.elf /app/run.sh
# FLIGHTBOX_ADDR + FDM_MODEL set at run time
CMD ["/app/run.sh"]
