# Aircraft simulator container. Build context = sim/
FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY common/ common/
COPY aircraft/aircraft.c aircraft/
RUN gcc -O2 -Wall -Icommon aircraft/aircraft.c -o /usr/local/bin/aircraft -lm
# FLIGHTBOX_ADDR is set at run time (podman network alias of the flightbox)
CMD ["aircraft"]
