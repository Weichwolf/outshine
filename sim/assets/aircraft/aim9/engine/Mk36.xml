<?xml version="1.0"?>
<!-- FlightBox — AIM-9M single-mode solid rocket motor (Mk 36 class).

     A SINGLE mode, not boost-sustain: the Mk 36 is a short-burn grain and no source describes a sustain
     phase. Thrust [DERIVED] from the propellant load and the documented burn time —
       m_p = 49 lb [DERIVED, see aim9.xml], Isp 235 s [SET, the same reduced-smoke HTPB value the
       AIM-120 deck argues], burn ~5.2 s [T3]
       thrust = m_p * Isp / t = 49 * 235 / 5.2 = 2,214 lbf; the table carries 2,222 lbf, which is the
       9,885 N the fire-control catalogue (core/FBStore.h) integrates, so the round and the computer
       that predicts it start from the same motor.
     JSBSim's contract: the table is indexed by PROPELLANT BURNED (lb) and yields VACUUM thrust (lbf);
     the engine consumes wdot = thrust/Isp itself, so burn TIME is an outcome and never a number stated
     here. Ignition is throttle == 1.0 and the motor then burns to depletion — a solid motor cannot be
     shut down, which is the property the guidance has to fly with.
-->
<rocket_engine name="AIM-9M Mk 36 motor (FlightBox)">

  <isp> 235 </isp>

  <!-- Ignition transient, [SET] 60 ms: the order a solid motor's chamber takes to come up to pressure.
       It exists so the first integration step is not a step input into the airframe's rotational ODE. -->
  <builduptime> 0.06 </builduptime>

  <thrust_table name="propulsion/thrust_prop_remain" type="internal">
    <tableData><!--
      propellant burned (lb)   vacuum thrust (lbf) -->
       0.00    2222.0
      48.80    2222.0
      49.00       0.0
    </tableData>
  </thrust_table>

</rocket_engine>
