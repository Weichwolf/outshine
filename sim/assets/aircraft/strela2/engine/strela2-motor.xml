<?xml version="1.0"?>
<!-- FlightBox — 9M32M solid rocket motor, generated by the shared surface-to-air recipe.

     THE SPLIT IS [SET]: a shoulder-launched round: eject charge, then one solid grain to burnout. Modelled as ONE mode, because the eject/ignition sequence is not quantified in the read sources.
       propellant   m_p = m0*(1 - 1/exp(dV/ve)) = 9.8*(1 - 1/exp(500/2305)) = 1.9 kg
                        = 4.2 lb   [DERIVED, the tree's shared Isp 235 s -> ve = 2305 m/s]
       dV IS THE WHOLE TERMINAL SPEED, not a delta over a launch speed: this round leaves a RAIL at
       zero airspeed, which is the one place the surface recipe differs from the air-launched one.
       total impulse = 1.9 * 2305 = 4405 N*s
       boost   2202 N (495 lbf) x 2.0 s
     Thrust-to-weight at ignition = 22.9 [DERIVED] — the number that decides whether a round
     launched from standstill leaves the rail at all.
     JSBSim's contract: the table is indexed by PROPELLANT BURNED (lb) and yields VACUUM thrust (lbf);
     the engine consumes wdot = thrust/Isp itself, so burn TIME is an outcome and never stated here.
-->
<rocket_engine name="9M32M motor (FlightBox)">

  <isp> 235 </isp>

  <!-- Ignition transient, [SET] 60 ms, as every other FlightBox motor. -->
  <builduptime> 0.06 </builduptime>

  <thrust_table name="propulsion/thrust_prop_remain" type="internal">
    <tableData><!--
      propellant burned (lb)   vacuum thrust (lbf) -->
       0.00      495.1
      4.16      495.1
      4.21        0.0
    </tableData>
  </thrust_table>

</rocket_engine>
