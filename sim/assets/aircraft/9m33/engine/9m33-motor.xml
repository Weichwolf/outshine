<?xml version="1.0"?>
<!-- FlightBox — 9M33 solid rocket motor, generated by the shared surface-to-air recipe.

     THE SPLIT IS [SET]: a single-stage round with a short boost and a long sustain.
       propellant   m_p = m0*(1 - 1/exp(dV/ve)) = 126.0*(1 - 1/exp(856/2305)) = 39.1 kg
                        = 86.2 lb   [DERIVED, the tree's shared Isp 235 s -> ve = 2305 m/s]
       dV IS THE WHOLE TERMINAL SPEED, not a delta over a launch speed: this round leaves a RAIL at
       zero airspeed, which is the one place the surface recipe differs from the air-launched one.
       total impulse = 39.1 * 2305 = 90094 N*s
       boost   27028 N (6076 lbf) x 2.0 s
       sustain 2772 N (623 lbf) x 13.0 s, 40 % of the impulse
     Thrust-to-weight at ignition = 21.9 [DERIVED] — the number that decides whether a round
     launched from standstill leaves the rail at all.
     JSBSim's contract: the table is indexed by PROPELLANT BURNED (lb) and yields VACUUM thrust (lbf);
     the engine consumes wdot = thrust/Isp itself, so burn TIME is an outcome and never stated here.
-->
<rocket_engine name="9M33 motor (FlightBox)">

  <isp> 235 </isp>

  <!-- Ignition transient, [SET] 60 ms, as every other FlightBox motor. -->
  <builduptime> 0.06 </builduptime>

  <thrust_table name="propulsion/thrust_prop_remain" type="internal">
    <tableData><!--
      propellant burned (lb)   vacuum thrust (lbf) -->
       0.00     6076.2
     51.50     6076.2
     51.70      623.2
     85.97      623.2
     86.17        0.0
    </tableData>
  </thrust_table>

</rocket_engine>
