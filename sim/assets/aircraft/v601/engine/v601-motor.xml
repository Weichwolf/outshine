<?xml version="1.0"?>
<!-- FlightBox — V-601 (5V27) solid rocket motor, generated by the shared surface-to-air recipe.

     THE SPLIT IS [SET]: a two-stage round, lighter and shorter-burning than the V-750.
       propellant   m_p = m0*(1 - 1/exp(dV/ve)) = 953.0*(1 - 1/exp(959/2305)) = 324.4 kg
                        = 715.1 lb   [DERIVED, the tree's shared Isp 235 s -> ve = 2305 m/s]
       dV IS THE WHOLE TERMINAL SPEED, not a delta over a launch speed: this round leaves a RAIL at
       zero airspeed, which is the one place the surface recipe differs from the air-launched one.
       total impulse = 324.4 * 2305 = 747644 N*s
       boost   179435 N (40338 lbf) x 2.5 s
       sustain 16614 N (3735 lbf) x 18.0 s, 40 % of the impulse
     Thrust-to-weight at ignition = 19.2 [DERIVED] — the number that decides whether a round
     launched from standstill leaves the rail at all.
     JSBSim's contract: the table is indexed by PROPELLANT BURNED (lb) and yields VACUUM thrust (lbf);
     the engine consumes wdot = thrust/Isp itself, so burn TIME is an outcome and never stated here.
-->
<rocket_engine name="V-601 (5V27) motor (FlightBox)">

  <isp> 235 </isp>

  <!-- Ignition transient, [SET] 60 ms, as every other FlightBox motor. -->
  <builduptime> 0.06 </builduptime>

  <thrust_table name="propulsion/thrust_prop_remain" type="internal">
    <tableData><!--
      propellant burned (lb)   vacuum thrust (lbf) -->
       0.00    40338.5
    428.85    40338.5
    429.05     3735.0
    714.89     3735.0
    715.09        0.0
    </tableData>
  </thrust_table>

</rocket_engine>
