<?xml version="1.0"?>
<!--
  FlightBox — Klimov RD-33, a FlightBox-OWN JSBSim turbine deck. Two instances of THIS file are the
  MiG-29 9-12's propulsion; nothing here is per-nacelle, the placement lives in mig29.xml.

  PROVENANCE per number (doc/mig29/flight-model-spec.md §0 tags):
    [T3]       established literature (Klimov/MMP Chernyshev data, Jane's-derived compendia)
    [DCS-FM]   DCS MIG-29 Flight Manual, printed page
    [ANALOGY]  taken from a DIFFERENT engine's public deck, declared as such
    [DERIVED]  computed here from a tagged figure by the stated formula
    [SET]      a FlightBox setting; no public figure exists, the reasoning is stated

  THE ONE THING TO UNDERSTAND ABOUT THIS FILE (spec §5.4). No public RD-33 thrust deck exists. The
  STATICS below are documented and agreed by two independent sources; the (Mach, density-altitude)
  SURFACES are borrowed wholesale from the F100-PW-229 deck that ships with the pinned JSBSim F-16
  (both are two-spool augmented turbofans of the same generation, BPR 0.36 vs 0.48) and are
  DIMENSIONLESS FACTORS normalised to 1.0 at M0/sea level — so borrowing the shape and setting
  milthrust/maxthrust to the RD-33's own statics IS the "scale the borrowed surface" step, exactly and
  with no arithmetic in between.

  AND THE RULE THAT GOES WITH IT: this deck is now FROZEN. The envelope anchors of spec §8 constrain
  the PRODUCT T(M,h)/D(M,h), never T and D separately, so fitting both against the same anchors is
  under-determined. All residual error is absorbed by the drag polar in mig29.xml. If that ever forces
  an implausible CD0, the THRUST analogy is the suspect — and that failure mode is only diagnosable
  because the rule was written down before the fitting started.
-->

<turbine_engine name="RD-33">
  <!-- Static thrust, sea level, M 0. [DCS-FM p.14] gives 8,300 kgf max / 5,040 kgf military; [T3]
       independently gives 81.4 kN / 49.4 kN. The two agree to 0.1 %, which is why these two numbers
       are the most trustworthy in the whole model.
         max: 8,300 kgf * 2.20462 lb/kgf = 18,298 lbf [DERIVED]
         mil: 5,040 kgf * 2.20462 lb/kgf = 11,111 lbf [DERIVED] -->
  <milthrust>   11111.0 </milthrust>
  <maxthrust>   18298.0 </maxthrust>

  <!-- [T3] 0.47 / 0.48 / 0.49 across three sources; 0.48 is the middle. In JSBSim this feeds ONLY the
       spool time constant (FGTurbine: delay = factor * 90/(BPR+3)), not the thrust. -->
  <bypassratio>     0.48 </bypassratio>

  <!-- [T3] 0.77 and 2.05 kg/(kgf*h). kg/(kgf*h) and lbm/(lbf*h) are NUMERICALLY IDENTICAL (both are
       mass-per-force-per-hour in a consistent gravitational system), so these go into JSBSim with no
       conversion. Spec §5.1 flags the "7.5 / 20.1 kg/(kN*h)" figures in circulation as a factor-of-10
       slip; the correct kN form of 0.77 kg/(kgf*h) is 78.5 kg/(kN*h). -->
  <tsfc>            0.77 </tsfc>
  <atsfc>           2.05 </atsfc>

  <!-- Idle spool speeds [SET]. No source states them. They are chosen so the DOCUMENTED part-power
       anchors are self-consistent: [DCS-EA p.76] taxi at 72-75 % RPM, [DCS-EA p.75] the aircraft stays
       on the brakes at 80 % RPM, [DCS-EA p.78] hold 90 % before brake release. Numbers in the 70s that
       describe "comfortable taxi" only make sense on a gauge whose idle sits in the 60s; an F100-style
       idle of 53 % would put a 15 t aircraft at taxi thrust already at 72 %.
       Consequence, and it is checkable: at N2 = 80 % JSBSim's law gives
         N2norm = (80-65)/(100-65) = 0.4286, thrust = idle + 0.4286^2 * (mil - idle) ~ 2,490 lbf/engine
       = 22 kN for the pair, against a brake force of ~108 kN at 15.3 t with mu 0.8 — the aircraft holds,
       as documented. -->
  <idlen1>         45.0 </idlen1>
  <idlen2>         65.0 </idlen2>
  <maxn1>         100.0 </maxn1>
  <maxn2>         100.0 </maxn2>

  <!-- augmethod 2 = CONTINUOUS afterburner (thrust blends linearly between dry and full as the
       throttle passes 1.0), the same choice the pinned F-16 deck makes. The RD-33's AB is indeed
       modulated, not a two-position switch. -->
  <augmented>         1 </augmented>
  <augmethod>         2 </augmethod>
  <injected>          0 </injected>

  <!-- ================================================================================================
       THE THREE THRUST SURFACES. Rows = Mach, columns = atmosphere/density-altitude in ft.

       [ANALOGY] every interior number is the F100-PW-229 factor from sim/assets/aircraft/f16/engine/
       F100-PW-229.xml, unchanged. THEY ARE NOT RD-33 DATA and must never be quoted as such.

       TWO DELIBERATE DEPARTURES from the borrowed deck, both required by spec §5.4 step 5:

       1. The F100 deck's 60,000 ft column is EXACTLY ZERO across every row. doc/f16/flight-model.md
          §12.3 calls that "a wall, not a decay" — the F-16 model has no ceiling, it has an edge. A
          service-ceiling anchor (18,000 m = 59,055 ft) sits right on that wall and could never be
          approached asymptotically. So the zero column is replaced and one more is appended:
            60k column = 50k column * 0.619   [DERIVED]
            70k column = 60k column * 0.559   [DERIVED]
          The factors are ISA DENSITY RATIOS, not invented: rho(60kft)/rho(50kft) = 0.1153/0.1864 =
          0.619 and rho(70kft)/rho(60kft) = 0.0645/0.1153 = 0.559 (isothermal layer,
          rho = rho_11km * exp(-(h-11km)/6339 m)). The check that this is the right continuation: the
          borrowed deck's OWN 40k->50k ratio is 0.2410/0.1490 -> 0.618, i.e. the surface was already
          decaying with density and the appended columns simply do not stop.
       2. Nothing else. The Mach extent, the row spacing and every interior value are the borrowed
          ones, because changing them would silently break the "frozen analogy" rule above.

       JSBSim CLAMPS rather than extrapolates, so above M 1.4 the dry surface freezes at its M-1.4 value
       and above M 2.6 the augmented one freezes at its M-2.6 value. For this airframe that is harmless:
       Vmax is M 2.3.
       ================================================================================================ -->

  <function name="IdleThrust">
   <table>
    <independentVar lookup="row">velocities/mach</independentVar>
    <independentVar lookup="column">atmosphere/density-altitude</independentVar>
    <tableData>
         -10000       0   10000   20000   30000   40000   50000   60000   70000
     0.0  0.0430  0.0488  0.0528  0.0694  0.0899  0.1183  0.1467  0.0908  0.0508
     0.2  0.0500  0.0501  0.0335  0.0544  0.0797  0.1049  0.1342  0.0831  0.0464
     0.4  0.0040  0.0047  0.0020  0.0272  0.0595  0.0891  0.1203  0.0745  0.0416
     0.6 -0.0804 -0.0804 -0.0560 -0.0237  0.0276  0.0718  0.1073  0.0664  0.0371
     0.8 -0.2129 -0.2129 -0.1498 -0.1025  0.0474  0.0868  0.0900  0.0557  0.0311
     1.0 -0.2839 -0.2839 -0.1104 -0.0469 -0.0270  0.0552  0.0800  0.0495  0.0277
    </tableData>
   </table>
  </function>

