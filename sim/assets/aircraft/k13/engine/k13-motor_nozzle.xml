<?xml version="1.0"?>
<!-- FlightBox — the K-13 (R-13M)'s nozzle. JSBSim subtracts ambient pressure * exit area from the vacuum
     thrust (FGNozzle::Calculate), which is what makes a solid motor weaker at sea level than at
     altitude. area 0.0729 FT2 [DERIVED] = 53.5 % of this round's 0.1364 ft^2 body
     cross-section, the same proportion the AIM-120 nozzle occupies. The exit diameter is [SET].
-->
<nozzle name="K-13 (R-13M) nozzle (FlightBox)">
  <area unit="FT2"> 0.0729 </area>
</nozzle>
