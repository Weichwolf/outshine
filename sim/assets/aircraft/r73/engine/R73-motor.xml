<?xml version="1.0"?>
<!-- FlightBox — R-73 single-mode solid rocket motor.

     SINGLE-MODE is documented ([DCS-FM p.72] "single-mode solid propellant"); the burn TIME is not
     ([GAP], class bound 2-15 s), so it is [SET] at 6.0 s and the thrust follows:
       thrust = m_p * Isp / t = 64 lb * 235 s / 6.0 s = 2,507 lbf; the table carries 2,513 lbf, which is
       the 11,180 N the fire-control catalogue (core/FBStore.h) integrates — round and computer start
       from the same motor.
     JSBSim's contract: indexed by PROPELLANT BURNED (lb), yielding VACUUM thrust (lbf); the engine
     consumes wdot = thrust/Isp itself, so burn time is an outcome. Ignition is throttle == 1.0 and the
     motor burns to depletion.
     NOT modelled: the gas-generator that drives this round's thrust-vectoring vanes (see r73.xml).
-->
<rocket_engine name="R-73 motor (FlightBox)">

  <isp> 235 </isp>

  <!-- Ignition transient, [SET] 60 ms: the order a solid motor's chamber takes to come up to pressure.
       It exists so the first integration step is not a step input into the airframe's rotational ODE. -->
  <builduptime> 0.06 </builduptime>

  <thrust_table name="propulsion/thrust_prop_remain" type="internal">
    <tableData><!--
      propellant burned (lb)   vacuum thrust (lbf) -->
       0.00    2513.0
      63.80    2513.0
      64.00       0.0
    </tableData>
  </thrust_table>

</rocket_engine>
