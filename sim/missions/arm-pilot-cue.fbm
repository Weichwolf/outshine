name arm-pilot-cue-1
timeout 200

# THE PILOT TAKES THE SHOT, AND IT COSTS ONE GATE. doc/air-to-ground.md §7.
#
# `set attack_mode arm` is a third value on the switch that already selects the release cue, not a
# third phase: the run-in, the egress, the release-latency lead and the SMS-counter watch are the
# attack pass's, unchanged. What differs is WHICH INSTRUMENT supplies the cue — the warning receiver's
# BEARING instead of the fire control's countdown, because an anti-radiation shot has no range to count
# down and the pilot learns none.
#
# THE GATE, in full: the RWR block is readable, a threat of the declared `arm_class` is in it, and its
# bearing is inside the round's own seeker cone (40 deg half-angle). A shot taken further off the nose
# than that never acquires after separation, so the pilot does not take it.
#
# `set arm_class fire_control` is the coarse form of a threat table this tree has no data for:
# FBEmitterSignature carries no band letter, no PRF and no pulse width, so the filter is three values
# over FBEmitterKind and it is [SET] per mission. Here the weasel is told to shoot fire control and
# nothing else, and the SA-6's second antenna is what it locks.
#
# WHAT TO READ:
#   events.log      `pilot ATTACK_RELEASE mode=arm class=fire_control kind=surface-fire-control
#                   brgDeg=5.5 fovDeg=40` — a bearing and a cone, and NO range anywhere on the line
#   telemetry_weasel_agm88_1.csv  msl_range = -1 for the whole flight
#
# READING RULE: exit 0 = SUCCESS (the weasel survived) is not the measurement. The MEASUREMENT is the
# `pilot ATTACK_RELEASE mode=arm` line and `UNIT_RESULT unit=sam result=DESTROYED`.

runway 46.84335 6.91523 441.0 228.0 2889

unit weasel
  module f16
  team friendly
  spawn 46.63000 6.90000 4000 0.0 450
  set gear up
  set fuel_pct 60
  set fcr_mode off
  set rwr on
  set store 3 agm88
  set arm_class fire_control
  set brief_master_arm arm
  set task attack
  set attack_mode arm
  wp 46.99000 6.90000 4000 450
  objective survive

unit sam
  module sa6
  team hostile
  spawn 46.808955 6.922835 ground 0.0 0
  set emcon free
  set rounds 0
