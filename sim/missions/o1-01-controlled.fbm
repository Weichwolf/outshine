name o1-01-controlled-1
timeout 600

# CAMPAIGN O1, SORTIE 1 OF 10 - BEKAA VALLEY, 9 JUNE 1982, THE SYRIAN SIDE (Operation Mole Cricket 19).
# Spec, anchor and sources: doc/campaigns/o1-bekaa-1982.md. Format: doc/missions/campaign.md.
# THIS FILE IS THE CAMPAIGN'S BASELINE. Sorties 02, 03, 04, 06 and 07 are this file with exactly ONE
# line changed, and each of them names this file as its control.
#
# THE ARENA, and every coordinate in it is [SET]. The Bekaa runs NNE-SSW between the Lebanon and the
# Anti-Lebanon; FlightBox flies it as a parallel at 33.90 N because it has NO TERRAIN MASKING (gap C4),
# so the two ridges that are the valley's whole geography do not exist in this tree and a mission that
# pretended otherwise would be lying with coordinates. The campaign is flown with `--elev const`, i.e.
# on a 0 m datum: the real valley floor is ~900 m, so every altitude here is height above the DECLARED
# datum and not above the real Bekaa. Rayak is 33.85 N 35.99 E and Damascus/Mezzeh 33.48 N 36.22 E [T4];
# the SAM belt of this campaign stands at 36.20-36.40 E, i.e. the eastern group, between the two.
#
# THE SUBSTITUTION, AND ITS DIRECTION — this is the binding disclosure of doc/campaigns/o1-bekaa-1982.md
# and it is repeated in every file of this campaign because a reader who skips it will read the result
# backwards. The MiG-29 was NOT at Bekaa: it entered Soviet service in 1983, and on 9 June 1982 the
# Syrian side flew MiG-21, MiG-23 and Su-20 [T4]. Those aircraft had "only nose and tail alert radar
# systems and no side warnings or look-up and look-down systems" [T4]. FlightBox's MiG-29 has the SPO-15
# with eight azimuth channels, a look-down-capable N019 and an IRST. THE SUBSTITUTION THEREFORE MAKES THE
# DEFENDER STRONGER THAN HISTORY. A FlightBox Bekaa that still ends in a rout says something STRONGER
# than 1982 did; one that ends well for Red says NOTHING about 1982 and must not be read as if it did.
#
# THE GEOMETRY, head-on and asymmetric in altitude, and both halves are the anchor's own picture.
# Blue ingresses from the west at 9 000 m - the Israeli package, cued by an E-2C it does not need to
# carry here, entering HIGH. Red holds a forward CAP at 2 000 m, 106.3 km away and closing head-on at
# 463 m/s. That split is what makes the controller's call about ELEVATION: the target sits +8.0 deg over
# the MiG at 50 km and +13.1 deg at 30 km, and the N019's RAD bar is +-6.0 deg [SET, radar-sensors.md],
# so an antenna nobody aimed looks UNDER the raid. It is the anchor's "no look-up systems" restated in
# the one currency this tree has.
#
# WHY RED NEVER FLIES OVER ITS OWN BELT, AND IT IS A GAP AND NOT A CHOICE. A FlightBox SAM site has no
# IFF interrogator (`modules/ground/FBSiteModule`: "a battery has no IFF interrogator in this tree") and
# a radar contact carries no identity by construction, so a battery engages the nearest firm track in its
# envelope WHOEVER IT BELONGS TO. Measured on this campaign's own first layout: with the Syrian CAP at
# 8 000 m over the belt, `swsa2` put three V-750 into its own fighters inside 7 s. Every mission of O1 is
# therefore laid out so that no Red aircraft is ever inside a friendly envelope — which DELETES the
# anchor's own Syrian tactic ("do what they can, then run back for cover" inside the protective missile
# envelope [T4]). That is stated here rather than hidden in a gap table: the campaign cannot fly the one
# thing the Syrians actually did.
#
# THE BELT IS IN EVERY MISSION (campaign contract rule: ground targets throughout) and it is REAL, not
# scenery: five positions on one radio net with a P-18 as the control node, `wcs free` transmitted and
# `autonomy hold` declared for every fire unit — the doctrine of a force whose batteries wait for orders
# (doc/air-defence-network.md section 5). In the fighter sorties 01-07 the belt fires NOTHING, and that
# is a measurement rather than an omission: the Syrian CAP is committed FORWARD of its own umbrella, so
# the fighters' fight happens 60-100 km west of the westernmost battery and the belt is what both sides
# are fighting ABOUT rather than what either side is fighting IN.
#
# THE ONE TACTICAL QUESTION: with the architecture intact - a controller who calls, a radar that
# radiates, a warning receiver that hears, a belt on its net behind - what happens? Everything else in
# O1 is a delta on this run, so the number that matters here is not the verdict but the CHAIN: gci BRAA
# -> ENTER_ELEV -> ENTER_ZONE -> RADAR_ILLUM -> radar RADAR_CONTACT -> sms RELEASE, with its seconds.
#
# WHY THE RADAR IS `illum` FROM t=0 AND NOT `off` UNTIL COMMIT. The spec's mission 1 asks for EMCON
# until commit. It is not flown, and the reason is experimental rather than doctrinal: on this module
# the THIRD GCI entry IS the radar's on-switch (modules/mig29/FBMig29Pilot.cpp), so a file that deletes
# the GCI brief from an EMCON baseline would delete the controller AND the radar in one line, and a
# lever that also switches the sensor off measures nothing about control. With the radar already on,
# what the controller still owns is exactly the ANTENNA - the scan elevation and the ZONE third - and
# that is the quantity sorties 02 and 03 take away. The price is stated: O1 therefore says nothing
# about emission discipline, and `duel-emcon.fbm` remains the tree's only measurement of that.
#
# MEASURED (2026-07-29, `--elev const`, standalone AND as campaign step 1 - identical, per-mission
# fingerprint 47d0e7669202edcd): BOTH MiG-29 MISSION-KILLED, BLUE UNTOUCHED. Red's first radar contact
# at t = 99.1 s; Blue releases at t = 156.6 and 157.0 s, Red at t = 160.7 - 3.6 s later. The two
# AIM-120 arrive at 3.38 m and 3.14 m against a 10.0 m fuze, and both MiGs lose radar, fire control,
# stores, RWR, countermeasures and flight controls in one tick. The two R-27R never arrive. The belt
# fires NOTHING (`site LAUNCH` 0) - which is what "committed forward of its own umbrella" looks like as
# a number. The canonical defeat reproduces against a defender the substitution made STRONGER than
# history, which is the only direction in which this campaign's evidence runs.
#
# READING RULE: exit 3 (TIMEOUT) is the expected shape and is NOT the verdict - `kill team` needs every
# opponent down. Read, in this order: `eng_detect_s` and `eng_shot_s` on both MiGs (the controller's
# worth, in seconds), the `sms RELEASE` order, the DETONATION lines with their missM against the round's
# own fuze radius, and `site LAUNCH` (expected: zero - the belt is 60+ km behind the fight). exit 2
# (a physical K.O. of a healthy jet) would be a defect.

zone flak    33.90000 36.30000  9000    0  2500   # under the SAMs, above nothing
zone sa6belt 33.90000 36.30000 24000  100  7000   # the mobile layer
zone sa2belt 33.90000 36.30000 30000  450 25000   # the strategic layer

net iads
  control swp18                                # the node: a search set and a radio
  link radio 60000 mast 8                       # [SET] 8 m masts -> 23.3 km of horizon. RADIO, because
  period 4.0                                    # a buried cable is unjammable and the anchor's decisive
  hold 3                                        # mechanism was jamming the RADIO net
  wcs free                                      # what the node transmits
  member swp18
  member swsa6a autonomy hold
  member swsa6b autonomy hold
  member swsa2  autonomy hold
  member swsa3  autonomy hold

unit hunter1a
  team hostile
  flight syr1 1
  module mig29
  spawn 33.90000 35.75000 2000 270.0 450
  set gear up
  set fuel_pct 70
  set n019_mode rad                           # the wide non-locking search pattern
  set n019_range_nm 27                        # the set's own documented search reach
  set n019_emission illum                     # LOUD from t=0: see the header on why this is the baseline
  set rwr on
  set brief_sort left                         # the briefed contract; this jet has no cooperative channel
  set store 3 r27r                            # FIRING ORDER, not a pylon map (doc/duels.md D4)
  set store 4 r27r
  set store 5 r73
  set store 6 r73
  set store 1 r73
  set store 2 r73
  set cmds_mode man
  set cmds_program 1
  set cmds_chaff 30                           # BVP-30-26, 30/30
  set cmds_flare 30
  set brief_master_arm arm
  set task intercept
  set brief_gci 20 270 97 9
  set brief_gci 80 270 69 9
  set brief_gci 140 270 42 9
  set brief_gci 200 270 14 9
  wp 33.90000 34.90000 2000 450
  objective kill team friendly
  objective survive

unit hunter1b
  team hostile
  flight syr1 2
  module mig29
  spawn 33.91666 35.75000 2150 270.0 450
  set gear up
  set fuel_pct 70
  set n019_mode rad                           # the wide non-locking search pattern
  set n019_range_nm 27                        # the set's own documented search reach
  set n019_emission illum                     # LOUD from t=0: see the header on why this is the baseline
  set rwr on
  set brief_sort left                         # the briefed contract; this jet has no cooperative channel
  set store 3 r27r                            # FIRING ORDER, not a pylon map (doc/duels.md D4)
  set store 4 r27r
  set store 5 r73
  set store 6 r73
  set store 1 r73
  set store 2 r73
  set cmds_mode man
  set cmds_program 1
  set cmds_chaff 30                           # BVP-30-26, 30/30
  set cmds_flare 30
  set brief_master_arm arm
  set task intercept
  set brief_gci 20 270 97 9
  set brief_gci 80 270 69 9
  set brief_gci 140 270 42 9
  set brief_gci 200 270 14 9
  wp 33.90000 34.90000 2000 450
  objective kill team friendly
  objective survive

unit dagger1a
  team friendly
  flight isr1 1
  module f16
  spawn 33.90000 34.60000 9000 90.0 450
  set gear up
  set fuel_pct 70
  set datalink on                             # the cooperative half of the asymmetry
  set fcr_mode crm
  set fcr_range_nm 40
  set rwr on
  set store 1 aim120
  set store 2 aim120
  set store 3 aim120
  set store 4 aim120
  set store 6 aim9
  set store 7 aim9
  set cmds_mode man
  set cmds_program 1
  set cmds_chaff 60                           # ALE-47, 60/60 - twice the MiG's magazine
  set cmds_flare 60
  set brief_master_arm arm
  set task intercept
  wp 33.90000 36.35000 9000 450
  objective kill team hostile
  objective survive

unit dagger1b
  team friendly
  flight isr1 2
  module f16
  spawn 33.88334 34.60000 9150 90.0 450
  set gear up
  set fuel_pct 70
  set datalink on                             # the cooperative half of the asymmetry
  set fcr_mode crm
  set fcr_range_nm 40
  set rwr on
  set store 1 aim120
  set store 2 aim120
  set store 3 aim120
  set store 4 aim120
  set store 6 aim9
  set store 7 aim9
  set cmds_mode man
  set cmds_program 1
  set cmds_chaff 60                           # ALE-47, 60/60 - twice the MiG's magazine
  set cmds_flare 60
  set brief_master_arm arm
  set task intercept
  wp 33.90000 36.35000 9000 450
  objective kill team hostile
  objective survive

unit sentry1
  team friendly
  module ef111                                # the Boeing 707 ECM aircraft's stand-in: a catalogue row
  spawn 33.30000 34.90000 9000 90.0 480       # whose ONLY weapon is `jam_comm_m` (doc/modules/air)
  set drag_threat_s 0                         # ordered to hold the leg: the honest way to say "never runs"
  set jam_comm_m 0
  wp 33.30000 36.60000 9000 480                # three legs, so the leg it is on never runs out: a mover
  wp 33.60000 35.60000 9000 480                # that reaches its last waypoint enters an ORBIT and
  wp 33.30000 36.60000 9000 480                # drifts, and a drifting jammer un-jams (measured: the

unit swp18
  module p18                                  # P-18 "Spoon Rest D": the net's control node - the
  team hostile                                # LEADERSHIP the Israeli plan attacked, and it is killable
  spawn 33.90000 36.30000 ground 0.0 0
  set emcon free

unit swsa6a
  module sa6                                  # 2K12 Kub - the mobile layer, the type that made Bekaa
  team hostile
  spawn 33.94000 36.25000 ground 0.0 0
  set emcon hold                              # dark until something it RECEIVED says otherwise
  set rounds 3

unit swsa6b
  module sa6
  team hostile
  spawn 33.86000 36.35000 ground 0.0 0
  set emcon hold
  set rounds 3

unit swsa2
  module sa2                                  # S-75 - the strategic layer, 450-25 000 m
  team hostile
  spawn 33.90000 36.40000 ground 0.0 0
  set emcon hold
  set rounds 3

unit swsa3
  module sa3                                  # S-125 - the low/medium layer, 100-18 000 m
  team hostile
  spawn 33.90000 36.20000 ground 0.0 0
  set emcon hold
  set rounds 3

unit swhq
  module target_hard                          # the site command post - a hardened aim point [SET]
  team hostile
  spawn 33.90500 36.30500 ground 0.0 0
