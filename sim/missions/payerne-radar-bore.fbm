name payerne-radar-bore-1
timeout 300                                  # sim-seconds until TIMEOUT

# THE MODE PROOF, half two. Byte-for-byte payerne-radar-acm.fbm except for the name and ONE word:
# `set fcr_mode acm_bore` instead of `acm_hud`. Same two jets, same legs, same speeds, same altitudes —
# so every difference in the radar's telemetry is a difference in the SCAN VOLUME and nothing else.
#
# ACM HUD Scan is +/-15 deg wide and sweeps in 1.0 s; ACM Boresight is a +/-5 deg cone and revisits in
# 0.3 s (modules/f16/FBF16Fcr's mode table). The narrow cone therefore acquires LATER — the target has
# to come much closer to the nose before it is in the beam at all — even though it needs fewer seconds
# once it is. That ordering, not the absolute times, is what this pair measures.

unit viper
  module f16
  team friendly
  spawn 46.70000 6.80000 3000 90.0 300
  set gear up
  set fuel_pct 60
  set fcr_mode acm_bore                      # the ~10 deg boresight cone, auto-locking
  wp 46.70000 7.20000 3000 300               # one far waypoint = a straight 090 leg

unit bandit
  module f16
  team hostile
  spawn 46.63000 6.95000 3000 0.0 300
  set gear up
  set fuel_pct 60
  set fcr_mode off                           # a pure target: it is looked at, it does not look
  set iff_xpdr off                           # no Mode-4 reply to give -- the contact stays UNKNOWN
  wp 46.85000 6.95000 3000 300               # one far waypoint = a straight 360 leg
