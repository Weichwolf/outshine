name attack-late-1
timeout 200

# THE COUNTER-PROOF: attack-ccrp.fbm, to the digit, with ONE line changed — the pilot is told to pickle
# two seconds after the computed cue instead of on it (`set pilot_attack_bias_s`, systems/FBPilotTuning).
# Everything else is identical: same jet, same run-in, same altitude, same speed, same target, same
# integration, same interlocks. The only difference is the MOMENT.
#
# WHY IT HAS TO EXIST. A delivery computation that is never wrong proves nothing — a mission that drops
# a bomb roughly at a target and calls the resulting crater a hit would look exactly the same as one that
# computed anything at all. So the same computation is deliberately disobeyed by a declared amount, and
# the miss it produces is the measurement of what obeying it is worth: two seconds at ~231 m/s of
# groundspeed is ~460 m of extra throw, and 460 m is an order of magnitude outside the Mk-82's own
# fragment radius against this target (modules/ground/FBGroundTarget.h: 45 m to destroy, 69 m to hurt).
#
# THE EXPECTED OUTCOME IS THEREFORE A FAILED MISSION: the bunker is still standing when the clock runs
# out, `objective kill unit bunker` is unmet, and the run reports TIMEOUT (exit 3). That is the point —
# the verdict follows the physics, not the intent.
#
# Run it with `--elev const`, like its sibling.

unit viper
  module f16
  team friendly
  spawn 46.90000 6.80000  900 90.0 450
  set gear up
  set fuel_pct 60
  set datalink off
  set fcr_mode off
  set store 3 mk82
  set store 7 mk82
  set brief_master_arm arm
  set task attack
  set attack_mode ccrp
  set pilot_attack_bias_s 2.0                # THE ONE LINE: two seconds late on the pickle
  wp 46.90000 7.05000 900 450
  wp 46.95000 7.20000 3000 400
  objective kill unit bunker

unit bunker
  module target_soft
  team hostile
  spawn 46.90000 7.05000 ground 90.0 0
