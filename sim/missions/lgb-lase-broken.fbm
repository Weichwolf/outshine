name lgb-lase-broken-1
timeout 160

# ...AND WHAT HAPPENS WHEN THE SHOOTER BREAKS THE BINDING. doc/air-to-ground.md §3.2.
#
# ONE LINE differs from lgb-designate.fbm: `set brief_lase_s 10`. The crew stops designating ten
# seconds into the mission — 6.5 s into a 35 s fall — and never resumes.
#
# WHAT THE ROUND DOES IS NOT A FAILURE PATH: with no spot the canards TRAIL and the bomb falls
# BALLISTICALLY, which is the documented behaviour of the guidance kit. The ballistic error the kit was
# there to correct is therefore never corrected, and the MEASURED miss is 1 895 m against 3.9 m held —
# the difference between the two files IS the shooter's obligation.
#
# WHAT TO READ:
#   events.log      `missile SEEKER_ACTIVE ... mode="semi-active laser"`, then ONE `missile
#                   ILLUMINATION_LOST` at t = 10 and `missile PHASE ... to=INERTIAL why="no spot"`,
#                   then `stores DELIVERY ... aimErrM` in the thousands
#   UNIT_RESULT     bunker INTACT
#
# READING RULE: exit 0 is not the measurement. The MEASUREMENT is `aimErrM` against
# lgb-designate.fbm's, and `UNIT_RESULT unit=bunker result=INTACT`. The second of three.

unit viper
  module f16
  team friendly
  spawn 46.90000 6.98000 4000 90.0 250
  set gear up
  set fuel_pct 60
  set datalink off
  set fcr_mode off
  set store 3 gbu12
  set brief_master_arm arm
  set task route
  set attack_mode ccrp
  set brief_release_s 3
  set brief_lase_s 10                        # the crew stops lasing 6.5 s into a 35 s fall
  wp 46.90000 7.05000 4000 250
  wp 46.90000 7.30000 4000 250
  objective survive

unit bunker
  module target_soft
  team hostile
  spawn 46.90000 7.05000 ground 90.0 0
