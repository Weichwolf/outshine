name vis-night-1
timeout 200

# THE EYE, AT NIGHT -- vis-day.fbm with ONE line changed, and the answer is nothing.
#
# The geometry, the airframes, the speeds and the waypoints below are vis-day.fbm's verbatim; the only
# difference is the clock. At 23:00Z over the Broye on midsummer's night the sun stands at el -19.5,
# well past the -9 nautical-twilight floor of the shared daylight factor (core/FBEphemeris.h
# FBDaylightFactor -- the same ONE number the sky, the ground and the star fade use). The contrast term
# is multiplied by it, so it collapses to zero and the channel reports NOTHING, at any range, however
# large the target looks.
#
# THAT IS THE MODEL AND NOT A DEFECT, and doc/sensors.md §9.8 states its price up front: nothing in the
# tree EMITS light. There are no navigation lights, no anti-collision strobes, no afterburner plume as a
# visual cue and no city glow, so there is nothing for an eye to see by. Every night merge in the
# campaign tree (w5-09, w5-10, every O5 mission) is therefore flown without eyes -- a finding ABOUT
# those missions, which is exactly what this file exists to make checkable.
#
# WHAT TO READ:
#   events.log   ZERO `vis` lines. vis-day.fbm's identical geometry produces nine.
#   telemetry    vis_contacts = 0 for every row; blk_vis stays valid (the eyes are open, they see
#                nothing -- an empty picture, not NO picture)
#
# READING RULE: exit 3 = TIMEOUT is the verdict AND the pass, exactly as in vis-day.fbm.

time 2026-06-21T23:00:00Z

unit viper
  module f16
  team friendly
  spawn 46.60000 6.90000 3000 0.0 300          # due north, level, 300 kt -- the OBSERVER
  set gear up
  set fuel_pct 60
  set fcr_mode off                             # every contact in this trace was SEEN, not painted
  set rwr off
  wp 46.95932 6.90000 3000 300

unit closer
  module f16
  team friendly
  spawn 46.68983 6.90327 3000 180.0 300        # 10 km ahead, 250 m right, coming straight back: HEAD-ON
  set gear up
  set fuel_pct 60
  set fcr_mode off
  set rwr off
  wp 46.33051 6.90327 3000 300

unit crosser
  module f16
  team friendly
  spawn 46.68085 6.82671 3000 90.0 300         # 9 km ahead, 5.6 km left, crossing: SIDE-ON
  set gear up
  set fuel_pct 60
  set fcr_mode off
  set rwr off
  wp 46.68085 7.21378 3000 300

unit trail
  module f16
  team friendly
  spawn 46.62695 6.89673 3000 0.0 200          # 3 km ahead, same heading, 100 kt slower: a SLOW OVERTAKE
  set gear up
  set fuel_pct 60
  set fcr_mode off
  set rwr off
  wp 46.95932 6.89673 3000 200
