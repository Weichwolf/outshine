name mk82-safe-1
timeout 120

# THE REFUSED RELEASE: the same jet, the same loadout, the same pickle — and NO `set brief_master_arm`
# line. The master arm therefore stays where a jet powers up (SAFE, systems/FBStoresSystem's default),
# the SMS refuses the release at the hardware interlock, and events.log carries the refusal with its
# reason (RELEASE_REJECTED hardware_precedence "master arm not in ARM") plus the command bus's own
# receipt in the cmd_* telemetry channels. Nothing leaves the aircraft: the stores are still on it at
# the end of the run, which the sms_loaded/sms_lbs columns show for every tick of it.

unit viper
  module f16
  spawn 46.90000 6.90000 2500 90.0 450
  set gear up
  set fuel_pct 60
  set store 5 mk82
  set brief_release_s 20
  wp 46.90000 7.20000 2500 450
