  team hostile
  flight kn1 2
  module mig29
  spawn 44.94500 20.35000 6150 270.0 450
  set gear up
  set fuel_pct 60
  set n019_mode off
  set n019_range_nm 27
  set n019_emission illum
  set rwr on
