unit batnod
  module p18
  team hostile
  spawn 44.94000 20.24000 ground 0.0 0
  set emcon free

unit batsa3
  module sa3
  team hostile
  spawn 44.93000 20.16000 ground 0.0 0
  set emcon hold
  set rounds 4

unit batsa6
  module sa6
  team hostile
  spawn 44.95500 20.19000 ground 0.0 0
