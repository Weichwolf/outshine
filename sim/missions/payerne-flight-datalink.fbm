name payerne-flight-datalink-1
runway 46.84335 6.91523 441.0 228.0 2889     # Payerne RWY23 -- mission-wide off-runway-touchdown check
timeout 600                                  # sim-seconds until TIMEOUT

# THE SWITCH MATRIX: five friendly F-16s in an echelon that stays well inside datalink range for the
# whole run, so nothing about geometry can explain what each jet sees -- only its terminal's switches
# (systems/FBDatalinkSystem, modules/f16/FBF16Datalink, doc/modules/f16/datalink-iff.md). Three transmitters
# (LEAD, FOUR, FIVE) and the two special cases:
#
#   unit   power  XMT  filter   expected tracks (telemetry dl_tracks)
#   lead   on     on   FR ON    2  = four, five                (two/three are silent)
#   two    on     OFF  FR ON    3  = lead, four, five          -- XMT OFF still RECEIVES: the EMCON jet
#                                                                 sees MORE than the lead does, and is
#                                                                 itself on nobody's list
#   three  OFF    -    -        0                              -- power off = blind AND silent
#   four   on     on   FL ON    1  = lead only                 -- flight-lead filter: it hears five too
#                                                                 (five is 2 nm away and transmitting)
#                                                                 and still shows only the lead
#   five   on     on   FR ON    2  = lead, four
#
# LEAD's and FIVE's counts are the control: same switches, same picture. TWO minus LEAD is the EMCON
# proof, FOUR minus FIVE is the contact-filter proof, THREE is the power proof.

unit lead
  module f16
  team friendly
  spawn 46.73800 6.72200 3000 48.0 300
  set gear up
  set fuel_pct 60
  wp 46.84335 6.91523 3200 320
  wp 46.95000 7.05000 3400 320

unit two
  module f16
  team friendly
  spawn 46.72600 6.73900 2500 48.0 300
  set gear up
  set fuel_pct 60
  set datalink_xmt off                       # EMCON: receives the whole picture, radiates nothing
  wp 46.81000 6.95000 2700 300
  wp 46.90000 7.12000 2900 300

unit three
  module f16
  team friendly
  spawn 46.71400 6.75600 2000 48.0 300
  set gear up
  set fuel_pct 60
  set datalink off                           # terminal unpowered: no picture, no PPLI
  wp 46.78000 6.98000 2200 300
  wp 46.86000 7.16000 2400 300

unit four
  module f16
  team friendly
  spawn 46.70200 6.77300 1500 48.0 300
  set gear up
  set fuel_pct 60
  set datalink_filter fl                     # HSD FL ON: flight leads only
  wp 46.75000 7.01000 1700 300
  wp 46.82000 7.20000 1900 300

unit five
  module f16
  team friendly
  spawn 46.69000 6.79000 3500 48.0 300
  set gear up
  set fuel_pct 60
  wp 46.73000 7.04000 3700 300
  wp 46.79000 7.24000 3900 300
