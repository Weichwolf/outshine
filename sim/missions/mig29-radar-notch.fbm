name mig29-radar-notch-1
timeout 300

# THE N019's DOPPLER ENVELOPE, MEASURED AGAINST ITS OWN DOCUMENTED NUMBERS.
#
# doc/modules/mig29/radar-sensors.md §3.1 is the most valuable radar table in either MiG-29 manual,
# because it QUANTIFIES the notch instead of describing it:
#
#     range > 8.0 nm   -> closure/lag must exceed 81 kts
#     range < 8.0 nm   -> closure/lag must exceed 27 kts
#     range < 5.4 nm   -> "not guaranteed" below 32.4 kts head-on
#
# and DCS-FM p.37-38 adds the other half: on entering the notch the set applies INERTIAL TRACKING FOR
# UP TO 6 SECONDS before the file is lost. modules/mig29/FBMig29Radar turns both into behaviour
# (DopplerNotchMs + CoastS); this mission is where they are read back.
#
# WHICH QUANTITY. The thresholds are applied to the TARGET's radial velocity over the ground — the
# quantity a pulse-Doppler set actually discriminates against main-lobe clutter, and the one the same
# source explains the effect with ("targets at aspect near 90 deg are hard to detect ... small radial
# closure, small Doppler shift"). The derivation is written out in FBMig29Radar.h.
#
# THE GEOMETRY. fulcrum flies EAST, level, radar RAD/ILLUM, antenna on the horizon. bandit starts due
# east of it and flies three legs:
#   leg 1  WEST, head-on   -> its own radial velocity is its full ~450 kt: far outside any threshold
#   leg 2  NORTH, beaming  -> the velocity is perpendicular to the line of sight, radial ~0: INSIDE
#   leg 3  WEST again      -> back out of the filter
# Nothing else changes: same altitude, same speed, same antenna position, one aircraft turning.
#
# WHAT TO READ, from events.log and the two telemetry files rather than from this comment:
#   radar NOTCH_LOST   tgtRadialMs vs notchMs      -- the crossing, with both numbers on the line
#   radar RADAR_DROP   coastS                      -- must be 6.0 s after NOTCH_LOST (kInertialTrackS)
#   radar NOTCH_REGAIN                             -- leg 3, the target leaving the filter again
#   fcr_contacts                                   -- 1 while detected, 0 through the notch
#
# READING RULE: exit 3 = TIMEOUT is the verdict AND the pass. Neither aircraft has an objective it can
# complete inside the window; the mission is a measurement rig, not a task. exit 2 (CRASH) would be a
# failure: both legs are level at 8 000 m.

unit fulcrum
  module mig29
  team hostile
  spawn 46.90000 6.60000 8000 90.0 400        # level east, the observer
  set gear up
  set fuel_pct 60
  set n019_mode rad                           # the long-range search pattern, +-30 deg / +-6 deg
  set n019_emission illum                     # ILLUM: the set radiates (power-up default is OFF)
  set n019_elev 0                             # antenna on the horizon; both aircraft are co-altitude
  set rwr off                                 # not the subject; keeps the trace to one sensor
  wp 46.90000 7.60000 8000 400                # one long level leg east

unit bandit
  module f16
  team friendly
  spawn 46.90000 7.35000 8000 270.0 450       # ~33 nm east of fulcrum, head-on
  set gear up
  set fuel_pct 60
  set fcr_mode off                            # it radiates nothing: this run is about being SEEN
  set rwr off
  wp 46.90000 7.25000 8000 450                # leg 1: head-on, closing -- full radial velocity
  wp 46.94000 7.25000 8000 450                # leg 2: BEAM, well beyond 8 nm -> the 81 kt band
  wp 46.94000 7.05000 8000 450                # leg 3: west again -- out of the filter
  wp 46.90000 7.05000 8000 450                # leg 4: BEAM the other way, back onto the track
  wp 46.90000 6.97000 8000 450                # leg 5: head-on again, closing inside 8 nm
  wp 46.92000 6.97000 8000 450                # leg 6: BEAM at close range -> the 27 kt band
  wp 46.92000 6.70000 8000 450                # leg 7: west, out again

# THE SECOND TARGET, and it is here for one reason: the thresholds are RANGE-DEPENDENT, so proving the
# envelope needs a crossing on each side of the 8 nm step. bandit starts 33 nm out and does its beaming
# far away (81 kt band); pincer starts inside 8 nm and does the same manoeuvre there (27 kt band). Same
# code, same event, different `notchMs` on the line -- which is exactly the property being measured.
unit pincer
  module f16
  team friendly
  spawn 46.90000 6.90000 8000 270.0 250       # ~14 nm east of fulcrum, head-on, slow
  set gear up
  set fuel_pct 60
  set fcr_mode off
  set rwr off
  wp 46.90000 6.84000 8000 250                # head-on until the range is between 5.4 and 8 nm
  wp 46.92000 6.84000 8000 250                # BEAM there -> the 27 kt band
  wp 46.92000 6.81000 8000 250                # west, out again, closing further
  wp 46.90000 6.81000 8000 250                # BEAM inside 5.4 nm -> the 32.4 kt "not guaranteed" band
  wp 46.90000 6.60000 8000 250                # west, out again
