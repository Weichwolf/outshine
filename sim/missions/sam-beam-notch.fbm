name sam-beam-notch-1
timeout 260

# THE BEAM MANOEUVRE AGAINST A GROUND SET, and the point of the file is that NOT ONE LINE was written
# for it. doc/modules/ground/module.md §Knowledge 3.
#
# sensors/FBRadarSystem decides the Doppler notch on OWN quantities:
#     tgtRadialMs = OwnClosureOn(line of sight) - measuredClosureMs
# OwnClosureOn is the clutter Doppler — what a stationary point in that direction would close at. For a
# mount that does not move it is EXACTLY ZERO, so the test degenerates to the target's own range rate:
#     notch hit  <=>  |range rate| < DopplerNotchMs
# A target flying a circle around the position is in the notch by construction. That is correct
# pulse-Doppler behaviour, it is what makes chaff work at all, and it fell out of the N019 round's
# per-set hook without a ground-specific line.
#
# WHAT TO READ, in the site's events:
#   `radar CHAFF_SEDUCED ... ownClosMs=0 ...`   -- the zero IS the prediction; the measured closure is
#                                                  the target's own range rate and nothing else
#   `site BREAK reason="track lost"`             -- the engagement dies with the track
# and in telemetry_sam.csv: site_state falls back from 3/4 to 2, site_lock to 0.
#
# The geometry: the viper runs in from the south, is tracked, then turns hard east at ~19 km and holds a
# tangent — the range rate collapses and it dispenses chaff into a set that can no longer separate the
# two. The 2K12 is the ONE catalogue row with a Doppler notch (a CW illuminator is a Doppler device by
# construction); against an `sa2` the same manoeuvre does nothing at all, which is what G4 says.
#
# READING RULE: exit 3 = TIMEOUT is the verdict AND the pass. The measurement is the BREAK, not a
# survival — the viper leaves the envelope afterwards either way.

unit viper
  module f16
  team friendly
  spawn 46.40000 6.90000 3000 0.0 400
  set gear up
  set fuel_pct 60
  set fcr_mode off
  set rwr on
  set cmds_mode man
  set brief_chaff_s 30
  set brief_chaff_s 33
  set brief_chaff_s 36
  set brief_chaff_s 39
  set brief_chaff_s 42
  set brief_chaff_s 45
  wp 46.44000 6.90000 3000 400                 # 20 km out: still closing
  wp 46.44000 7.30000 3000 400                 # hard east — a tangent, range rate ~ 0
  wp 46.44000 7.60000 3000 400

unit sam
  module sa6
  team hostile
  spawn 46.62000 6.90000 ground 0.0 0
  set emcon free
  set rounds 3
