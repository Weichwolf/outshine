name payerne-full-1
module f16                                  # FBModuleRegistry key -> FBF16Module (doc/mission-format.md)
runway 46.84335 6.91523 441.0 228.0 2889   # Payerne threshold RWY23 -- also the LANDING runway below: the
                                             # return leg (wp3) already sits on RWY23's own extended final
                                             # (matches payerne-takeoff.fbm's return waypoint), and RWY05's
                                             # approach crosses the closer/higher Jura foothills southwest
                                             # of the field that straight-line Course guidance (no
                                             # terrain-following) would fly straight through -- RWY23 keeps
                                             # the whole mission over the lower Broye-valley terrain the
                                             # other Payerne missions already validate.
spawn threshold ground 228.0 0             # ground start, brakes set, runway heading (Phase 1)
wp 46.74293 6.75267 2500 350               # SW climb-out (matches payerne-takeoff-only.fbm)
wp 46.99968 6.83204 2800 320               # turn north over the Broye/Jura foothills, still climbing
wp 46.95467 7.09598 1450 280               # NE leg, descending onto RWY23's final approach course
land                                        # Approach -> Flare -> Rollout to a stop on RWY23
timeout 1200                                # sim-seconds until TIMEOUT
