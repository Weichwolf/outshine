name cbu87-footprint-1
timeout 160

# AN AREA, NOT A RADIUS — the one weapon in this tree that turns an aim error from a distance into a
# BINARY. doc/air-to-ground.md §3.3 and §Knowledge 3.
#
# The identical geometry and the identical three targets as mk84-radius.fbm, with one line changed:
# `set store 3 cbu87`. A canister is not a point source but an AREAL ENERGY DENSITY over a declared
# rectangle, and the currency is the one core/FBDamageModel already takes from the gun (J/m^2):
#
#   flux = 202 * (0.5 * 1.5 kg) * 0.5*(1800^2 + v^2) / (400 m * 200 m)  =  3.11e3 J/m^2   [measured]
#
# against `target_soft`'s untouched 2.8e3 failure threshold. So the CBU-87 kills a soft position
# ANYWHERE under its footprint and — at 8 % of the threshold — nothing at all to a `target_hard`.
#
# THE 12 % MARGIN IS THIS FILE'S HONEST HEADLINE and is booked as N3, not discovered here: two [SET]
# constants of the damage model (kCaseFraction, kFragSpeedMs) and one [DISPUTED] footprint decide
# whether that number lands above or below the threshold. Any future calibration of either re-derives
# this row first.
#
# THE BINARY: `near` (98 m along, 29 m across) and `far` (158 m along, 22 m across) are INSIDE the
# 400 x 200 m rectangle and die identically — the flux does not fall off with distance. `wide` is 150 m
# ACROSS, outside the 100 m half-width, and takes EXACTLY NOTHING. The Mk 84 in mk84-radius.fbm kills
# `near` and spares `far`; this store kills both and spares one the Mk 84 merely degrades.
#
# WHAT TO READ:
#   events.log      two `damage CLUSTER unit=... fluxJm2=3109 alongM=... acrossM=...` lines and no
#                   third one — `wide` produces no line because it is outside the rectangle
#   UNIT_RESULT     near DESTROYED, far DESTROYED, wide INTACT
#
# READING RULE: exit 0 is not the measurement. The MEASUREMENT is the three UNIT_RESULT lines against
# mk84-radius.fbm's, and the pass is DESTROYED / DESTROYED / INTACT.

unit viper
  module f16
  team friendly
  spawn 46.90000 6.80000  900 90.0 450
  set gear up
  set fuel_pct 60
  set datalink off
  set fcr_mode off
  set store 3 cbu87
  set brief_master_arm arm
  set task attack
  set attack_mode ccip
  wp 46.90000 7.05000 900 450
  wp 46.95000 7.20000 3000 400
  objective survive

unit near
  module target_soft
  team hostile
  spawn 46.900359 7.051629 ground 90.0 0     # 98 m along the track, 29 m across: inside
unit wide
  module target_soft
  team hostile
  spawn 46.901448 7.050340 ground 90.0 0     # 150 m ACROSS: outside the 100 m half-width
unit far
  module target_soft
  team hostile
  spawn 46.900300 7.052421 ground 90.0 0     # 158 m along, 22 m across: inside
