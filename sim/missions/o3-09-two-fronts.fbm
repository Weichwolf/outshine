  module sa3
  team hostile
  spawn 30.84000 32.31000 ground 0.0 0
  set emcon free
  set rounds 4

unit yxsa6
  module sa6
  team hostile
  spawn 30.80000 32.40000 ground 0.0 0
  set emcon free
  set rounds 3

# ---- THE ISRAELI CAP: four fighters, one picture, no way to divide it ----
unit yx9b1
  module f16
  team friendly
  flight cap 1
  spawn 30.86000 33.05000 5000 270.0 450
  set gear up
  set fuel_pct 70
  set fcr_mode crm
  set datalink on
  set rwr on
  set store 3 aim120
  set store 7 aim120
  set brief_master_arm arm
  set task intercept
  wp 30.86000 32.40000 5000 450
