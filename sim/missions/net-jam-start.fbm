name net-jam-start-1
timeout 320

# THE CONTROLLER NEVER THERE AT ALL — the OTHER of O1's two failure modes, and the control run of
# `net-jam-late.fbm`. doc/air-defence-network.md §6.
#
# The net is a RADIO link this time, not a cable: 21 km between two antennas on 8 m masts, which is
# 23.3 km of radio horizon by the 4/3-earth rule and therefore a link that works — and one that can be
# denied. The 2K12 is `emcon hold` and its fallback doctrine is `autonomy hold`: cut off from control,
# it waits for orders that never come.
#
# A second F-16 carries `set jam_comm_m 25000`. It is INAUDIBLE — it publishes no emitter signature at
# all, so nothing can bear on it and there is no home-on-jam — and it denies exactly one thing: the
# RECEIVER's link, on geometry, with no die and no ramp. Radar, RWR, IRST, the eye and every seeker are
# untouched, which is what `net-jam-wire.fbm` and the `site` lines here are the proof of.
#
# THE JAMMER IS ALREADY INSIDE ITS OWN RADIUS AT t = 0 and stays there. The battery therefore never
# joins the net, is never cued, never comes up and is never seen — blind, intact, and invisible. In
# `net-jam-late.fbm` the same battery joins, is cued, radiates, gives its position away on the
# attacker's RWR and is only THEN cut off: confidently blind, and it paid for the privilege.
#
# WHAT TO READ:
#   events.log      NOT ONE `net JOIN`, `net CUE`, `site RADIATE` or `site LAUNCH` line in the file
#   telemetry_sam.csv  net_state pinned at 2 (SILENT), net_cue 0, site_state pinned at 1 (DARK)
#
# READING RULE: exit 0 = SUCCESS with the viper's waypoint reached is the pass. The MEASUREMENT is the
# absence of every `net`/`site` event `net-jam-late.fbm` produces before its own `net LOST`.

net iads
  control ew
  link radio 60000 mast 8                       # [SET] 8 m masts: 23.3 km of horizon over a 21 km link
  period 4.0
  hold 3
  wcs free
  member ew
  member sam autonomy hold                      # cut off from control, this battery waits

unit viper
  module f16
  team friendly
  spawn 46.25000 6.90000 3000 0.0 450
  set gear up
  set fuel_pct 60
  set fcr_mode off
  set rwr on
  wp 46.85000 6.90000 3000 450

unit jammer
  module f16
  team friendly
  spawn 46.65000 6.90000 6000 0.0 300
  set gear up
  set fuel_pct 80
  set fcr_mode off
  set rwr off
  set jam_comm_m 25000                          # [SET] one radius, one geometry, no J/S and no ramp
  wp 46.70000 6.90000 6000 300

unit ew
  module p18
  team hostile
  spawn 46.62000 7.10000 ground 0.0 0
  set emcon free

unit sam
  module sa6
  team hostile
  spawn 46.75000 6.90000 ground 0.0 0
  set emcon hold
  set rounds 3
