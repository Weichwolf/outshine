# NEGATIVE: a `zone` is a BAND, not a plane. `altMin >= altMax` is a parse error, as is a non-positive
# radius — a cylinder a route cannot be inside would make every `avoid zone` vacuously true. Expected:
# exit 1 before the first tick, with
#   mission RESULT result=FAIL reason="parse: line N: zone 'belt' needs altMin < altMax (a band, not a plane)"
name net-zone-flat
timeout 10

zone belt 46.70000 6.90000 10000 2000 2000

unit sam
  module p18
  team hostile
  spawn 46.70000 6.90000 ground 0.0 0
