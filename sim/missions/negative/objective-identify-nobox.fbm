name objective-identify-nobox-1
timeout 300

# MUST NOT PARSE. `identify` has NO default box: the range and the dwell are [SET] per mission and must be
# visible in the file that is measured with them (doc/campaigns/w5-baltic-qra.md §Knowledge 2 marks the
# abeam box [SET] too). A zero or negative range is the same defect as a missing one — it declares a
# geometry nothing can be inside.
# Required outcome: exit 1, RESULT result=FAIL reason="parse: line 14: 'objective identify' needs
# 'range <metres>' with a positive value". See ./README.md.

unit viper
  module f16
  spawn 46.73202 6.73455 2500 48.0 300
  objective identify unit subject range 0 hold 30

unit subject
  module f16
  spawn 46.74000 6.74000 2500 48.0 300
