# NEGATIVE: a `net` member that names no unit of this mission is a PARSE ERROR, not a best-effort read —
# the same rule `objective kill unit <callsign>` already follows. A net whose member does not exist is a
# doctrine about nobody. Expected: exit 1 before the first tick, with
#   mission RESULT result=FAIL reason="parse: net 'iads': 'member ghost' names no unit in this mission"
name net-member-unknown
timeout 10

net iads
  control sam
  member sam
  member ghost

unit sam
  module p18
  team hostile
  spawn 46.70000 6.90000 ground 0.0 0
