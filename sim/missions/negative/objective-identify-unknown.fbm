name objective-identify-unknown-1
timeout 300

# MUST NOT PARSE. Every unit-scoped objective target is resolved against the WHOLE cast at end of file —
# forward references are legal, invented callsigns are not. An objective naming nobody would otherwise be
# an objective that can never be met, i.e. a mission whose verdict is decided by a typo.
# Required outcome: exit 1, RESULT result=FAIL reason="parse: unit 'viper': 'objective identify unit
# ghost range 2000 hold 30' names no unit in this mission". See ./README.md.

unit viper
  module f16
  spawn 46.73202 6.73455 2500 48.0 300
  objective identify unit ghost range 2000 hold 30
