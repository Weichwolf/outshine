name clock-bad-format-1
timeout 300

# MUST NOT PARSE. `time` takes ISO-8601 with a mandatory trailing Z and nothing else — no offset
# spelling, no omitted or fractional seconds, no space in place of the T. The value below is the most
# plausible author error of the lot: a perfectly ordinary ISO instant with the seconds left off. A
# best-effort read would let it silently mean another sky, and the sky is what several missions MEASURE.
# Required outcome: exit 1, RESULT result=FAIL reason="parse: line 11: 'time 1999-03-24T22:00Z' is not
# YYYY-MM-DDThh:mm:ssZ (Zulu only, seconds mandatory, no fractional seconds)". See ./README.md.

time 1999-03-24T22:00Z

unit viper
  module f16
  spawn 46.73202 6.73455 2500 48.0 300
  wp 46.84335 6.91523 2500 300
