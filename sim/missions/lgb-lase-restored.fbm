name lgb-lase-restored-1
timeout 160

# ...AND THE ONE PLACE A LASER SEEKER DIFFERS FROM ITS RADAR COUSIN: IT COMES BACK.
# doc/air-to-ground.md §3.2.
#
# ONE NUMBER differs from lgb-lase-broken.fbm: the crew resumes at t = 16 instead of never. The round
# coasts ballistically for six seconds and then REACQUIRES the spot, which an R-27R structurally
# cannot do — a semi-active RADAR round has no transmitter of its own to switch back on and its head
# dies once and for good, while a Paveway's head is a passive energy detector that simply sees the spot
# again. That difference is one branch in the gate and it is the whole reason this file exists.
#
# MEASURED: 9.1 m against 1 895 m broken and 3.9 m never broken. Six seconds of coast cost 5 m.
#
# WHAT TO READ:
#   events.log      TWO `missile SEEKER_ACTIVE ... mode="semi-active laser"` lines around one
#                   `missile ILLUMINATION_LOST` — the second one IS the reacquisition — and
#                   `stores DELIVERY ... aimErrM` back inside the published CEP band
#   UNIT_RESULT     bunker DESTROYED
#
# READING RULE: exit 0 is not the measurement. The MEASUREMENT is the SECOND `missile SEEKER_ACTIVE`
# line and `UNIT_RESULT unit=bunker result=DESTROYED`. The third of three.

unit viper
  module f16
  team friendly
  spawn 46.90000 6.98000 4000 90.0 250
  set gear up
  set fuel_pct 60
  set datalink off
  set fcr_mode off
  set store 3 gbu12
  set brief_master_arm arm
  set task route
  set attack_mode ccrp
  set brief_release_s 3
  set brief_lase_s 10 16                     # off at 10, back on at 16: six seconds of coast
  wp 46.90000 7.05000 4000 250
  wp 46.90000 7.30000 4000 250
  objective survive

unit bunker
  module target_soft
  team hostile
  spawn 46.90000 7.05000 ground 90.0 0
