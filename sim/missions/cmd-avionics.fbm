name cmd-avionics-1
timeout 120                                  # sim-seconds until TIMEOUT

# THE AVIONICS COMMAND/VALIDITY DEMONSTRATOR, not a flying test: this mission exists so a gym run
# exercises every branch of the command model (core/FBAvionicsCommand.h, core/FBCommandBus.h) and of the
# three-state block validity (core/FBBlockStatus.h) in ONE reproducible file. Read it with
# events.log's `cmd` lines and telemetry.csv's cmd_*/warn_* columns side by side.
#
# WHAT IT PROVES, in the order the pilot works through its brief (systems/FBPilot::EnterBriefedItems —
# one control per decision tick, always in this order):
#   1. brief_alow_ft 300   — a DED-class entry. The jet is in the BFM phase and manoeuvring, so the first
#                            attempts hit the MANOEUVRE GATE and come back rejected/sequence_precondition
#                            (an AI cannot type steerpoints in a knife fight). It retries and gets in
#                            during a lull, 4 s of typing later. But `set radalt off` below has the CARA
#                            unpowered, so the entry commits INHIBITED (effect_precondition) — documented
#                            behaviour: the DED takes the number, the warning it arms cannot fire.
#   2. brief_bingo_lbs 8000— above the documented BNGO ceiling (6,070 lb). ENTR succeeds and the field
#                            shows 8,000; the effective threshold is the ceiling. Outcome CLAMPED, which
#                            is not a rejection.
#   3. brief_master_arm arm— a HOTAS-class switch: half a second, no gate, accepted.
#   4. brief_weapon gun    — a box FlightBox does not have. Rejected/not_implemented, honestly, rather
#                            than succeeding into nothing.
# BANDIT gets a brief of its own for the fifth branch, the MANOEUVRE GATE. It flies a sustained
# 59-deg-banked level turn for the whole run — ~1.9 g, measured, permanently above kDedMaxG. Its first
# entry (ALOW) gets in during the two seconds before the turn establishes; its second (BNGO) is then
# refused with sequence_precondition on every retry for the remaining 116 s. A pilot in a hard turn does
# not do head-down work, and the model says so out loud instead of quietly letting the entry through.
# and, throughout: `set radalt off` makes the radar-altitude block INVALID for the whole run, so the
# warning system publishes FBWarnAlow as INHIBITED (warn_inhibited=1) instead of guessing, and the
# pilot's own AGL floor stops pulling because it has no height it trusts. HELD needs no declaration —
# the radar and datalink blocks are Held between every sweep/net cycle by construction.
#
# The geometry is bfm-basic's trail setup, unchanged, because a fight is the one situation that makes
# the manoeuvre gate bite. Like every BFM mission this ends at its timeout (exit 3) by design.

unit viper
  module f16
  team friendly
  spawn 46.67485 6.85148 4000 90.0 380
  set gear up
  set fuel_pct 60
  set datalink off
  set fcr_mode acm_hud
  set task bfm
  set radalt off                             # -> FBRadarAltBlock Invalid for the whole run
  set brief_alow_ft 300                      # DED class: gated by g, then inhibited by the dead CARA
  set brief_bingo_lbs 8000                   # DED class: above the documented ceiling -> clamped
  set brief_master_arm arm                   # HOTAS class: accepted
  set brief_weapon gun                       # not modelled -> rejected with a reason

unit bandit
  module f16
  team friendly
  spawn 46.67485 6.90000 4000 90.0 300
  set gear up
  set fuel_pct 60
  set datalink off
  set fcr_mode off
  set brief_alow_ft 500                      # squeezed in before the break turn establishes
  set brief_bingo_lbs 1200                   # never gets entered: the turn holds it above the g gate
  wp 46.70000 6.90000 4000 300
