name payerne-pair-1
runway 46.84335 6.91523 441.0 228.0 2889     # Payerne RWY23 -- mission-wide: the off-runway-touchdown
                                             # check both units are judged against (neither lands here)
timeout 600                                  # sim-seconds until TIMEOUT

# Two friendly F-16s, side by side on an air start ~10 nm SW of Payerne, both on 048 at 2500 m ASL /
# 300 kt. LEAD gets the northern line-abreast slot and turns NE over the Broye valley; TWO starts
# ~1.5 km southeast of it and works its own, lower and more easterly route. Each block owns its own
# waypoints -- SUCCESS is only reached when BOTH units have reached all of theirs.

unit lead
  module f16
  team friendly
  spawn 46.73800 6.72200 2500 48.0 300
  set gear up
  set fuel_pct 60
  wp 46.84335 6.91523 2900 320               # over the field, climbing
  wp 46.95000 7.05000 3200 320               # NE leg, higher still

unit two
  module f16
  team friendly
  spawn 46.72600 6.73900 2500 48.0 300       # ~1.5 km southeast of lead, same heading/speed
  set gear up
  set fuel_pct 60
  wp 46.81000 6.95000 2100 300               # a lower, more easterly track than lead's
  wp 46.90000 7.12000 2400 300               # own NE leg, well clear of lead's second waypoint
