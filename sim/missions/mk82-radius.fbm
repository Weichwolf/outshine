name mk82-radius-1
timeout 160

# THE CONTROL RUN FOR mk84-radius.fbm — the identical geometry with the bomb the tree already had.
# doc/air-to-ground.md §Knowledge 2.
#
# ONE LINE differs from mk84-radius.fbm: `set store 3 mk82`. An 87 kg warhead gives
#
#     flux(r) = 5.71e6 / r^2  [J/m^2]   ->   fail at 45 m, degrade at 69 m
#
# against the identical thresholds, so the near target at ~90 m from THIS store's own crossing takes
# 703 J/m^2 — under even the degrade threshold — and every one of the three survives untouched. The
# factor of 2.2 in radius between the two rows is the entire reason to carry one Mk 84 instead of two
# Mk 82s, and this pair is where that is a measurement rather than an assertion.
#
# WHAT TO READ:
#   events.log      NO `damage` line at all: the flux never reaches the lowest threshold this target
#                   declares, so ResolveGroundBurst refuses before it resolves anything
#   UNIT_RESULT     near INTACT, wide INTACT, far INTACT
#
# READING RULE: exit 0 is not the measurement. The MEASUREMENT is the three UNIT_RESULT lines, and the
# pass is INTACT / INTACT / INTACT. Read beside mk84-radius.fbm — alone, this file proves nothing.

unit viper
  module f16
  team friendly
  spawn 46.90000 6.80000  900 90.0 450
  set gear up
  set fuel_pct 60
  set datalink off
  set fcr_mode off
  set store 3 mk82
  set brief_master_arm arm
  set task attack
  set attack_mode ccip
  wp 46.90000 7.05000 900 450
  wp 46.95000 7.20000 3000 400
  objective survive

unit near
  module target_soft
  team hostile
  spawn 46.900359 7.051629 ground 90.0 0     # 89.9 m from the measured Mk-82 crossing
unit wide
  module target_soft
  team hostile
  spawn 46.901448 7.050340 ground 90.0 0     # 161 m, across the run-in track
unit far
  module target_soft
  team hostile
  spawn 46.900300 7.052421 ground 90.0 0     # 172 m, along it
