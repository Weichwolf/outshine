name cm-straight-clean-1
timeout 200

# THE COUNTERMEASURE EXPERIMENT, LEG 1 OF FOUR. Four missions share ONE geometry and ONE shot and
# differ in exactly two bits — does the bandit MANOEUVRE across the shot, and does it THROW CHAFF — so
# that the four closest-approach numbers are a 2x2 table and not four anecdotes:
#
#     cm-straight-clean.fbm   head-on, no chaff   the reference: what this shot does undisturbed
#     cm-chaff-straight.fbm   head-on, chaff      chaff alone
#     cm-beam-only.fbm        beaming, no chaff   the manoeuvre alone
#     cm-chaff-beam.fbm       beaming, chaff      both
#
# THE SHOT, identical in all four: the viper flies EAST from 46.900/6.900 at 8,000 m with the ACM HUD box
# open to 40 nm, locks the bandit 25 km ahead and pickles at t=10 s. One AIM-120, briefed release, no
# manoeuvring by the shooter.
#
# THE PHYSICS THE TABLE IS ABOUT (systems/FBRadarSystem::kDopplerNotchMs): a chaff cloud has no velocity
# of its own, so a pulse-Doppler seeker rejects it as clutter — UNLESS the aircraft it is tracking is
# itself crossing the line of sight, because then the target's own radial velocity is in the same
# Doppler filter as the cloud's and the processor has no way to prefer one over the other. Chaff without
# the manoeuvre is therefore rejected, the manoeuvre without chaff leaves the seeker nothing to be
# confused BY, and only the two together take the round off the target.
#
# THIS LEG is the reference: nothing is thrown and nothing is dodged, so its miss distance is what the
# other three are measured against.

unit viper
  team friendly
  module f16
  spawn 46.90000 6.90000 8000 90.0 400
  set gear up
  set fuel_pct 60
  set fcr_mode acm_hud
  set fcr_range_nm 40
  set store 3 aim120
  set brief_master_arm arm
  set brief_release_s 10                   # ~20 km, inside the launch zone, nothing else briefed
  wp 46.90000 7.15000 8000 400

unit bandit
  team hostile
  module f16
  spawn 46.90000 7.20000 8000 270.0 400
  set gear up
  set fuel_pct 60
  set fcr_mode off
  set cmds_mode off                        # the dispenser stays cold: nothing is ever thrown
  wp 46.90000 6.95000 8000 400             # 270 deg: straight down the shot
